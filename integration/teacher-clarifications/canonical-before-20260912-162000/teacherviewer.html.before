<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TeacherViewer</title>
<style>
  :root{
    --fg:#1d1d1f; --muted:#666; --bg:#fff; --line:#e3e3e3; --head:#f7f7f9; --filter:#f0f0f3;
    --correct:#2e7d32; --wrong:#c62828; --half:#f9a825; --none:#eceff1; --declared:#9fb6d4;
    --qcolW:180px; --accW:50px; --attW:50px; --nameH:132px; --sumH:26px; --learnerW:34px;
  }
  *{box-sizing:border-box;}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
    margin:0 auto; max-width:1600px; padding:0.4em 0.8em 4em; color:var(--fg); background:var(--bg); line-height:1.35;}
  .topbar{display:flex; align-items:center; gap:0.7em; flex-wrap:wrap; padding:0.3em 0;}
  .topbar h1{font-size:1.15em; margin:0; white-space:nowrap;}
  .tabs{display:flex; gap:0.3em;}
  .tab{font:inherit; padding:0.3em 0.8em; border:1px solid #c2c2c8; border-radius:6px 6px 0 0; background:#eee; cursor:pointer; border-bottom:none;}
  .tab.active{background:#fff; font-weight:600;}
  button{font:inherit; padding:0.3em 0.7em; border:1px solid #c2c2c8; border-radius:6px; background:#fff; cursor:pointer;}
  button:hover{background:#f2f2f5;}
  button.primary{background:#1d6fe0; color:#fff; border-color:#1862c6;}
  #status{margin-left:auto; color:var(--muted); font-size:0.8em; text-align:right;}
  .controls{background:var(--filter); border-radius:7px; padding:0.45em 0.7em; margin:0.4em 0; display:flex; flex-wrap:wrap; gap:0.4em 0.9em; align-items:center; font-size:0.85em;}
  .controls label{color:var(--muted);}
  .controls select,.controls input{font:inherit;}
  .controls input[type=text]{padding:0.2em 0.45em; border:1px solid #c8c8ce; border-radius:5px;}
  .sep{width:1px; align-self:stretch; background:#d0d0d6;}
  .legend{display:flex; flex-wrap:wrap; gap:0.4em 0.9em; margin:0.3em 0; font-size:0.78em; color:var(--muted); align-items:center;}
  .sw{display:inline-block; width:0.85em; height:0.85em; border-radius:3px; vertical-align:-1px; margin-right:0.25em;}
  .wrap{overflow:auto; border:1px solid var(--line); border-radius:8px; max-height:80vh;}
  table{border-collapse:separate; border-spacing:0; font-size:0.82em; width:auto;}
  th,td{border-right:1px solid var(--line); border-bottom:1px solid var(--line); text-align:center; vertical-align:middle;}
  /* ---- header rows (3 frozen) ---- */
  thead th,thead td{position:sticky; background:var(--head); z-index:4;}
  thead tr.names th{top:0; height:var(--nameH);}
  thead tr.sum-acc th,thead tr.sum-acc td{top:var(--nameH); height:var(--sumH);}
  thead tr.sum-att th,thead tr.sum-att td{top:calc(var(--nameH) + var(--sumH)); height:var(--sumH);}
  th.learner{width:var(--learnerW); min-width:var(--learnerW); height:var(--nameH); vertical-align:bottom; text-align:center; padding:5px 1px; font-size:0.84em; overflow:hidden;}
  th.learner .vname{writing-mode:vertical-rl; transform:rotate(180deg); white-space:normal; max-height:calc(var(--nameH) - 12px); line-height:1.12; text-align:center;}
  th.corner{left:0; z-index:6; width:var(--qcolW); min-width:var(--qcolW); max-width:var(--qcolW); text-align:left; padding-left:0.5em;}
  th.h-acc{right:var(--attW); z-index:6; width:var(--accW); min-width:var(--accW);}
  th.h-att{right:0; z-index:6; width:var(--attW); min-width:var(--attW);}
  td.s-lbl,th.s-lbl{left:0; z-index:5; text-align:left; padding-left:0.5em; color:#33475b; font-weight:600; font-size:0.92em;}
  thead td.s-acc-col{right:var(--attW); z-index:5;}
  thead td.s-att-col{right:0; z-index:5;}
  .rowlbl{font-weight:600; color:#33475b;}
  /* ---- body ---- */
  tbody th.qcell{position:sticky; left:0; z-index:2; background:#fff; text-align:left; padding:0.3em 0.5em; width:var(--qcolW); min-width:var(--qcolW); max-width:var(--qcolW); font-weight:400; cursor:pointer;}
  tbody th.qcell:hover{background:#f4f8ff;}
  tbody th.qcell .qid{font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.8em; color:#1b4f7d; display:block;}
  tbody th.qcell .qprompt{display:block; color:#222; white-space:normal;}
  tbody th.qcell .qtag{color:#8a8a8a; font-size:0.82em;}
  tr.group th.g-lbl{position:sticky; left:0; z-index:3; background:#e8edf2; color:#2b3f53; font-weight:700; text-align:left; padding:0.3em 0.6em; cursor:pointer;}
  tr.group td{background:#e8edf2; font-weight:600; font-size:0.82em;}
  tr.group td.g-acc{position:sticky; right:var(--attW); z-index:3;} tr.group td.g-att{position:sticky; right:0; z-index:3;}
  tr.group .chev{display:inline-block; width:1em; color:#7a8aa0;}
  td.cell{width:var(--learnerW); min-width:var(--learnerW); height:26px; padding:0; position:relative; cursor:pointer;}
  td.cell.correct{background:var(--correct);} td.cell.wrong{background:var(--wrong);} td.cell.declared{background:var(--declared);}
  td.cell.half{background:var(--half);} td.cell.none{background:var(--none);}
  td.cell.unscored{background:#f3f0e8;color:#1d1d1f;font-size:0.8em;}
  td.cell:hover{outline:2px solid #1d1d1f; outline-offset:-2px; z-index:1;}
  td.cell .cnt{position:absolute; right:1px; bottom:0; font-size:9px; line-height:1; color:rgba(255,255,255,0.95); font-weight:700;}
  td.cell.half .cnt,td.cell.none .cnt{color:rgba(0,0,0,0.6);}
  td.cell.recovered::before{content:""; position:absolute; left:0; top:0; border-width:7px; border-style:solid; border-color:#fff transparent transparent #fff;}
  td.cell.slipped::before{content:""; position:absolute; left:0; top:0; border-width:7px; border-style:solid; border-color:#1d1d1f transparent transparent #1d1d1f;}
  td.b-acc{position:sticky; right:var(--attW); z-index:2; background:#fff; font-variant-numeric:tabular-nums; width:var(--accW); min-width:var(--accW);}
  td.b-att{position:sticky; right:0; z-index:2; background:#fff; font-variant-numeric:tabular-nums; width:var(--attW); min-width:var(--attW);}
  .num{font-variant-numeric:tabular-nums; font-weight:600;}
  .sub{display:block; font-size:0.78em; font-weight:400; color:inherit; opacity:0.85;}
  /* ---- misconceptions tab ---- */
  #tab-misc{margin-top:0.6em;}
  table.misc{border-collapse:collapse; width:100%; font-size:0.9em;}
  table.misc th,table.misc td{border:1px solid var(--line); padding:0.4em 0.6em; text-align:left;}
  table.misc th{background:var(--head); cursor:pointer; position:sticky; top:0;}
  table.misc td.n{text-align:center; font-variant-numeric:tabular-nums;}
  table.misc tr.mrow{cursor:pointer;} table.misc tr.mrow:hover{background:#f4f8ff;}
  table.misc tr.detail td{background:#fafafa; font-size:0.88em;}
  .chip{display:inline-block; background:#eef2f6; border-radius:4px; padding:0.05em 0.45em; margin:0.1em 0.2em 0.1em 0;}
  /* ---- detail panel ---- */
  #detail{margin-top:0.8em; border:1px solid var(--line); border-radius:8px; padding:0.9em 1.1em; background:#fafafa; display:none;}
  #detail.show{display:block;}
  #detail h3{margin:0 0 0.2em; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.98em;}
  #detail .meta{color:var(--muted); font-size:0.84em; margin-bottom:0.5em;}
  #detail .prompt{font-size:1.02em; margin:0.3em 0 0.6em;}
  #detail ul.opts{list-style:none; padding:0; margin:0.3em 0;}
  #detail ul.opts li{padding:0.4em 0.6em; margin:0.2em 0; border-radius:6px; background:#fff; border-left:4px solid transparent;}
  #detail ul.opts li.correct{background:#e6f4ea; border-left-color:var(--correct);}
  #detail ul.opts li.wrong{background:#fdecea; border-left-color:var(--wrong);}
  #detail ul.opts li.half{background:#fff8e1; border-left-color:var(--half);}
  #detail ul.opts li.picked{box-shadow:0 0 0 2px #1d1d1f;}
  #detail .pickflag{font-size:0.76em; background:#1d1d1f; color:#fff; border-radius:3px; padding:0.05em 0.4em; margin-left:0.4em;}
  #detail .slug{font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.8em; color:#555;}
  #detail .history .h{display:inline-block; padding:0.1em 0.45em; border-radius:4px; margin:0.1em 0.25em 0.1em 0;}
  #detail .closer{float:right;}
  .empty{padding:2em; text-align:center; color:var(--muted);}
  #records{width:100%;} #records th{top:0;padding:0.5em;} #records td{padding:0.45em;}
  #records button{max-width:24em;text-align:left;overflow-wrap:anywhere;}
  .record-fields{width:100%;table-layout:fixed;} .record-fields th{width:30%;text-align:left;padding:0.4em;overflow-wrap:anywhere;}
  .record-fields td{text-align:left;padding:0.4em;white-space:pre-wrap;overflow-wrap:anywhere;}
  .record-fields details{white-space:normal;} .record-fields pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;max-height:24em;overflow:auto;}
  /* ---- ticker tab ---- */
  #ticker th.tname{position:sticky; left:0; z-index:2; background:#fff; text-align:center; padding:0.25em 0.6em; font-weight:400; white-space:nowrap;}
  #ticker td.tcell{min-width:52px; height:26px; font-variant-numeric:tabular-nums; cursor:pointer; padding:0 4px;}
  #ticker td.tcell.noact{background:var(--none); cursor:default;}
  #ticker td.ttot{position:sticky; right:0; z-index:2; background:#fff; font-variant-numeric:tabular-nums; min-width:56px; font-weight:600;}
  #ticker thead th{height:auto; padding:0.3em 0.4em; white-space:nowrap;}
  #mgrid td.mcell{text-align:center; white-space:nowrap; padding:1px 3px; font-size:0.95em; letter-spacing:0.5px;}
  .tick{color:#2e7d32; font-weight:700;} .cross{color:#c62828; font-weight:700;}
  #mgrid td.mtot{position:sticky; right:0; z-index:2; background:#fff; white-space:nowrap; font-variant-numeric:tabular-nums; min-width:64px;}
  #mgrid th.mtot-h{position:sticky; right:0; z-index:6; background:var(--head); min-width:64px;}
  #mgrid tr.mrow th.qcell{cursor:default;}
</style>
</head>
<body>
<div class="topbar">
  <h1>TeacherViewer</h1>
  <span id="build" style="font-size:0.72em;color:var(--muted);align-self:center;white-space:nowrap"></span>
  <label style="font-size:0.85em">Project: <select id="f-project"></select></label>
  <div class="tabs">
    <button class="tab active" data-tab="grid">Coverage</button>
    <button class="tab" data-tab="misc">Misconceptions</button>
    <button class="tab" data-tab="ticker">Ticker</button>
    <button class="tab" data-tab="records">Records</button>
  </div>
  <button id="btn-refresh-top" title="Refresh data">↻ Refresh</button>
  <span id="refreshed" style="font-size:0.75em;color:var(--muted);align-self:center;white-space:nowrap"></span>
  <span id="status"></span>
</div>

<!--DATASRC-->
<div class="controls" id="datasrc">
  <button id="btn-sample">Use sample data</button>
  <label>CSV file: <input type="file" id="file" accept=".csv,.tsv,.txt"></label>
  <span class="sep"></span>
  <label>Published CSV link: <input id="csvurl" type="text" size="22" placeholder="paste published CSV URL"></label>
  <button id="btn-url">Load</button>
  <button id="btn-refresh" class="primary">Refresh</button>
</div>
<!--/DATASRC-->

<div class="controls">
  <label>Group by:
    <select id="f-group"><option value="syllabus">syllabus point</option><option value="topic">topic</option></select></label>
  <label>Cohort: <select id="f-cohort"><option value="">all</option></select></label>
  <label id="class-wrap" style="display:none">Class: <select id="f-class"><option value="">all</option></select></label>
  <label>Topic: <select id="f-topic"><option value="">all</option></select></label>
  <label>Time:
    <select id="f-time">
      <option value="all">all time</option>
      <option value="2">last 2 min</option>
      <option value="10">last 10 min</option>
      <option value="60">last hour</option>
      <option value="1440">last 24 hours</option>
      <option value="10080">last week</option>
      <option value="43200">last 30 days</option>
      <option value="525600">last year</option>
      <option value="since">since a date…</option>
    </select></label>
  <label id="since-wrap" style="display:none">Since: <input id="f-since" type="datetime-local"></label>
  <label>Auto: <select id="f-auto"><option value="0">off</option><option value="15">15s</option><option value="30">30s</option><option value="60">1 min</option><option value="300">5 min</option></select></label>
  <label>Learner: <input id="f-learner" type="text" size="10" placeholder="filter names"></label>
  <label><input type="checkbox" id="f-all"> Show all questions</label>
  <label><input type="checkbox" id="f-anon"> Anonymise</label>
</div>

<div class="legend">
  <span><span class="sw" style="background:var(--correct)"></span>correct</span>
  <span><span class="sw" style="background:var(--wrong)"></span>wrong</span>
  <span><span class="sw" style="background:var(--half)"></span>half</span>
  <span><span class="sw" style="background:var(--none)"></span>not attempted</span>
  <span><span class="sw" style="background:var(--declared)"></span>declared</span>
  <span><span class="sw" style="background:#f3f0e8"></span>— unscored</span>
  <span><span class="sw" style="background:#fff;border:1px solid #ccc;position:relative"><i style="position:absolute;left:0;top:0;border-width:5px;border-style:solid;border-color:#2e7d32 transparent transparent #2e7d32"></i></span>recovered</span>
  <span><span class="sw" style="background:#fff;border:1px solid #ccc;position:relative"><i style="position:absolute;left:0;top:0;border-width:5px;border-style:solid;border-color:#1d1d1f transparent transparent #1d1d1f"></i></span>slipped</span>
  <span>Acc = fully correct / scored (green) · Att = attempted (purple)</span>
</div>

<section id="tab-grid">
  <div class="wrap"><table id="grid"></table></div>
</section>
<section id="tab-misc" hidden>
  <div id="misc"></div>
</section>
<section id="tab-ticker" hidden>
  <div class="controls">
    <label>Bucket:
      <input id="t-size" type="number" min="0" step="1" value="2" style="width:3.5em"> <select id="t-unit"><option value="1" selected>min</option><option value="60">hours</option><option value="1440">days</option><option value="10080">weeks</option></select></label>
    <label>Buckets:
      <input id="t-count" type="number" min="1" step="1" value="10" style="width:3.5em"></label>
    <label>Ending: <input id="t-end" type="datetime-local"> <span style="color:var(--muted)">(blank = now)</span></label>
    <label>Show:
      <select id="t-metric"><option value="answered">questions answered</option><option value="correct">answers correct</option><option value="pct">% correct</option></select></label>
    <span class="sep"></span>
    <span style="color:var(--muted)">newest bucket on the left · click a cell for the actual questions</span>
  </div>
  <div class="wrap"><table id="ticker"></table></div>
</section>
<section id="tab-records" hidden>
  <div class="controls"><label>Record type: <select id="r-type"><option value="">all</option></select></label><span>Click a record to see its fields and feedback.</span></div>
  <div class="wrap"><table id="records"></table></div>
</section>
<div id="detail"></div>

<script>
// Inline copy of catalogues/electric_circuits_mastery.catalogue.js (M0: first sidecar,
// carried inline for the single-file deployment; remote sidecars load by URL).
// TeacherViewer catalogue sidecar: electric_circuits_mastery
// Extracted 2026-07-20 from the seed assessment_dashboard.html (which embedded it as
// ECM_CATALOGUE / ECM_MISCONCEPTIONS, auto-generated by ECM tools/build_catalogue.js).
// Contract (d004): a sidecar registers { label, items, misconceptions } under its project id.
// Regenerate upstream in ECM and re-emit in this wrapper; do not edit the data by hand.
window.TV_CATALOGUES = window.TV_CATALOGUES || {};
window.TV_CATALOGUES["electric_circuits_mastery"] = {
label: "Electric Circuits Mastery",
items: [{"id":"bcf_001_resistance_from_V_and_I_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V battery is connected across a single resistor. An ammeter in series with the resistor reads {I} A. What is the resistance of the resistor?","syllabus_tag":"B.5.8.a","tags":["formula:R_from_VI","B.5.8.a","B.5.10.d","definition_of_resistance","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{V}/{I}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{V}*{I}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{I}/{V}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{V}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_002_power_I_squared_R_template","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A current of {I} A flows through a resistor of resistance {R} Ω. What power is dissipated by the resistor?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_I2R","B.5.12.a","power","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{I}*{I}*{R}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{I}*{R}","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"},{"id":"c","text":"{I}*{R}*{R}","status":"wrong","misconception":"swapped_factor_in_squared","misconception_label":"Squared the wrong factor"},{"id":"d","text":"{I}/{R}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"bcf_003_parallel_pair_power_V2_over_R_concrete","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"Two 6.0 Ω resistors are connected in parallel across a 12 V battery. What is the total power dissipated by the parallel combination?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_V2R","B.5.12.a","B.5.13.b","B.5.13.e","B.5.17.c","B.5.MT1.a","requires:resistor_combinations","parallel","power","concrete"],"correct_ids":["a"],"distractors":[{"id":"a","text":"48 W","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"12 W","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"24 W","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"},{"id":"d","text":"4 W","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"}]},{"id":"bcf_004_current_from_charge_time_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A charge of {Q} C flows past a point in a conductor in {t} s. What is the current?","syllabus_tag":"B.5.4.a","tags":["formula:I_from_charge","B.5.4.a","current","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{Q}/{t}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{Q}*{t}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{t}/{Q}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{Q}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_005_mains_kettle_power_P_eq_IV_concrete","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"An electric kettle is connected to the 230 V mains supply. The current through the kettle's heating element is 9.0 A. What is the power dissipated by the heating element?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_IV","B.5.12.a","B.5.MT1.d","power","mains","concrete"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2070 W","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"25.6 W","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"0.039 W","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"52900 W","status":"wrong","misconception":"treated_I_as_V","misconception_label":"Treated current as voltage"}]},{"id":"bcf_006_series_compare_power_qualitative","topic":"basic_circuit_formulas","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two resistors, of resistances 2 Ω and 6 Ω, are connected in series across a battery. Which resistor dissipates more power?","syllabus_tag":"B.5.12.c","tags":["formula:P_from_I2R","B.5.12.c","B.5.12.d","B.5.15.a","series","qualitative","comparison"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The 6 Ω resistor","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The 2 Ω resistor","status":"wrong","misconception":"wrong_power_form_for_topology","misconception_label":"Applied the wrong power form for the topology"},{"id":"c","text":"Both resistors dissipate equal power","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"d","text":"Cannot be determined without knowing the battery voltage","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"bcf_007_parallel_compare_power_qualitative","topic":"basic_circuit_formulas","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two resistors, of resistances 2 Ω and 6 Ω, are connected in parallel across a battery. Which resistor dissipates more power?","syllabus_tag":"B.5.12.c","tags":["formula:P_from_V2R","B.5.12.c","B.5.12.d","B.5.16.b","requires:resistor_combinations","parallel","qualitative","comparison"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The 2 Ω resistor","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The 6 Ω resistor","status":"wrong","misconception":"wrong_power_form_for_topology","misconception_label":"Applied the wrong power form for the topology"},{"id":"c","text":"Both resistors dissipate equal power","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"d","text":"Cannot be determined without knowing the battery voltage","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"bcf_008_charge_from_current_time_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A current of {I} A flows past a point in a circuit for {t} s. What charge has passed the point during this time?","syllabus_tag":"B.5.4.a","tags":["formula:I_from_charge","B.5.4.a","charge","numeric_template","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{I}*{t}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{I}/{t}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{t}/{I}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{I}+{t}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_009_pd_from_energy_charge_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A cell delivers {W} J of energy to {q} C of charge passing through it. What is the potential difference across the cell?","syllabus_tag":"B.5.5.a","tags":["formula:V_from_work","B.5.5.a","potential_difference","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{W}/{q}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{W}*{q}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{q}/{W}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{q}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_010_energy_from_pd_charge_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V battery moves {q} C of charge through a circuit. How much energy does the battery transfer to the charge?","syllabus_tag":"B.5.5.b","tags":["formula:V_from_work","B.5.5.b","potential_difference","energy","numeric_template","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{V}*{q}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{V}/{q}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{q}/{V}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{V}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_011_electron_across_cell_pd_concrete","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"When an electron crosses the terminals of a cell, it gains 4.8 × 10⁻¹⁹ J of energy. An electron carries a charge of 1.6 × 10⁻¹⁹ C. What is the potential difference across the cell?","syllabus_tag":"B.5.5.a","tags":["formula:V_from_work","B.5.5.a","B.5.5.c","potential_difference","electron","concrete"],"correct_ids":["a"],"distractors":[{"id":"a","text":"3.0 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"0.33 V","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"7.7 × 10⁻³⁸ V","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"1.6 × 10⁻¹⁹ V","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_012_current_from_power_voltage_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V power supply delivers a power of {P} W to a connected resistor. What current flows through the resistor?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_IV","B.5.12.a","power","current","numeric_template","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{P}/{V}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{P}*{V}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{V}/{P}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{P}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_013_cable_heating_power_concrete","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A power transmission cable has a resistance of 0.20 Ω. A current of 50 A flows through the cable. What power is dissipated as heat in the cable?","syllabus_tag":"B.5.12.e","tags":["formula:P_from_I2R","B.5.12.e","B.5.MT1.d","power","cable","concrete"],"correct_ids":["a"],"distractors":[{"id":"a","text":"500 W","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"10 W","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"},{"id":"c","text":"2.0 W","status":"wrong","misconception":"swapped_factor_in_squared","misconception_label":"Squared the wrong factor"},{"id":"d","text":"250 W","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"bcf_014_resistance_from_power_current_concrete","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A current of 4.0 A flows through a resistor. The power dissipated by the resistor is 80 W. What is the resistance of the resistor?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_I2R","B.5.12.a","power","resistance","concrete","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"5.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"20 Ω","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"},{"id":"c","text":"320 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"0.2 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"bcf_015_power_V_squared_over_R_template","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V battery is connected across a single resistor of resistance {R} Ω. What power is dissipated by the resistor?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_V2R","B.5.12.a","power","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{V}*{V}/{R}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{V}/{R}","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"},{"id":"c","text":"{V}*{V}*{R}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{R}/({V}*{V})","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"bcf_016_resistance_from_power_voltage_concrete","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V battery dissipates a power of 24 W in a connected resistor. What is the resistance of the resistor?","syllabus_tag":"B.5.12.a","tags":["formula:P_from_V2R","B.5.12.a","power","resistance","concrete","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"6.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"0.5 Ω","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"},{"id":"c","text":"2.0 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"0.17 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"bcf_017_voltage_from_current_resistance_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A current of {I} A flows through a resistor of resistance {R} Ω. What is the potential difference across the resistor?","syllabus_tag":"B.5.8.a","tags":["formula:R_from_VI","B.5.8.a","definition_of_resistance","voltage","numeric_template","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{I}*{R}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{I}/{R}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{R}/{I}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{I}+{R}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_018_current_from_voltage_resistance_template","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V battery is connected across a resistor of resistance {R} Ω. What current flows through the resistor?","syllabus_tag":"B.5.8.a","tags":["formula:R_from_VI","B.5.8.a","definition_of_resistance","current","numeric_template","rearrangement"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{V}/{R}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{V}*{R}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"{R}/{V}","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"{V}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_019_iv_graph_operating_point_concrete","topic":"basic_circuit_formulas","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A graph of current against voltage is drawn for a conductor. At a particular operating point on the graph, the voltage across the conductor is 8.0 V and the current through it is 2.0 A. What is the resistance of the conductor at this operating point?","syllabus_tag":"B.5.8.c","tags":["formula:R_from_VI","B.5.8.c","B.5.8.e","B.5.11.d","definition_of_resistance","iv_graph","concrete"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"16 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"0.25 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"4.0 V","status":"wrong","misconception":"units_off_by_factor","misconception_label":"Wrong unit prefix"}]},{"id":"bcf_020_ammeter_voltmeter_resistance_concrete","topic":"basic_circuit_formulas","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"An ammeter connected in series with a resistor reads 0.40 A. A voltmeter connected across the same resistor reads 6.0 V. What is the resistance of the resistor?","syllabus_tag":"B.5.8.a","tags":["formula:R_from_VI","B.5.8.a","B.5.8.b","B.5.MT2.b","definition_of_resistance","meters","concrete"],"correct_ids":["a"],"distractors":[{"id":"a","text":"15 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2.4 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"0.067 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"6.0 Ω","status":"wrong","misconception":"","misconception_label":""}]},{"id":"bcf_021_identify_ohmic_iv_graph_qualitative","topic":"basic_circuit_formulas","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A current-voltage graph for a conductor at constant temperature is a straight line that passes through the origin. Does this conductor obey Ohm's law?","syllabus_tag":"B.5.10.a","tags":["formula:ohmic_behaviour","B.5.10.a","B.5.10.b","B.5.10.d","B.5.Gu5.a","ohmic","qualitative","iv_graph"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Yes","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"No, because the slope of the line, not the line itself, is what determines whether Ohm's law applies","status":"wrong","misconception":"misread_iv_graph_for_ohmic","misconception_label":"Misread an IV graph for ohmic behaviour"},{"id":"c","text":"Only if the conductor is a metal","status":"wrong","misconception":"ohmic_confused_with_metal","misconception_label":"Assumed metal implies ohmic at all temperatures"},{"id":"d","text":"Cannot tell from the graph alone; we need to check that R = V/I gives a constant value","status":"wrong","misconception":"confused_definition_with_law","misconception_label":"Confused R = V/I (definition) with Ohm's law (constancy)"}]},{"id":"bcf_022_identify_non_ohmic_iv_graph_qualitative","topic":"basic_circuit_formulas","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A current-voltage graph for a filament lamp at its operating temperature is a curve that flattens as voltage increases (the slope of I against V decreases at higher V). Does the filament lamp obey Ohm's law in this operating range?","syllabus_tag":"B.5.10.d","tags":["formula:ohmic_behaviour","B.5.10.d","B.5.11.a","B.5.11.b","B.5.11.c","B.5.Gu5.c","non_ohmic","qualitative","iv_graph","filament_lamp"],"correct_ids":["a"],"distractors":[{"id":"a","text":"No","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Yes, because the graph still shows a current for every voltage","status":"wrong","misconception":"misread_iv_graph_for_ohmic","misconception_label":"Misread an IV graph for ohmic behaviour"},{"id":"c","text":"Yes, if we choose any single operating point and compute R = V/I at that point","status":"wrong","misconception":"confused_definition_with_law","misconception_label":"Confused R = V/I (definition) with Ohm's law (constancy)"},{"id":"d","text":"Yes, because the filament is a metal wire and metals are ohmic","status":"wrong","misconception":"ohmic_confused_with_metal","misconception_label":"Assumed metal implies ohmic at all temperatures"}]},{"id":"bcf_023_constant_temperature_precondition_qualitative","topic":"basic_circuit_formulas","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A copper wire is connected to a variable battery, and its current and voltage are measured for several different applied voltages. The wire is kept at a constant temperature throughout. What is the role of the 'constant temperature' condition in this measurement?","syllabus_tag":"B.5.10.c","tags":["formula:ohmic_behaviour","B.5.10.c","B.5.11.b","B.5.Gu5.a","B.5.Gu5.c","constant_temperature","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It is the precondition that makes Ohm's law applicable to the wire; if the temperature were allowed to vary, the wire's resistance would change with current and the IV graph would curve","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It does not matter; copper would be ohmic at any temperature","status":"wrong","misconception":"ohms_law_misread_temperature_role","misconception_label":"Misread the role of constant temperature in Ohm's law"},{"id":"c","text":"It only matters for non-metallic conductors; metals are ohmic regardless of temperature","status":"wrong","misconception":"ohmic_confused_with_metal","misconception_label":"Assumed metal implies ohmic at all temperatures"},{"id":"d","text":"It is needed to be able to define R = V/I at all","status":"wrong","misconception":"confused_definition_with_law","misconception_label":"Confused R = V/I (definition) with Ohm's law (constancy)"}]},{"id":"bcf_024_which_component_is_ohmic_qualitative","topic":"basic_circuit_formulas","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Which of the following components is most likely to behave as an ohmic conductor across a typical operating range, at constant temperature?","syllabus_tag":"B.5.10.b","tags":["formula:ohmic_behaviour","B.5.10.b","B.5.11.e","B.5.19.a","B.5.Gu5.b","B.5.Gu6.a","B.5.Gu6.b","B.5.Gu6.c","ohmic","qualitative","comparison"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A copper wire of fixed length and cross-section","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A filament lamp at its working temperature","status":"wrong","misconception":"ohmic_confused_with_metal","misconception_label":"Assumed metal implies ohmic at all temperatures"},{"id":"c","text":"A light-dependent resistor (LDR) with varying illumination","status":"wrong","misconception":"ohmic_confused_with_variable_resistor","misconception_label":"Confused a variable-resistor element with an ohmic one"},{"id":"d","text":"A diode in forward bias","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cc_001_incomplete_reduction_supply_current","topic":"circuit_calculations","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 36 V supply is connected to a 6 Ω resistor in series with two 6 Ω resistors that are in parallel with each other. An ammeter in the supply line measures the total current drawn from the supply. What does it read?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.b","B.5.13.e","B.5.14.b","B.5.17.a","B.5.17.b","B.5.17.d","B.5.8.a","B.5.MT1.a","requires:effective_resistance","mixed-network","supply-current","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"12 A","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"},{"id":"c","text":"6 A","status":"wrong","misconception":"i_total_before_reducing","misconception_label":"Used the total current before reducing the network"},{"id":"d","text":"2 A","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"}]},{"id":"cc_002_wrong_branch_voltage_branch_current","topic":"circuit_calculations","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 24 V supply is connected to a 9 Ω resistor in series with a parallel combination of a 4 Ω resistor and a 12 Ω resistor. What is the current through the 4 Ω resistor?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.e","B.5.14.b","B.5.17.b","B.5.16.c","B.5.8.a","B.5.MT1.a","requires:effective_resistance","mixed-network","branch-current","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.5 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6 A","status":"wrong","misconception":"wrong_branch_voltage","misconception_label":"Took the p.d. across the wrong branch or resistor"},{"id":"c","text":"1 A","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"d","text":"2 A","status":"wrong","misconception":"branch_current_equals_total","misconception_label":"Used the supply current as the branch current"}]},{"id":"cc_003_i_total_before_reducing_supply_current","topic":"circuit_calculations","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply is connected to a 4 Ω resistor in series with a parallel combination of a 6 Ω resistor and a 3 Ω resistor. An ammeter in the supply line measures the current drawn from the supply. What does it read?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.e","B.5.14.b","B.5.17.b","B.5.8.a","B.5.MT1.a","requires:effective_resistance","mixed-network","supply-current","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3 A","status":"wrong","misconception":"i_total_before_reducing","misconception_label":"Used the total current before reducing the network"},{"id":"c","text":"6 A","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"},{"id":"d","text":"4 A","status":"wrong","misconception":"i_total_before_reducing","misconception_label":"Used the total current before reducing the network"}]},{"id":"cc_004_wrong_power_form_series","topic":"circuit_calculations","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply is connected to a 2 Ω resistor in series with a 4 Ω resistor. What is the power dissipated in the 4 Ω resistor?","syllabus_tag":"B.5.13.a","tags":["B.5.13.a","B.5.13.e","B.5.14.a","B.5.12.a","B.5.12.d","B.5.8.a","B.5.MT1.a","series","power","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"16 W","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"36 W","status":"wrong","misconception":"wrong_power_form_for_topology","misconception_label":"Applied the wrong power form for the topology"},{"id":"c","text":"24 W","status":"wrong","misconception":"wrong_branch_voltage","misconception_label":"Took the p.d. across the wrong branch or resistor"},{"id":"d","text":"8 W","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"}]},{"id":"cc_005_pre_ib_two_step_pd","topic":"circuit_calculations","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 24 V supply is connected to an 8 Ω resistor in series with a 4 Ω resistor. A voltmeter is connected across the 4 Ω resistor. What does it read?","syllabus_tag":"B.5.13.a","tags":["B.5.13.a","B.5.14.a","B.5.16.c","B.5.8.a","series","voltage","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"8 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"24 V","status":"wrong","misconception":"wrong_branch_voltage","misconception_label":"Took the p.d. across the wrong branch or resistor"},{"id":"c","text":"12 V","status":"wrong","misconception":"equal_pd_in_series_assumed","misconception_label":"Assumed series components share equal p.d."},{"id":"d","text":"16 V","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cc_006_find_unknown_resistor_reverse","topic":"circuit_calculations","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply is connected to a 2 Ω resistor in series with a parallel combination of a 6 Ω resistor and a resistor of unknown resistance. An ammeter in the supply line reads 2 A. What is the unknown resistance?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.e","B.5.14.b","B.5.17.b","B.5.17.c","B.5.8.b","B.5.MT1.a","requires:effective_resistance","mixed-network","find-resistance","reverse","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"12 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"4 Ω","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"},{"id":"c","text":"6 Ω","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"},{"id":"d","text":"2 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"cr_001_voltmeter_across_one_series_bulb","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has a battery, a closed switch, two identical bulbs L1 and L2 in series, and an ammeter A1. A voltmeter is now to be added so that it measures the potential difference across bulb L1 alone. How should the voltmeter be connected?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.16.d","B.5.Gu4.b","voltmeter-placement","series","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"In parallel with bulb L1 only, so that the voltmeter's two leads touch the two terminals of L1.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"In series with L1, placed between L1 and L2 in the loop.","status":"wrong","misconception":"voltmeter_in_series","misconception_label":"Placed a voltmeter in series"},{"id":"c","text":"In parallel with both bulbs at once, across the pair L1 and L2.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"In place of the ammeter A1, after removing A1 from the loop.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"cr_002_series_current_qualitative_compare","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, two resistors of unequal resistance are connected in series with a battery and a closed switch. How does the current through the smaller resistor compare with the current through the larger resistor?","syllabus_tag":"B.5.4.c","tags":["B.5.4.c","B.5.15.a","B.5.14.a","series","current","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"They are equal: the same current flows through every component in a series loop.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The smaller resistor carries the larger current, because current prefers the easier path.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"c","text":"The larger resistor carries the larger current, because more resistance attracts more current.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The first resistor reduces the current, so the second resistor carries less current.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"}]},{"id":"cr_003_disguised_parallel_two_series_branches","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown contains four identical resistors of resistance R, connected as a network between the battery terminals via a closed switch. Which description best matches the arrangement of the four resistors?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.d","B.5.14.b","B.5.14.c","B.5.13.f","disguised-parallel","topology","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Two parallel branches; each branch contains two resistors in series.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All four resistors in a single series loop.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"All four resistors in parallel between the same two nodes.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"d","text":"Three resistors in series along one branch, with a single resistor on its own in the other branch.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"cr_004_ammeter_use_statements","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_multi","template":false,"prompt":"Which of the following statements about the use of an ideal ammeter in a DC circuit are correct? Select all that apply.","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.Gu4.a","B.5.Gu4.b","ammeter-placement","mcq-multi","qualitative","strand:meter_prediction"],"correct_ids":["a","c"],"distractors":[{"id":"a","text":"An ammeter must be placed in series with the component whose current is being measured.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"An ammeter placed in parallel with a resistor reads the current through that resistor without affecting the rest of the circuit.","status":"wrong","misconception":"ammeter_in_parallel","misconception_label":"Placed an ammeter in parallel"},{"id":"c","text":"Connecting an ammeter directly across the terminals of a battery causes a short circuit, because the ammeter has a very small resistance.","status":"correct","misconception":"","misconception_label":""},{"id":"d","text":"An ammeter's near-zero resistance does not matter when the ammeter is placed in parallel with a component.","status":"wrong","misconception":"ammeter_in_parallel","misconception_label":"Placed an ammeter in parallel"}]},{"id":"cr_005_closing_parallel_switch_shorts_r2","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, the main switch S1 is closed. Switch S2 is currently open. Resistor R1 is in series with the parallel combination of R2 and switch S2. What happens to the current through R1 when S2 is closed?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.14.d","B.5.16.f","switch","bypass","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The current through R1 increases.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current through R1 decreases.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"},{"id":"c","text":"The current through R1 stays the same.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"d","text":"The current through R1 becomes zero.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"cr_006_ammeter_two_positions_in_series_loop","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown is a single series loop containing a battery, a closed switch, two resistors R1 and R2, and a bulb L1. An ammeter could be placed at position P1 (between R1 and R2) or at position P2 (between R2 and the bulb). How do the two readings compare?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.4.c","B.5.15.a","ammeter-placement","series","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Equal: both positions give the same reading.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The reading at P1 is larger, because the current has not yet been reduced by passing through R2.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"c","text":"The reading at P2 is larger, because the current has had more components to build up through.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The two readings differ depending on whether R1 or R2 is the larger resistor.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"}]},{"id":"cr_007_voltmeter_across_battery_reads_what","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, a battery is connected to a single resistor via a closed switch. A voltmeter is connected directly across the battery's two terminals (in parallel with the battery itself). What does the voltmeter measure?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.5.d","B.5.Gu4.b","voltmeter-placement","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The potential difference across the battery's terminals (the terminal p.d.).","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current that the battery is supplying to the resistor.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"},{"id":"c","text":"The resistance of the resistor in the circuit.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"},{"id":"d","text":"Zero, because no current flows through the voltmeter itself.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_008_voltmeter_in_series_consequence","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, a voltmeter V1 has been placed in series with a resistor R1 and a bulb L1, all in a single loop with a battery and a closed switch. Which best describes the consequence?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.Gu4.b","voltmeter-placement","consequence","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The voltmeter's very high resistance reduces the loop current almost to zero, so the bulb does not light.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The voltmeter reads the supply p.d. across the battery and the bulb continues to light normally.","status":"wrong","misconception":"voltmeter_in_series","misconception_label":"Placed a voltmeter in series"},{"id":"c","text":"The voltmeter reads zero because it has almost no current passing through it.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The voltmeter functions as an ammeter in this position and gives a current reading.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"cr_009_voltmeter_across_larger_of_unequal_series_resistors","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, two unequal resistors are in series with a battery and a closed switch. Voltmeter VA is placed across the smaller resistor (3 Ω); voltmeter VB is placed across the larger resistor (6 Ω). How do the two readings compare?","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.c","B.5.16.d","voltmeter-reading","series","qualitative","strand:proportional_to_R"],"correct_ids":["a"],"distractors":[{"id":"a","text":"VB reads more than VA.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"VA and VB read the same, because the two resistors are in series.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"c","text":"VA reads more, because the smaller resistance carries the larger current.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"d","text":"The comparison depends on the specific resistor values; nothing can be said without more numbers.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_010_ammeter_at_cell_vs_in_branch","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three identical resistors in parallel between a battery and a closed switch. Ammeter A1 sits in the main line near the battery and reads the current the battery is supplying. Ammeter A2 sits in series with the first parallel branch (R1) and reads the current in that branch. How do the two readings compare?","syllabus_tag":"B.5.4.d","tags":["B.5.4.d","B.5.15.b","B.5.15.c","B.5.15.e","ammeter-placement","parallel","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A1 reads three times A2.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A1 and A2 read the same.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"c","text":"A2 reads three times A1.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"A2 reads zero, because the ammeter's near-zero resistance pulls all the current into the other two branches.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"cr_011_larger_series_R_has_larger_pd","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, two unequal resistors are connected in series with a battery and a closed switch. Without doing any calculation, which resistor has the larger potential difference across it?","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.c","series","voltage","qualitative","strand:proportional_to_R"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The larger resistor.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The smaller resistor.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"Both have the same p.d., because they are in series.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"It cannot be told without knowing the supply p.d. or the specific resistor values.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_012_third_series_R_inferred_from_small_pd","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Three resistors are in series with a battery, as shown. The p.d. across the third resistor is observed to be very small compared with the p.d. across the other two. What can be inferred qualitatively about the third resistor's resistance compared with the other two?","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.c","series","voltage","inference","qualitative","strand:proportional_to_R"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Its resistance is much smaller than either of the other two.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Its resistance is much larger than either of the other two.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"Its resistance is roughly equal to that of the other two, but the supply p.d. is unevenly divided.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"Its resistance cannot be inferred without knowing the supply p.d. or the actual current.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_013_series_voltage_divides_in_proportion_to_R","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, two resistors R1 and R2 are in series with a battery and a closed switch. R1 has twice the resistance of R2 (the diagram uses values 4 Ω and 2 Ω for illustration). How do the p.d.s across R1 and R2 compare?","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.c","series","voltage","proportional","qualitative","strand:proportional_to_R"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The p.d. across R1 is twice the p.d. across R2.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The p.d. across R2 is twice the p.d. across R1.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"The p.d.s across R1 and R2 are equal, because they are in series.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"The p.d. across R1 equals the supply p.d.; R2 has no p.d. across it.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"}]},{"id":"cr_014_parallel_branches_share_same_pd","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three components, R1, R2 and L1, connected as parallel branches across a battery, with a closed switch in the main line. What is true about the potential differences across each of the three components?","syllabus_tag":"B.5.16.b","tags":["B.5.16.b","B.5.4.d","parallel","voltage","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"All three components have the same p.d. across them, equal to the supply p.d.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Each component has a different p.d. across it, because the three components have different resistances.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"The component with the smallest resistance has the largest p.d. across it.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The bulb has a different p.d. because it is not a resistor.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_015_cell_current_equals_sum_of_branch_currents","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has a battery, a closed switch, and two parallel branches. Ammeter A1 sits in the main line and measures the current leaving the battery. Ammeters A2 and A3 sit one in each of the two branches and measure the current in that branch. Which statement is true?","syllabus_tag":"B.5.4.d","tags":["B.5.4.d","B.5.15.b","B.5.15.e","parallel","current","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A1 = A2 + A3.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A1 = A2 = A3, because the current through every ammeter in a circuit is the same.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"c","text":"A2 + A3 is larger than A1, because each branch generates its own current.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"A1 = A2 × A3.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_016_lower_R_branch_carries_more_current","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, two resistors R1 and R2 are connected as the two parallel branches of a circuit. R1 has half the resistance of R2 (the diagram uses values 3 Ω and 6 Ω for illustration). Which branch carries the larger current?","syllabus_tag":"B.5.15.d","tags":["B.5.15.d","B.5.4.d","parallel","current","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The R1 branch.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The R2 branch.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"c","text":"Both branches carry equal current, because they are in parallel and share the same p.d.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"d","text":"It depends on the supply p.d.; the comparison cannot be made without a specific value.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_017_identical_branches_share_equally","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three identical resistors connected as three parallel branches across a battery. Which statement best describes how the cell's total current divides between them?","syllabus_tag":"B.5.15.b","tags":["B.5.15.b","B.5.15.c","parallel","current","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The total current divides equally; each branch carries one third of the cell current.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All of the cell's current flows through the first branch; the other two carry none.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"The current is the same in each branch and equal to the cell current.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"d","text":"The current divides equally only when the cell p.d. is above a certain threshold.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_018_add_parallel_bulb_does_not_dim_first","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A bulb L1 is connected to a battery via a closed switch. A second identical bulb L2 is then added in parallel with L1 (sharing the same two nodes), producing the circuit shown. Assuming the battery's p.d. does not drop, what happens to the brightness of L1?","syllabus_tag":"B.5.16.b","tags":["B.5.16.b","B.5.4.d","parallel","brightness","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It stays the same.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 becomes dimmer, because the current that used to go through L1 now has to share with L2.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"c","text":"L1 becomes brighter, because the total resistance is now lower so a larger current flows.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"d","text":"L1 goes out, because L2 short-circuits it.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"}]},{"id":"cr_019_add_series_bulb_dims_first","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A bulb L1 is connected to a battery via a closed switch. A second identical bulb L2 is then added in series with L1, in the same loop, producing the circuit shown. What happens to the brightness of L1?","syllabus_tag":"B.5.4.c","tags":["B.5.4.c","B.5.16.a","series","brightness","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 becomes dimmer.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 becomes brighter, because two bulbs in series share the work and each gets more power than one bulb alone.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"L1 stays the same brightness, because each bulb still receives the supply p.d.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"L1 goes out completely.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"}]},{"id":"cr_020_bulb_with_variable_resistor_R_increases","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, a bulb L1 is in series with a variable resistor VR1, a battery and a closed switch. The variable resistor is gradually increased from a small value to a large value. What happens to the brightness of L1 during this change?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.4.c","B.5.19.a","series","brightness","variable-resistor","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 becomes dimmer as VR1's resistance increases.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 becomes brighter as VR1's resistance increases, because the total resistance is now higher.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"c","text":"L1's brightness is unchanged, because VR1 is a different component and does not affect the bulb directly.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"d","text":"L1 becomes brighter at first, then dims back down as VR1 increases further.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_021_two_unequal_bulbs_in_series","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has two bulbs with different cold resistances connected in series with a battery and a closed switch: L1 has resistance 3 Ω and L2 has resistance 6 Ω. Treating the resistances as fixed, which bulb is brighter?","syllabus_tag":"B.5.12.d","tags":["B.5.12.d","B.5.4.c","series","brightness","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L2 is brighter: in series the same current passes through both, and the bulb with the larger resistance dissipates more power.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 is brighter, because its smaller resistance lets more current through.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"c","text":"Both bulbs are equally bright, because they carry the same current.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"d","text":"L1 is brighter, because its larger resistance restricts the current less.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_022_two_unequal_bulbs_in_parallel","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has two bulbs with different cold resistances connected as parallel branches across a battery, with a closed switch in the main line: L1 has resistance 3 Ω and L2 has resistance 6 Ω. Treating the resistances as fixed, which bulb is brighter?","syllabus_tag":"B.5.12.d","tags":["B.5.12.d","B.5.4.d","B.5.16.b","parallel","brightness","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 is brighter: parallel branches share the same p.d., and the bulb with the smaller resistance dissipates more power for the same p.d.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L2 is brighter, because the larger resistance dissipates more power.","status":"wrong","misconception":"wrong_power_form_for_topology","misconception_label":"Applied the wrong power form for the topology"},{"id":"c","text":"Both bulbs are equally bright, because they have the same p.d. across them.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"d","text":"L1 is brighter only if the supply p.d. is above a particular threshold.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_023_unscrew_one_of_two_parallel_bulbs","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has two identical bulbs connected as parallel branches across a battery, with a closed switch in the main line. One of the bulbs is now unscrewed, creating a break in that branch only. What happens to the other bulb?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.16.b","parallel","brightness","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It stays at the same brightness.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It becomes dimmer, because the cell is now supplying less total current.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"c","text":"It becomes brighter, because all the current now goes through it.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"d","text":"It goes out, because the circuit is now broken.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"}]},{"id":"cr_024_unscrew_one_of_two_series_bulbs","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has two identical bulbs connected in series with a battery and a closed switch. One of the bulbs is now unscrewed, creating an open break where it sat. What happens to the other bulb?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.4.c","series","brightness","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It also goes out.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It stays at the same brightness.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"c","text":"It becomes brighter, because the total resistance of the loop is now lower.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"d","text":"It becomes dimmer but stays lit.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_025_open_switch_in_series_loop","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, the switch S is open. The loop also contains a battery and a single bulb L1. What is the state of L1?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.14.d","switch","series","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 is off: no current flows because the loop is broken at the switch.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 is dimly lit, because some current can still flow across the open switch.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"},{"id":"c","text":"L1 is at full brightness, because the open switch does not affect the bulb directly.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"},{"id":"d","text":"The bulb will be damaged because the open switch creates a voltage spike across it.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_026_open_switch_in_one_parallel_branch","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, the main switch S1 is closed; the second parallel branch contains bulb L2 and a second switch S2, which is currently open. The first parallel branch is bulb L1 alone. What is the state of the two bulbs?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.14.d","switch","parallel","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 is lit; L2 is off.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Both bulbs are off, because the open switch breaks the whole circuit.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"},{"id":"c","text":"Both bulbs are lit, because they are in parallel.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"d","text":"L1 is off; L2 is lit.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"}]},{"id":"cr_027_closing_switch_shorts_second_bulb","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, the main switch S1 is closed; bulb L1 is in series with a parallel pair consisting of bulb L2 and switch S2. With S2 currently open, L1 and L2 are effectively in series. What happens to L1 when S2 is closed?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.14.d","B.5.16.f","switch","bypass","brightness","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 becomes brighter.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 becomes dimmer.","status":"wrong","misconception":"switch_state_inverted","misconception_label":"Inverted the switch state"},{"id":"c","text":"L1 stays at the same brightness.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"d","text":"L1 goes out, because closing S2 creates a short-circuit across the battery.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"cr_028_wire_shorts_middle_series_resistor","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three resistors R1, R2 and R3 in series with a battery and a closed switch. A connecting wire of negligible resistance has been added in parallel with R2 alone, between the two ends of R2. Which resistors actually carry current in this arrangement?","syllabus_tag":"B.5.3.e","tags":["B.5.3.e","B.5.14.d","B.5.13.d","bypass","short-circuit","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R1 and R3 only; R2 is short-circuited by the wire and carries essentially no current.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All three resistors carry the same current, because they are all still drawn in the diagram.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"c","text":"Only the wire carries current; R1 and R3 are bypassed too.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"d","text":"Only R2 carries current; the wire simply provides extra resistance.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_029_wire_across_parallel_section","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has two resistors R1 and R2 connected as parallel branches between the same two nodes. A connecting wire of negligible resistance has been added between those same two nodes, as a third parallel branch alongside R1 and R2. What is the equivalent resistance of the parallel section (between the two nodes)?","syllabus_tag":"B.5.3.e","tags":["B.5.3.e","B.5.14.d","B.5.13.d","bypass","short-circuit","parallel","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Essentially zero, because the wire has zero resistance and provides a short path.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Unchanged from the original parallel value of R1 and R2.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"c","text":"Higher than before, because there is now an extra path that adds resistance.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Halved compared with before, because the wire counts as another resistor of equal value.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_030_identify_pure_series_chain","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, three components R1, L1 and VR1 are connected in a single loop with a battery and a closed switch. How are R1, L1 and VR1 arranged with respect to one another?","syllabus_tag":"B.5.14.a","tags":["B.5.14.a","B.5.13.d","topology","series","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"All three are in series: the same current flows through each.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All three are in parallel with one another.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"R1 is in series with L1, but VR1 is in parallel with R1.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"d","text":"Only L1 and VR1 are in series; R1 sits on its own.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_031_identify_pure_parallel_three_branches","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three components R1, L1 and VR1 connected as branches between the same pair of nodes, with a battery and a closed switch in the main line. How are they arranged with respect to one another?","syllabus_tag":"B.5.14.b","tags":["B.5.14.b","B.5.13.d","topology","parallel","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"All three are in parallel: each has the same p.d. across it.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All three are in series: the same current flows through each.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"R1 and L1 are in parallel; VR1 is in series with them.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"d","text":"The arrangement is a mixed series and parallel network whose details depend on the values.","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"}]},{"id":"cr_032_identify_mixed_series_parallel","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has four resistors R1, R2, R3 and R4 arranged with a battery and a closed switch. Which statement best describes how they are arranged with respect to one another?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.14.a","B.5.14.b","topology","mixed","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R1 and R4 are in series with each other and with the parallel pair R2 and R3.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All four resistors are in series with each other.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"All four resistors are in parallel with each other.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"d","text":"R1 and R2 are in series with each other; R3 and R4 are in series with each other; the two pairs are in parallel.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"cr_033_conventional_current_direction","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has a battery with its + and - terminals marked, a closed switch, a resistor R1 and a bulb L1 in a single loop. In which direction does conventional current flow through R1?","syllabus_tag":"B.5.4","tags":["B.5.4","current-direction","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"From the + terminal of the battery, through the external components, back to the - terminal.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"From the - terminal, through the external components, back to the + terminal.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"There is no defined direction in a DC circuit; the current alternates.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The direction depends on which of R1 or L1 has the larger resistance.","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"}]},{"id":"cr_034_open_terminals_current_path","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The figure shows an open fragment between two terminals X and Y. Between them sits resistor R1 in series with a parallel pair of two further resistors R2 and R3. When the fragment is connected into a larger circuit so that current flows from X to Y through it, how does the current pass through the three resistors?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.14.a","B.5.14.b","B.5.4.d","open-terminals","topology","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"All the current entering at X passes through R1; it then splits between R2 and R3 in the parallel section before recombining at Y.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current entering at X splits equally three ways from the start, with one third through each of R1, R2 and R3.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"c","text":"No current can flow because the diagram has no closed loop and no battery is drawn.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Current flows through R1 and then through exactly one of R2 or R3; the other parallel resistor is bypassed.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"}]},{"id":"cr_035_voltage_rules_statement_set","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_multi","template":false,"prompt":"Which of the following statements about potential difference (p.d.) in a DC circuit are correct? Select all that apply.","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.b","B.5.16.c","voltage-rules","mcq-multi","qualitative","strand:meter_prediction"],"correct_ids":["a","b"],"distractors":[{"id":"a","text":"In a series chain, the p.d.s across the components add up to the supply p.d.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"In a parallel section, each branch has the same p.d. across it, equal to the supply p.d. across the section.","status":"correct","misconception":"","misconception_label":""},{"id":"c","text":"In a series chain, the p.d. across each component is equal to the supply p.d.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"In a parallel section, the branch with the larger resistance has the larger p.d. across it.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_036_voltmeter_branch_does_not_split_loop_current","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, a battery, a closed switch, a resistor and an ammeter are in a single loop, and an ideal voltmeter is connected in parallel with the resistor. The ammeter reads I. Treating the voltmeter as drawing negligible current, how does the current leaving the resistor on the far side compare with the current entering it from the ammeter side, and with I?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.4.c","B.5.15.a","B.5.Gu4.b","voltmeter-placement","current","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"All three currents are equal to I.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current leaving the resistor is smaller than I by the amount that splits off through the voltmeter.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"c","text":"The current through the resistor is half of I, because the resistor and the voltmeter share the current equally as parallel branches.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"d","text":"The reading on the voltmeter changes I, because the voltmeter alters the circuit when connected.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"cr_037_unscrew_one_of_two_parallel_bulbs_inside_series_chain","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, bulb L1 is in series with a parallel pair of bulbs L2 and L3. All three bulbs are identical. Initially all three are lit. What happens to L1's brightness when L2 is unscrewed (breaking its branch only)?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.4.c","B.5.16.b","brightness","mixed","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 becomes dimmer.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 becomes brighter, because L3 now carries all the current that used to be shared with L2.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"c","text":"L1's brightness is unchanged; only L2's branch is affected and the rest of the circuit carries on as before.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"d","text":"L1 goes out because L2 unscrewing breaks the loop.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"cr_038_closing_switch_adds_parallel_branch_to_bulb","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, the main switch is closed; switch S2 is currently open. With S2 open, bulb L1 is the only branch with a complete path, so it lights normally on the supply p.d. What happens to L1's brightness when S2 is closed (assuming the battery's terminal p.d. does not drop)?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.16.b","B.5.4.d","switch","brightness","parallel","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1's brightness is unchanged.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"L1 dims because the cell now has to share its output current between the two branches.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"c","text":"L1 brightens because the total parallel resistance is now lower, so the cell delivers more current.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"d","text":"L1 goes out because the new branch creates a short across L1.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"}]},{"id":"cr_039_open_terminals_with_arbitrary_letter_labels","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The figure shows an open fragment between two terminals X and Y. Inside the fragment are three resistors labelled A, B and C: A sits in the main line between X and the bracket, and B and C are the two branches of the parallel pair inside the bracket. When the fragment is connected into a larger circuit driving current from X to Y, what is the current path through the three resistors?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.14.a","B.5.14.b","B.5.4.d","open-terminals","arbitrary-labels","topology","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The current passes through A, then splits between B and C, then recombines at Y.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current splits three ways at X, with a third through each of A, B and C.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"},{"id":"c","text":"The current passes through A and then through exactly one of B or C; the other parallel resistor is bypassed.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"d","text":"The current cannot flow through the fragment because the figure shows open terminals at both ends and there is no closed loop drawn.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"cr_040_richer_disguised_topology_five_resistors","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown contains five identical resistors between the battery terminals, with a closed switch in the main line. Which description best matches the arrangement?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.d","B.5.14.a","B.5.14.b","B.5.14.c","B.5.13.f","disguised-parallel","topology","qualitative","strand:broader"],"correct_ids":["a"],"distractors":[{"id":"a","text":"One resistor in series with a parallel pair of branches, each branch containing two resistors in series.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Five resistors in a single series loop.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"Five resistors all in parallel between the same two nodes.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"d","text":"One resistor in series, then two further series resistors, then a parallel pair of two resistors at the end.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"cr_041_equivalent_R_qualitative_range_between_terminals","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The figure shows an open fragment between two terminals X and Y. Inside the fragment, one resistor of resistance R is in series with a parallel pair of two further resistors, each also of resistance R. Without computing the exact value, in which range does the equivalent resistance between X and Y lie?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.d","B.5.14.a","B.5.14.b","open-terminals","topology","equivalent-resistance","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Between R and 2R.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Between zero and R.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"Between 2R and 3R.","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"d","text":"Exactly R, because the parallel pair adds nothing to the main-line resistor.","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"}]},{"id":"cr_042_which_parallel_branch_carries_more_current","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The figure shows an open fragment between two terminals X and Y. Inside, three resistors are connected as three parallel branches between X and Y, with cold resistances of 3 Ω, 6 Ω and 12 Ω. When a current is driven from X to Y through the fragment, which branch carries the largest share of the current?","syllabus_tag":"B.5.4.d","tags":["B.5.4.d","B.5.15.d","open-terminals","parallel","current","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The 3 Ω branch.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The 12 Ω branch.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"All three branches carry equal current because they share the same p.d. between X and Y.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"d","text":"It depends on the total current driven into X; the comparison cannot be made without that value.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_043_current_rules_statement_set","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_multi","template":false,"prompt":"Which of the following statements about current in a DC circuit are correct? Select all that apply.","syllabus_tag":"B.5.4.c","tags":["B.5.4.c","B.5.4.d","B.5.15.a","B.5.15.b","B.5.15.d","current-rules","mcq-multi","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a","b"],"distractors":[{"id":"a","text":"In a series chain, the current through each component is the same.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"In a parallel section, the cell current equals the sum of the currents in the individual branches.","status":"correct","misconception":"","misconception_label":""},{"id":"c","text":"In a series chain, the current through each component is proportional to that component's resistance.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"In a parallel section, the current divides equally between branches regardless of their resistance.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"}]},{"id":"cr_044_brightness_rules_statement_set","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_multi","template":false,"prompt":"Which of the following statements about bulb brightness in a DC circuit are correct? Select all that apply. Assume an ideal battery whose terminal p.d. does not drop and treat each bulb as a fixed-resistance component.","syllabus_tag":"B.5.4.c","tags":["B.5.4.c","B.5.4.d","B.5.16.a","B.5.16.b","brightness-rules","mcq-multi","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a","b"],"distractors":[{"id":"a","text":"Adding a resistor in series with a bulb makes the bulb dimmer, because the loop current falls.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Adding a second identical bulb in parallel with the first does not change the first bulb's brightness.","status":"correct","misconception":"","misconception_label":""},{"id":"c","text":"Two equal bulbs in series with a battery are each brighter than one bulb alone, because the two together share the work of the battery.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"d","text":"Two equal bulbs in parallel with a battery each carry half the current that one bulb alone did, so each is half as bright.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"}]},{"id":"cr_045_series_pd_sums_to_supply_three_resistors","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three resistors R1, R2 and R3 in series with a battery and a closed switch. The p.d. across R1 is found to be one third of the supply p.d.; the p.d. across R2 is one half of the supply p.d. As a fraction of the supply p.d., what is the p.d. across R3?","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.c","series","voltage","sum-to-supply","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"One sixth of the supply p.d.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Five sixths of the supply p.d.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"Two thirds of the supply p.d.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The full supply p.d., because the three components share the supply equally.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"}]},{"id":"cr_046_series_pd_sums_to_supply_two_resistors","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two resistors are in series with a battery and a closed switch, as shown. The supply p.d. is V_S. The p.d. across one of the resistors is measured to be 2V_S/3. What is the p.d. across the other?","syllabus_tag":"B.5.16.a","tags":["B.5.16.a","B.5.16.c","series","voltage","sum-to-supply","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"V_S/3.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2V_S/3, the same as the first.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"c","text":"V_S (the full supply).","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"d","text":"It cannot be told without knowing the resistor values.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"cr_047_split_and_recombine_at_junctions","topic":"circuit_rules","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has a battery, a closed switch, and a parallel pair of two branches. Ammeter A1 sits in the main line before the parallel pair, A2 and A3 sit one in each of the two branches, and A4 sits in the main line after the pair (where the branches recombine). How does A4 relate to A1?","syllabus_tag":"B.5.4.d","tags":["B.5.4.d","B.5.15.a","B.5.15.b","B.5.15.e","parallel","junctions","qualitative","strand:core_rule","drill:core_rules"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A4 equals A1, because the current that split at the first junction recombines at the second.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A4 is larger than A1, because the two branches contribute their separate currents on the way back.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"A4 is smaller than A1, because some current is lost at each junction.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"d","text":"A4 equals one of A2 or A3 because only one branch's current makes it back to the cell.","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"}]},{"id":"cr_048_ammeter_in_complex_circuit_after_parallel","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has a battery, a closed switch, and four identical resistors arranged as: one resistor in series with a parallel pair of two resistors, then an ammeter A1, then a fourth resistor (all in the main line). What does A1 read, compared to the current the cell is supplying?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.4.d","B.5.15.b","B.5.15.e","B.5.13.c","ammeter-placement","meter-prediction","complex","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A1 reads the full cell current.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A1 reads half the cell current.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"c","text":"A1 reads twice the cell current, because the branches contribute their currents on the way back.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"A1 reads zero, because A1 is not in any of the parallel branches.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"cr_049_voltmeter_across_middle_of_three_identical_series_resistors","topic":"circuit_rules","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"The circuit shown has three identical resistors in series with a battery and a closed switch. A voltmeter is connected across the middle resistor. What fraction of the supply p.d. does the voltmeter read?","syllabus_tag":"B.5.3.c","tags":["B.5.3.c","B.5.16.a","B.5.16.c","B.5.16.e","B.5.Gu4.a","voltmeter-reading","meter-prediction","series","qualitative","strand:meter_prediction"],"correct_ids":["a"],"distractors":[{"id":"a","text":"One third of the supply p.d.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The full supply p.d.","status":"wrong","misconception":"voltage_same_in_series","misconception_label":"Assumed equal voltage across series components"},{"id":"c","text":"One half of the supply p.d.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Zero, because the voltmeter draws no current.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"conduction_001_metal_carriers_are_electrons","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A copper wire carries a current. Inside the metal, which charged particles actually move along the wire to make up that current?","syllabus_tag":"B.5.6.b","tags":["B.5.6.b","B.5.6.a","conductor","charge-carriers","free-electrons","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Free electrons, which are loosely held and drift through the metal while the positive ions stay fixed in the lattice.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Protons, which carry the positive charge along the wire.","status":"wrong","misconception":"carriers_are_protons","misconception_label":"Thinks the carriers in a metal are protons"},{"id":"c","text":"Positive metal ions, which drift along the wire towards the negative terminal.","status":"wrong","misconception":"carriers_misidentified","misconception_label":"Misidentified the mobile charge carriers"},{"id":"d","text":"Both the electrons and the positive ions move, in opposite directions, sharing the current between them.","status":"wrong","misconception":"carriers_misidentified","misconception_label":"Misidentified the mobile charge carriers"}]},{"id":"conduction_002_copper_core_vs_plastic_insulation","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"An electrical cable has a copper core inside a plastic coating. When the cable is connected to a supply, current flows along the copper but not through the plastic. What is the best explanation?","syllabus_tag":"B.5.6.c","tags":["B.5.6.c","B.5.6.a","conductor","insulator","charge-carriers","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Copper has very many free electrons that can move through it, whereas the plastic has very few mobile charges, so almost no current can pass.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The plastic contains no charged particles at all, so there is nothing in it to carry a current.","status":"wrong","misconception":"insulator_has_no_atoms","misconception_label":"Confused few free electrons with no charges at all"},{"id":"c","text":"The plastic blocks the current because its atoms are packed more tightly together than copper's.","status":"wrong","misconception":"wrong_property_distinguishes_conductor","misconception_label":"Wrong property used to tell conductor from insulator"},{"id":"d","text":"Current only flows in metals because they are shiny; non-metals such as plastic cannot conduct.","status":"wrong","misconception":"wrong_property_distinguishes_conductor","misconception_label":"Wrong property used to tell conductor from insulator"}]},{"id":"conduction_003_tungsten_vs_glass_free_electrons","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Tungsten is a metal used for lamp filaments; glass is used to support and insulate them. Compared with an equal-sized piece of glass, a piece of tungsten has which of the following?","syllabus_tag":"B.5.6.d","tags":["B.5.6.d","B.5.6.a","conductor","insulator","charge-carriers","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Far more free electrons, so it conducts well, while the glass has almost none and barely conducts.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Free electrons, while the glass has no electrons at all.","status":"wrong","misconception":"insulator_has_no_atoms","misconception_label":"Confused few free electrons with no charges at all"},{"id":"c","text":"The same number of free electrons as the glass, but electrons that move faster.","status":"wrong","misconception":"wrong_property_distinguishes_conductor","misconception_label":"Wrong property used to tell conductor from insulator"},{"id":"d","text":"Fewer free electrons than the glass, which is why the glass is the one used as the insulator.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"conduction_004_origin_of_resistance_collisions","topic":"conduction","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"As electrons drift through a metal wire that carries a current, the wire has resistance and it warms up. At the microscopic level, what is happening?","syllabus_tag":"B.5.7.a","tags":["B.5.7.a","B.5.7.b","resistance","lattice","energy-transfer","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The drifting electrons keep colliding with the vibrating lattice ions, transferring energy to them, which raises the wire's internal energy and warms it.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The electrons rub against the sides of the wire, like an object sliding along a surface, and that friction makes it hot.","status":"wrong","misconception":"resistance_is_friction","misconception_label":"Over-literal friction picture of resistance"},{"id":"c","text":"Some of the electrons are used up as they pass through the wire, and the lost electrons show up as heat.","status":"wrong","misconception":"current_used_up_microscopic","misconception_label":"Charge used up along the conductor (carrier level)"},{"id":"d","text":"The lattice ions flow through the wire and collide with one another, and that is what we measure as resistance.","status":"wrong","misconception":"carriers_misidentified","misconception_label":"Misidentified the mobile charge carriers"}]},{"id":"conduction_005_resistance_rises_with_temperature_metal","topic":"conduction","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"When a metal wire is heated, its resistance increases. Which explanation accounts for this?","syllabus_tag":"B.5.7.c","tags":["B.5.7.c","resistance","temperature","lattice","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The hotter lattice ions vibrate more, so the drifting electrons collide with them more often and are impeded more, raising the resistance.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Heating frees more electrons, giving more charge carriers, so the resistance falls.","status":"wrong","misconception":"resistance_falls_with_temperature_metal","misconception_label":"Metal's resistance falls as temperature rises"},{"id":"c","text":"The electrons gain energy and move faster, so they pass through more easily and the resistance drops.","status":"wrong","misconception":"resistance_falls_with_temperature_metal","misconception_label":"Metal's resistance falls as temperature rises"},{"id":"d","text":"The wire expands when heated, and the longer wire simply has proportionally more resistance; the vibration plays no part.","status":"wrong","misconception":"resistance_rise_blamed_on_expansion","misconception_label":"Blamed the resistance rise on thermal expansion"}]},{"id":"conduction_006_excessive_current_heating_damage","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"If too large a current is driven through a thin wire, the wire can become hot enough to melt or start a fire. Why does a larger current heat the wire so much more?","syllabus_tag":"B.5.7.d","tags":["B.5.7.d","B.5.7.b","resistance","heating","power","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The moving electrons deliver energy to the lattice as they collide with it, and a larger current delivers that energy faster, so the wire heats more quickly, fast enough to melt it if the current is large enough.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A larger current means more electrons are used up inside the wire, and the destroyed electrons release the heat.","status":"wrong","misconception":"current_used_up_microscopic","misconception_label":"Charge used up along the conductor (carrier level)"},{"id":"c","text":"A larger current makes the electrons travel faster, and the faster they go the more they rub against the wire's surface.","status":"wrong","misconception":"resistance_is_friction","misconception_label":"Over-literal friction picture of resistance"},{"id":"d","text":"The heating depends only on the supply voltage, not on the current, so the size of the current makes no real difference.","status":"wrong","misconception":"heating_independent_of_current","misconception_label":"Heating blamed on voltage alone, current irrelevant"}]},{"id":"conduction_007_conductor_insulator_principle","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Which statement best describes the difference between an electrical conductor and an electrical insulator?","syllabus_tag":"B.5.6.a","tags":["B.5.6.a","conductor","insulator","charge-carriers","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A conductor has many charge carriers that are free to move; an insulator has very few.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A conductor contains charged particles; an insulator contains none.","status":"wrong","misconception":"insulator_has_no_atoms","misconception_label":"Confused few free electrons with no charges at all"},{"id":"c","text":"A conductor is always a metal and an insulator is always a non-metal.","status":"wrong","misconception":"wrong_property_distinguishes_conductor","misconception_label":"Wrong property used to tell conductor from insulator"},{"id":"d","text":"A conductor is denser and heavier than an insulator.","status":"wrong","misconception":"wrong_property_distinguishes_conductor","misconception_label":"Wrong property used to tell conductor from insulator"}]},{"id":"conduction_008_select_all_conductors","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_multi","template":false,"prompt":"Which of these materials are good electrical conductors? Select all that apply.","syllabus_tag":"B.5.6.a","tags":["B.5.6.a","conductor","insulator","recognition","qualitative"],"correct_ids":["a","b","c","f"],"distractors":[{"id":"a","text":"Copper","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Aluminium","status":"correct","misconception":"","misconception_label":""},{"id":"c","text":"Gold","status":"correct","misconception":"","misconception_label":""},{"id":"d","text":"Glass","status":"wrong","misconception":"","misconception_label":""},{"id":"e","text":"Rubber","status":"wrong","misconception":"","misconception_label":""},{"id":"f","text":"Graphite","status":"correct","misconception":"","misconception_label":""}]},{"id":"conduction_009_role_of_fixed_ions","topic":"conduction","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In a metal carrying a current, the current is a flow of free electrons. What is the role of the positive metal ions?","syllabus_tag":"B.5.6.b","tags":["B.5.6.b","B.5.7.a","conductor","lattice","charge-carriers","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"They stay fixed in the lattice and vibrate about their positions; they do not carry the current, but the drifting electrons collide with them.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"They drift slowly along the wire in the opposite direction to the electrons, carrying the positive half of the current.","status":"wrong","misconception":"carriers_misidentified","misconception_label":"Misidentified the mobile charge carriers"},{"id":"c","text":"They carry the whole current, while the electrons stay still.","status":"wrong","misconception":"carriers_misidentified","misconception_label":"Misidentified the mobile charge carriers"},{"id":"d","text":"They have no role at all; the wire would behave in exactly the same way if they were removed.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"conduction_010_where_the_energy_goes","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A current flows through a resistor and the resistor warms up. Where does the electrical energy delivered to the resistor go?","syllabus_tag":"B.5.7.b","tags":["B.5.7.b","resistance","energy-transfer","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It is transferred to the internal energy of the resistor and then to the surroundings, raising its temperature.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It is used up along with some of the electrons, which do not make it through the resistor.","status":"wrong","misconception":"current_used_up_microscopic","misconception_label":"Charge used up along the conductor (carrier level)"},{"id":"c","text":"It is destroyed; the energy simply disappears as the current passes through.","status":"wrong","misconception":"energy_destroyed_in_resistor","misconception_label":"Thinks energy is destroyed in a resistor"},{"id":"d","text":"It is carried away unchanged by the electrons and handed back to the battery.","status":"wrong","misconception":"current_used_up_microscopic","misconception_label":"Charge used up along the conductor (carrier level)"}]},{"id":"conduction_011_cold_vs_hot_wire_prediction","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two wires are made of the same metal and have the same length and thickness. One is kept cold and the other is hot. Which wire has the greater resistance?","syllabus_tag":"B.5.7.c","tags":["B.5.7.c","resistance","temperature","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The hot wire, because its lattice ions vibrate more and the electrons collide with them more often.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The cold wire, because a metal conducts better when hot, so the hot one has less resistance.","status":"wrong","misconception":"resistance_falls_with_temperature_metal","misconception_label":"Metal's resistance falls as temperature rises"},{"id":"c","text":"The cold wire, because heating frees extra electrons and that lowers the resistance.","status":"wrong","misconception":"resistance_falls_with_temperature_metal","misconception_label":"Metal's resistance falls as temperature rises"},{"id":"d","text":"The hot wire, but only because the heat has made it expand and grow slightly longer.","status":"wrong","misconception":"resistance_rise_blamed_on_expansion","misconception_label":"Blamed the resistance rise on thermal expansion"}]},{"id":"conduction_012_fuse_melts_excessive_current","topic":"conduction","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A fuse contains a short, thin piece of wire. If the current in the circuit becomes too large, the fuse wire melts and breaks the circuit. Why does an excessive current make the fuse wire melt?","syllabus_tag":"B.5.7.d","tags":["B.5.7.d","B.5.7.b","resistance","heating","power","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The large current makes the electrons deliver energy to the fuse wire's lattice very quickly, heating it past its melting point.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The excess electrons pile up in the thin wire and burn it out.","status":"wrong","misconception":"current_used_up_microscopic","misconception_label":"Charge used up along the conductor (carrier level)"},{"id":"c","text":"The fast-moving current rubs against the narrow wire, and the friction melts it.","status":"wrong","misconception":"resistance_is_friction","misconception_label":"Over-literal friction picture of resistance"},{"id":"d","text":"It melts because of the supply voltage; the size of the current makes no real difference.","status":"wrong","misconception":"heating_independent_of_current","misconception_label":"Heating blamed on voltage alone, current irrelevant"}]},{"id":"conduction_013_heating_raises_resistance_synthesis","topic":"conduction","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A metal wire carries a steady current and gradually warms up because of it. As the wire gets hotter, what happens to its resistance, and what does that tend to do to the current?","syllabus_tag":"B.5.7.c","tags":["B.5.7.c","B.5.7.a","resistance","temperature","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Its resistance rises, because of more lattice vibration and more collisions, which tends to reduce the current a little.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Its resistance falls as it heats, which tends to increase the current.","status":"wrong","misconception":"resistance_falls_with_temperature_metal","misconception_label":"Metal's resistance falls as temperature rises"},{"id":"c","text":"Its resistance is unchanged; the warming simply uses up some of the current.","status":"wrong","misconception":"current_used_up_microscopic","misconception_label":"Charge used up along the conductor (carrier level)"},{"id":"d","text":"Its resistance rises, and that increases the current, because a higher resistance pushes more charge round.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_001_series_two_equal_R","topic":"effective_resistance","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"Two resistors, each of resistance R, are connected in series. What is the equivalent resistance of the combination?","syllabus_tag":"B.5.17.a","tags":["B.5.17.a","B.5.13.b","B.5.14.a","series","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"R/2","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"},{"id":"d","text":"4R","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_002_parallel_unequal_forgot_reciprocal","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 2.0 Ω resistor and a 3.0 Ω resistor are connected in parallel. What is the equivalent resistance of the combination?","syllabus_tag":"B.5.17.b","tags":["B.5.17.b","B.5.17.c","B.5.13.a","parallel","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.2 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"0.83 Ω","status":"wrong","misconception":"forgot_final_reciprocal","misconception_label":"Forgot the final reciprocal"},{"id":"c","text":"5.0 Ω","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"2.5 Ω","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"}]},{"id":"rc_003_short_circuit_across_parallel_pair","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two resistors are connected in parallel between two nodes. A wire of negligible resistance is then connected directly between those same two nodes. What is the equivalent resistance between the two nodes now?","syllabus_tag":"B.5.14.d","tags":["B.5.14.d","B.5.13.d","B.5.13.d","parallel","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Zero","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Unchanged from the original parallel value","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"c","text":"Half of either resistor's value","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Higher than before, because there is now an extra connection","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_004_R_series_with_parallel_pair_of_R","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A resistor of resistance R is connected in series with a parallel combination of two further resistors, each of resistance R. What is the equivalent resistance of the whole network?","syllabus_tag":"B.5.13.c","tags":["B.5.13.c","B.5.13.b","B.5.17.a","B.5.17.d","mixed","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"3R/2","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/3","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"R/2","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_005_compare_series_vs_parallel_equal_R","topic":"effective_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two resistors of equal resistance R can be wired either in series or in parallel. Which arrangement gives the lower equivalent resistance?","syllabus_tag":"B.5.13.a","tags":["B.5.13.a","B.5.13.b","B.5.17.a","B.5.17.d","series","parallel","comparison","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The parallel arrangement","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The series arrangement","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"Both arrangements give the same equivalent resistance","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"d","text":"It depends on the numerical value of R","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_add_resistor_in_parallel_decreases_qualitative","topic":"effective_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A circuit contains two resistors in parallel. A third resistor is added in parallel with the existing pair. How does the equivalent resistance of the new combination compare to the original?","syllabus_tag":"B.5.13.d","tags":["parallel","qualitative_fixed","B.5.13.d","B.5.17.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It decreases","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It increases","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"It stays the same","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"It depends on the value of the added resistor","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"rc_add_resistor_in_series_increases_qualitative","topic":"effective_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A circuit contains two resistors in series. A third resistor is added in series with the existing pair. How does the equivalent resistance of the new combination compare to the original?","syllabus_tag":"B.5.13.d","tags":["series","qualitative_fixed","B.5.13.d","B.5.17.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It increases","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It decreases","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"It stays the same","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"It depends on the value of the added resistor","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"rc_bypass_across_parallel_pair_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two resistors are connected in parallel between two nodes. A wire of negligible resistance is then connected directly between those same two nodes. What is the equivalent resistance between the two nodes now?","syllabus_tag":"B.5.14.d","tags":["parallel","qualitative_fixed","B.5.14.d","B.5.13.d"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Zero","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Unchanged from the original parallel value","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"},{"id":"c","text":"Half of either resistor's value","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Higher than before, because there is now an extra connection","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_disguised_parallel_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Look at the network of resistors drawn between the two terminals shown. Are the two resistors in series, in parallel, or in some other arrangement?","syllabus_tag":"B.5.14.b","tags":["parallel","qualitative_fixed","disguised","B.5.14.b","B.5.14.c"],"correct_ids":["b"],"distractors":[{"id":"a","text":"In series","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"b","text":"In parallel","status":"correct","misconception":"","misconception_label":""},{"id":"c","text":"Neither in series nor in parallel","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Cannot be determined from the diagram","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"rc_mcq_trap_switch_open_in_parallel_branch_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the network shown, two resistors of equal resistance R are connected between terminals A and B. A switch in series with one of the resistors is open. What is the equivalent resistance between A and B?","syllabus_tag":"B.5.13.a","tags":["parallel","qualitative_fixed","switch_state","B.5.13.a","B.5.13.d","B.5.13.f","B.5.14.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"R/2","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"2R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"Zero","status":"wrong","misconception":"treated_bypass_as_active","misconception_label":"Treated a bypassed component as still active"}]},{"id":"rc_mcq_trap_two_pairs_of_R_topology_id_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the network shown, four resistors of equal resistance R are connected between terminals A and B. Which description best matches the arrangement?","syllabus_tag":"B.5.13.f","tags":["mixed","qualitative_fixed","identify_topology","B.5.13.f","B.5.14.a","B.5.14.b","B.5.14.c"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Two series pairs in parallel with each other","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"All four resistors in series","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"},{"id":"c","text":"All four resistors in parallel","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"Three resistors in series with one resistor in parallel","status":"wrong","misconception":"disguised_parallel_missed","misconception_label":"Missed a disguised parallel arrangement"}]},{"id":"rc_template_branch_current_in_parallel_pair_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V battery is connected across two parallel branches. The first branch contains a {R1} Ω resistor; the second branch contains a {R2} Ω resistor. What is the current through the {R1} Ω resistor?","syllabus_tag":"B.5.13.e","tags":["parallel","numeric_template","B.5.13.e","B.5.15.d","B.5.16.b","formula:R_from_VI"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{V} / {R1}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{V} * {R1}","status":"wrong","misconception":"confused_v_and_i","misconception_label":"Confused voltage and current"},{"id":"c","text":"{V} / ({R1} + {R2})","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"{V} / (2 * {R1})","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"}]},{"id":"rc_template_compare_n_series_vs_n_parallel_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":true,"prompt":"{n} resistors of equal resistance R can be wired either all in series or all in parallel. Which arrangement gives the lower equivalent resistance?","syllabus_tag":"B.5.13.a","tags":["mixed","qualitative_template","comparison","B.5.13.a","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The parallel arrangement","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The series arrangement","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"Both arrangements give the same equivalent resistance","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"d","text":"It depends on the numerical value of R","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"rc_template_current_divider_two_branches_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A total current of {I} A enters a parallel combination of a {R1} Ω resistor and a {R2} Ω resistor. What is the current through the {R1} Ω resistor?","syllabus_tag":"B.5.13.e","tags":["parallel","numeric_template","B.5.13.e","B.5.15.d"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{I} * {R2} / ({R1} + {R2})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{I} / 2","status":"wrong","misconception":"equal_current_in_parallel_assumed","misconception_label":"Assumed parallel branches carry equal current"},{"id":"c","text":"{I} * {R1} / ({R1} + {R2})","status":"wrong","misconception":"confused_v_and_i","misconception_label":"Confused voltage and current"},{"id":"d","text":"{I} / {R1}","status":"wrong","misconception":"confused_v_and_i","misconception_label":"Confused voltage and current"}]},{"id":"rc_template_find_R_for_parallel_total_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"An unknown resistor is connected in parallel with a {R_known} Ω resistor. The equivalent resistance of the combination is {X} Ω. What is the resistance of the unknown resistor?","syllabus_tag":"B.5.17.b","tags":["parallel","numeric_template","inverse_problem","B.5.17.b","B.5.17.c","B.5.13.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{R_known} * {X} / ({R_known} - {X})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{R_known} - {X}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"{R_known} + {X}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"{R_known} * {X}","status":"wrong","misconception":"forgot_final_reciprocal","misconception_label":"Forgot the final reciprocal"}]},{"id":"rc_template_find_R_for_series_total_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"An unknown resistor is connected in series with a {R_known} Ω resistor. The equivalent resistance of the combination is {X} Ω. What is the resistance of the unknown resistor?","syllabus_tag":"B.5.17.a","tags":["series","numeric_template","inverse_problem","B.5.17.a","B.5.13.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{X} - {R_known}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{X} + {R_known}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"{X} * {R_known} / ({X} + {R_known})","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"{X}","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"}]},{"id":"rc_template_four_R_series_parallel_one_R_n5_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Four resistors, each of resistance R, are connected in series. That series chain is then connected in parallel with a fifth resistor of resistance R. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4R/5","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"5R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/5","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"4R","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_n_equal_R_parallel_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"{n} resistors, each of resistance R, are connected in parallel. What is the equivalent resistance of the combination?","syllabus_tag":"B.5.13.b","tags":["parallel","symbolic_R_template","B.5.13.b","B.5.17.b","B.5.17.d"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R/{n}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{n}·R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/2","status":"wrong","misconception":"divided_by_two_instead_of_n","misconception_label":"Divided by 2 instead of by n"},{"id":"d","text":"R","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"}]},{"id":"rc_template_R_series_with_parallel_pair_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors of resistances {R1} Ω, {R2} Ω, and {R3} Ω are arranged so that the {R2} Ω and {R3} Ω resistors are in parallel with each other, and the {R1} Ω resistor is in series with that parallel pair. What is the equivalent resistance of the whole network?","syllabus_tag":"B.5.13.c","tags":["mixed","numeric_template","B.5.13.c","B.5.17.a","B.5.17.b","formula:R_from_VI"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{R1} + ({R2} * {R3}) / ({R2} + {R3})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{R1} + {R2} + {R3}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"1 / (1/{R1} + 1/{R2} + 1/{R3})","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"({R2} * {R3}) / ({R2} + {R3})","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_R_series_with_three_R_parallel_n4_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A resistor of resistance R is connected in series with three further resistors that are themselves connected in parallel with one another. Each of the four resistors has resistance R. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b","B.5.17.a","B.5.17.d"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4R/3","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"4R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/4","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"R/3","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_ratio_n_series_to_n_parallel_n2_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Two resistors of resistance R are connected in series; the same two resistors are then re-wired in parallel. What is the ratio of the equivalent resistance in the series arrangement to the equivalent resistance in the parallel arrangement?","syllabus_tag":"B.5.13.a","tags":["mixed","symbolic_R_template","hand_authored_per_n","ratio","B.5.13.a","B.5.17.a","B.5.17.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4 : 1","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2 : 1","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"1 : 1","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"d","text":"1 : 4","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_template_ratio_n_series_to_n_parallel_n3_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors of resistance R are connected in series; the same three resistors are then re-wired in parallel. What is the ratio of the equivalent resistance in the series arrangement to the equivalent resistance in the parallel arrangement?","syllabus_tag":"B.5.13.a","tags":["mixed","symbolic_R_template","hand_authored_per_n","ratio","B.5.13.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"9 : 1","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3 : 1","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"1 : 1","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"d","text":"6 : 1","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_template_series_pair_parallel_one_R_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors are arranged so that the {R1} Ω and {R2} Ω resistors are in series with each other, and that series chain is in parallel with the {R3} Ω resistor. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","numeric_template","B.5.13.c","B.5.17.a","B.5.17.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"({R1} + {R2}) * {R3} / ({R1} + {R2} + {R3})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{R1} + {R2} + {R3}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"1 / (1/{R1} + 1/{R2} + 1/{R3})","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"{R1} + {R2}","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_three_pairs_in_series_n3_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three pairs of resistors, each pair consisting of two resistors of resistance R in parallel, are connected in series with one another. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"3R/2","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/6","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"R/2","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_three_R_parallel_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors of resistances {R1} Ω, {R2} Ω, and {R3} Ω are connected in parallel between two terminals. What is the equivalent resistance between those terminals?","syllabus_tag":"B.5.17.b","tags":["parallel","numeric_template","B.5.17.b","B.5.13.a","B.5.13.b","formula:R_from_VI"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1 / (1/{R1} + 1/{R2} + 1/{R3})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1/{R1} + 1/{R2} + 1/{R3}","status":"wrong","misconception":"forgot_final_reciprocal","misconception_label":"Forgot the final reciprocal"},{"id":"c","text":"{R1} + {R2} + {R3}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"min({R1}, {R2}, {R3}) / 3","status":"wrong","misconception":"divided_by_two_instead_of_n","misconception_label":"Divided by 2 instead of by n"}]},{"id":"rc_template_three_R_series_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors of resistances {R1} Ω, {R2} Ω, and {R3} Ω are connected in series between two terminals. What is the equivalent resistance between those terminals?","syllabus_tag":"B.5.17.a","tags":["series","numeric_template","B.5.17.a","B.5.13.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{R1} + {R2} + {R3}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1 / (1/{R1} + 1/{R2} + 1/{R3})","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"{R1} + {R2}","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"max({R1}, {R2}, {R3})","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"}]},{"id":"rc_template_three_R_series_parallel_one_R_n4_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors, each of resistance R, are connected in series. That series chain is then connected in parallel with a fourth resistor of resistance R. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b","B.5.17.a","B.5.17.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"3R/4","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"4R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/4","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"3R","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_two_chains_three_R_parallel_n3_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Three resistors of resistance R are connected in series. Another three resistors of resistance R are also connected in series. The two series chains are then connected in parallel with each other. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"3R/2","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/6","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"3R","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_two_chains_two_R_parallel_n2_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Two resistors of resistance R are connected in series. Another two resistors of resistance R are also connected in series. The two series chains are then connected in parallel with each other. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"4R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/4","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"2R","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_two_R_parallel_bounds_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":true,"prompt":"A {R1} Ω resistor and a {R2} Ω resistor are connected in parallel. The equivalent resistance of the combination lies in which range?","syllabus_tag":"B.5.13.a","tags":["parallel","qualitative_template","bounds_flavor","option_formula","B.5.13.a","B.5.17.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Between 0 and {lo} Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Between {lo} and {hi} Ω","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"},{"id":"c","text":"Greater than {hi} Ω","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"Exactly {avg} Ω","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"}]},{"id":"rc_template_two_R_parallel_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {R1} Ω resistor and a {R2} Ω resistor are connected in parallel between two terminals. What is the equivalent resistance between those terminals?","syllabus_tag":"B.5.17.b","tags":["parallel","numeric_template","B.5.17.b","B.5.17.c","B.5.13.a","formula:R_from_VI"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1 / (1/{R1} + 1/{R2})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1/{R1} + 1/{R2}","status":"wrong","misconception":"forgot_final_reciprocal","misconception_label":"Forgot the final reciprocal"},{"id":"c","text":"{R1} + {R2}","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"({R1} + {R2}) / 2","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"}]},{"id":"rc_template_two_R_series_bounds_qualitative","topic":"effective_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":true,"prompt":"A {R1} Ω resistor and a {R2} Ω resistor are connected in series. The equivalent resistance of the combination lies in which range?","syllabus_tag":"B.5.13.a","tags":["series","qualitative_template","bounds_flavor","option_formula","B.5.13.a","B.5.17.a"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Exactly {sum} Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Between {hi} and {sum} Ω","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"},{"id":"c","text":"Less than {lo} Ω","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"Between {lo} and {hi} Ω","status":"wrong","misconception":"topology_indifferent_assumption","misconception_label":"Assumed topology does not matter"}]},{"id":"rc_template_two_R_series_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {R1} Ω resistor and a {R2} Ω resistor are connected in series between two terminals. What is the equivalent resistance between those terminals?","syllabus_tag":"B.5.17.a","tags":["series","numeric_template","B.5.17.a","B.5.13.a","formula:R_from_VI"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{R1} + {R2}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1 / (1/{R1} + 1/{R2})","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"max({R1}, {R2})","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"},{"id":"d","text":"{R1} * {R2}","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_template_two_R_series_parallel_one_R_n3_symbolic","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Two resistors, each of resistance R, are connected in series. That series chain is then connected in parallel with a third resistor of resistance R. What is the equivalent resistance of the network?","syllabus_tag":"B.5.13.c","tags":["mixed","symbolic_R_template","hand_authored_per_n","B.5.13.c","B.5.13.b","B.5.17.a","B.5.17.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2R/3","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R/3","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"d","text":"2R","status":"wrong","misconception":"incomplete_reduction","misconception_label":"Reported an intermediate reduction as the final answer"}]},{"id":"rc_template_voltage_across_middle_R_in_series_numeric","topic":"effective_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A {V} V battery is connected across three resistors in series: a {R1} Ω resistor, a {R2} Ω resistor, and a {R3} Ω resistor. What is the potential difference across the {R2} Ω resistor?","syllabus_tag":"B.5.13.e","tags":["series","numeric_template","B.5.13.e","B.5.16.c","formula:R_from_VI"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{V} * {R2} / ({R1} + {R2} + {R3})","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{V} / 3","status":"wrong","misconception":"equal_pd_in_series_assumed","misconception_label":"Assumed series components share equal p.d."},{"id":"c","text":"{V} * {R2}","status":"wrong","misconception":"confused_v_and_i","misconception_label":"Confused voltage and current"},{"id":"d","text":"{V}","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"}]},{"id":"rc_two_equal_R_parallel_n2_symbolic_fixed","topic":"effective_resistance","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Two resistors, each of resistance R, are connected in parallel. What is the equivalent resistance of the combination?","syllabus_tag":"B.5.17.b","tags":["parallel","symbolic_R_floor","B.5.17.b","B.5.17.d","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R/2","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2R","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"},{"id":"d","text":"R/4","status":"wrong","misconception":"","misconception_label":""}]},{"id":"rc_two_equal_R_series_n2_symbolic_fixed","topic":"effective_resistance","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"Two resistors, each of resistance R, are connected in series. What is the equivalent resistance of the combination?","syllabus_tag":"B.5.17.a","tags":["series","symbolic_R_floor","B.5.17.a","B.5.13.b"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"R/2","status":"wrong","misconception":"swapped_series_parallel","misconception_label":"Confused series and parallel formulae"},{"id":"c","text":"R","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"},{"id":"d","text":"4R","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_001_internal_resistance_meaning","topic":"internal_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A torch cell is described as having an internal resistance of 0.5 Ω. What does this internal resistance refer to?","syllabus_tag":"B.5.18.a.ii","tags":["B.5.18.a.ii","B.5.18.a.iii","B.5.1.a","internal-resistance","meaning","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The resistance of the materials and electrolyte inside the cell itself.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The energy lost inside the cell each second when current flows.","status":"wrong","misconception":"internal_resistance_as_energy_loss","misconception_label":"Defined internal resistance as energy loss"},{"id":"c","text":"The resistance of the wires and components connected across the cell.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The fall in the cell's emf as the cell is used up over its life.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_002_terminal_pd_less_than_emf","topic":"internal_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A cell of emf 6.0 V drives a current through a lamp. A voltmeter connected across the cell's terminals reads 5.4 V, less than the emf. Why is the terminal reading below the emf?","syllabus_tag":"B.5.18.a.iv","tags":["B.5.18.a.iv","B.5.18.a.v","B.5.5.d","B.5.MT1.c","terminal-pd","lost-volts","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Part of the emf is used in driving the current through the cell's own internal resistance, so less is left across the terminals.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The terminal p.d. should equal the emf; the 0.6 V difference is an error in the voltmeter.","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"The internal resistance adds to the emf, so the terminals carry the emf plus the internal drop.","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"The connecting wires use up the missing voltage before it reaches the meter.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"}]},{"id":"ir_003_current_with_internal_resistance","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A cell of emf 6.0 V has an internal resistance of 0.50 Ω. It is connected to an external resistor of 2.5 Ω. What is the current in the circuit?","syllabus_tag":"B.5.18.b.i","tags":["B.5.18.b.i","B.5.18.a.iv","B.5.MT1.c","internal-resistance","current","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2.0 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2.4 A","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"3.0 A","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"12 A","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_004_find_internal_resistance","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A cell of emf 12 V is connected to a load. When the current is 2.0 A, a voltmeter across the terminals reads 10 V. What is the internal resistance of the cell?","syllabus_tag":"B.5.18.b.iv","tags":["B.5.18.b.iv","B.5.18.a.v","B.5.18.b.iii","B.5.MT1.c","internal-resistance","lost-volts","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"5.0 Ω","status":"wrong","misconception":"point_resistance_for_internal","misconception_label":"Used R = V/I for the internal resistance"},{"id":"c","text":"6.0 Ω","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"d","text":"2.0 Ω","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_005_short_circuit_current","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A cell of emf 6.0 V has an internal resistance of 0.30 Ω. Its terminals are connected directly together by a thick lead of negligible resistance. What is the current?","syllabus_tag":"B.5.18.b.vii","tags":["B.5.18.b.vii","B.5.18.d.v","B.5.18.b.i","internal-resistance","short-circuit","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"20 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Extremely large, effectively unlimited","status":"wrong","misconception":"short_circuit_current_unlimited","misconception_label":"Treated short-circuit current as unlimited"},{"id":"c","text":"0.05 A","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"Zero, because there is no resistor in the circuit to carry a current","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_006_power_in_cell_vs_load","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A cell of emf 6.0 V and internal resistance 1.0 Ω drives a current through an external resistor of 2.0 Ω. How much power is dissipated inside the cell?","syllabus_tag":"B.5.18.d.i","tags":["B.5.18.d.i","B.5.18.d.ii","B.5.18.d.iii","B.5.12.g","B.5.MT1.c","internal-resistance","power","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4.0 W","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"8.0 W","status":"wrong","misconception":"emf_internal_power_confused","misconception_label":"Confused power in the cell with power in the load"},{"id":"c","text":"2.0 W","status":"wrong","misconception":"forgot_to_square_in_power","misconception_label":"Forgot to square in the power formula"},{"id":"d","text":"12 W","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_007_emf_definition","topic":"internal_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A cell is labelled with an emf of 1.5 V. What does this emf value tell you about the cell?","syllabus_tag":"B.5.18.a.i","tags":["B.5.18.a.i","B.5.1.a","B.5.5.a","emf","meaning","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The energy the cell transfers to each coulomb of charge it drives round the circuit.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The voltage across its terminals while it is driving a current through a load.","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"The total energy stored in the cell before it runs flat.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The largest current the cell can push through a circuit.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_008_terminal_pd_find","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A cell of emf 9.0 V has an internal resistance of 0.50 Ω. When it drives a current of 4.0 A, what is the p.d. across its terminals?","syllabus_tag":"B.5.18.b.iii","tags":["B.5.18.b.iii","B.5.18.a.v","B.5.MT1.c","terminal-pd","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"7.0 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"9.0 V","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"11 V","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"2.0 V","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_009_find_emf","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A resistor of 3.0 Ω is connected to a cell of internal resistance 1.0 Ω. The current in the circuit is 1.5 A. What is the emf of the cell?","syllabus_tag":"B.5.18.b.v","tags":["B.5.18.b.v","B.5.18.b.i","B.5.MT1.c","emf","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"6.0 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"4.5 V","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"3.0 V","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"1.5 V","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_010_find_load_resistance","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A cell of emf 12 V and internal resistance 1.0 Ω drives a current of 2.0 A through an external resistor. What is the resistance of that external resistor?","syllabus_tag":"B.5.18.b.vi","tags":["B.5.18.b.vi","B.5.18.b.ii","B.5.MT1.c","load-resistance","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"5.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6.0 Ω","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"7.0 Ω","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"1.0 Ω","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_011_cells_in_series","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"Three identical cells, each of emf 1.5 V and internal resistance 0.50 Ω, are connected in series to form a battery. What are the emf and the internal resistance of this battery?","syllabus_tag":"B.5.18.b.viii","tags":["B.5.18.b.viii","B.5.17.a","B.5.MT1.c","cells-series","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"emf 4.5 V; internal resistance 1.5 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"emf 4.5 V; internal resistance 0.50 Ω","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"emf 1.5 V; internal resistance 1.5 Ω","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"emf 1.5 V; internal resistance 0.17 Ω","status":"wrong","misconception":"cells_series_parallel_combination_confused","misconception_label":"Confused series/parallel cell combination"}]},{"id":"ir_012_cells_in_parallel","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"Two identical cells, each of emf 1.5 V and internal resistance 0.60 Ω, are connected in parallel. What are the emf and the internal resistance of this combination?","syllabus_tag":"B.5.18.b.viii","tags":["B.5.18.b.viii","B.5.17.b","B.5.MT1.c","cells-parallel","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"emf 1.5 V; internal resistance 0.30 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"emf 3.0 V; internal resistance 1.2 Ω","status":"wrong","misconception":"cells_series_parallel_combination_confused","misconception_label":"Confused series/parallel cell combination"},{"id":"c","text":"emf 1.5 V; internal resistance 1.2 Ω","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"emf 3.0 V; internal resistance 0.30 Ω","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_013_maximum_power_transfer","topic":"internal_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A cell has a fixed emf and a fixed internal resistance r. A variable resistor is used as the external load, and its resistance R is slowly increased from near zero to very large. The power delivered to the external resistor is greatest when:","syllabus_tag":"B.5.18.d.iv","tags":["B.5.18.d.iv","B.5.18.d.iii","B.5.MT1.c","max-power-transfer","load-matching","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R is equal to r.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"R is as large as possible.","status":"wrong","misconception":"max_power_load_not_matched","misconception_label":"Missed load-matching for maximum power"},{"id":"c","text":"R is as small as possible, close to a short circuit.","status":"wrong","misconception":"max_power_load_not_matched","misconception_label":"Missed load-matching for maximum power"},{"id":"d","text":"R is much larger than r, so the cell is barely loaded.","status":"wrong","misconception":"max_power_load_not_matched","misconception_label":"Missed load-matching for maximum power"}]},{"id":"ir_014_chemical_vs_solar_difference","topic":"internal_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Both a chemical cell and a solar cell can act as the source in a circuit. What is the basic difference between them?","syllabus_tag":"B.5.2.a","tags":["B.5.2.a","B.5.2.b","B.5.1.a","cells","solar","meaning","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A chemical cell transfers energy from chemical reactions inside it; a solar cell transfers energy from light falling on it.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A solar cell stores light during the day and releases it as current at night.","status":"wrong","misconception":"solar_cell_stores_energy","misconception_label":"Thinks a solar cell stores energy"},{"id":"c","text":"A chemical cell has internal resistance, but a solar cell has none.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"'Photovoltaic cell' and 'solar cell' are two different components.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_015_single_cell_vs_battery","topic":"internal_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In careful language, what is the difference between a single cell and a battery?","syllabus_tag":"B.5.1.d","tags":["B.5.1.d","B.5.3.a","cells","terminology","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A battery is two or more cells connected together; a single cell is just one.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"'Cell' and 'battery' mean exactly the same thing and can always be swapped.","status":"wrong","misconception":"cell_battery_confusion","misconception_label":"Confused single cell and multi-cell battery"},{"id":"c","text":"A battery gives each of its cells a larger emf than a single cell would have.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"A single cell has no internal resistance, while a battery does.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_016_solar_module_on_load","topic":"internal_resistance","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A solar module is made of several identical photovoltaic cells in series. In bright light it has an emf of 6.0 V and an internal resistance of 2.0 Ω. It is connected to a 4.0 Ω resistor. What is the current?","syllabus_tag":"B.5.2.f","tags":["B.5.2.f","B.5.2.d","B.5.18.b.i","B.5.MT1.f","solar","load-power","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.0 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1.5 A","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"3.0 A","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"0.67 A","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_017_source_suitability","topic":"internal_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A small weather sensor sits on a sunny hill-top and must run for years with no one visiting to service it. Which source is more suitable, and why?","syllabus_tag":"B.5.2.g","tags":["B.5.2.g","B.5.Gu1.a","B.5.Gu1.b","cells","source-comparison","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A solar cell, because it needs no fuel and is not used up, so it keeps working in the available sunlight without replacement.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A chemical cell, because it gives a steady output whatever the weather.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"A chemical cell, because solar cells cannot work outdoors.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Either one is equally suitable; the choice makes no real difference.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_018_energy_per_charge_accounting","topic":"internal_resistance","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A cell of emf 1.5 V drives a steady current. For every coulomb of charge that goes round the circuit, the cell supplies 1.5 J and 0.20 J is dissipated inside the cell. How much energy does each coulomb deliver to the external circuit, and what is the terminal p.d.?","syllabus_tag":"B.5.5.e","tags":["B.5.5.e","B.5.5.d","B.5.18.a.iii","B.5.18.a.v","energy-per-charge","terminal-pd","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.3 J per coulomb; terminal p.d. 1.3 V.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1.5 J per coulomb; terminal p.d. 1.5 V.","status":"wrong","misconception":"terminal_pd_equals_emf","misconception_label":"Treated terminal p.d. as equal to emf"},{"id":"c","text":"1.7 J per coulomb; terminal p.d. 1.7 V.","status":"wrong","misconception":"lost_volts_sign_wrong","misconception_label":"Added the lost volts instead of subtracting"},{"id":"d","text":"0.20 J per coulomb; terminal p.d. 0.20 V.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"ir_019_solar_intensity_dependence","topic":"internal_resistance","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A solar cell drives a small motor in bright sunlight. A cloud passes over and reduces the light reaching the cell. What happens to the current, and why?","syllabus_tag":"B.5.2.c","tags":["B.5.2.c","B.5.2.a","B.5.Gu1.b","solar","intensity","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The current falls, because a solar cell's output depends on how much light reaches it.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current stays the same, because the cell keeps delivering from light it stored earlier.","status":"wrong","misconception":"solar_cell_stores_energy","misconception_label":"Thinks a solar cell stores energy"},{"id":"c","text":"The current rises, because less light lowers the cell's internal resistance.","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"The motor runs on unchanged until the cell suddenly goes flat.","status":"wrong","misconception":"","misconception_label":""}]},{"id":"nim_001_voltmeter_loading_direction","topic":"non_ideal_meters","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A potential divider is made from two resistors in series across a battery. A real voltmeter, with a large but finite resistance, is then connected across the lower resistor. Compared with the reading an ideal voltmeter would give in the same position, the real voltmeter reads:","syllabus_tag":"B.5.Gu4.e","tags":["B.5.Gu4.e","B.5.Gu4.a","B.5.16.d","B.5.MT2.c","voltmeter-loading","direction","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A little lower.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A little higher.","status":"wrong","misconception":"loading_direction_wrong","misconception_label":"Meter loading effect in the wrong direction"},{"id":"c","text":"Exactly the same.","status":"wrong","misconception":"meter_idealisation_doubted","misconception_label":"Over-corrected an ideal meter to non-ideal"},{"id":"d","text":"It cannot be said without the value of the voltmeter's resistance.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"nim_002_voltmeter_loading_quantitative","topic":"non_ideal_meters","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V battery drives two 10 kΩ resistors in series. A voltmeter of resistance 100 kΩ is connected across the lower resistor. What does the voltmeter read?","syllabus_tag":"B.5.Gu4.e","tags":["B.5.Gu4.e","B.5.16.d","B.5.17.b","B.5.MT2.c","voltmeter-loading","potential-divider","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"5.7 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6.0 V","status":"wrong","misconception":"voltmeter_resistance_finite_missed","misconception_label":"Missed a voltmeter's finite resistance"},{"id":"c","text":"6.3 V","status":"wrong","misconception":"wrong_branch_voltage","misconception_label":"Took the p.d. across the wrong branch or resistor"},{"id":"d","text":"11 V","status":"wrong","misconception":"","misconception_label":""}]},{"id":"nim_003_ammeter_loading_direction","topic":"non_ideal_meters","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"An ammeter is connected in series with a resistor in a single-loop circuit. The ammeter has a small but non-zero resistance. Compared with the reading an ideal ammeter would give in the same place, the real ammeter reads:","syllabus_tag":"B.5.Gu4.e","tags":["B.5.Gu4.e","B.5.Gu4.b","B.5.15.a","B.5.MT2.c","ammeter-loading","direction","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A little lower.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A little higher.","status":"wrong","misconception":"loading_direction_wrong","misconception_label":"Meter loading effect in the wrong direction"},{"id":"c","text":"Exactly the same.","status":"wrong","misconception":"meter_idealisation_doubted","misconception_label":"Over-corrected an ideal meter to non-ideal"},{"id":"d","text":"It cannot be said without the value of the ammeter's resistance.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"nim_004_ammeter_loading_quantitative","topic":"non_ideal_meters","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply drives a single 4.0 Ω resistor in a loop. An ammeter of resistance 1.0 Ω is placed in series to measure the current. What does the ammeter read?","syllabus_tag":"B.5.Gu4.e","tags":["B.5.Gu4.e","B.5.Gu4.b","B.5.17.a","B.5.MT2.c","ammeter-loading","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2.4 A","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3.0 A","status":"wrong","misconception":"ammeter_resistance_zero_assumed","misconception_label":"Assumed an ammeter has zero resistance"},{"id":"c","text":"4.0 A","status":"wrong","misconception":"loading_direction_wrong","misconception_label":"Meter loading effect in the wrong direction"},{"id":"d","text":"15 A","status":"wrong","misconception":"ammeter_in_parallel","misconception_label":"Placed an ammeter in parallel"}]},{"id":"nim_005_ideal_voltmeter_no_perturbation","topic":"non_ideal_meters","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"An ideal voltmeter is connected across a resistor in a single-loop circuit that is otherwise carrying a steady current. What current passes through the voltmeter, and what happens to the current in the rest of the loop?","syllabus_tag":"B.5.Gu4.a","tags":["B.5.Gu4.a","B.5.15.a","B.5.MT2.c","ideal-voltmeter","idealisation","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"No current passes through the voltmeter, and the loop current is unchanged.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A small current passes through the voltmeter, slightly reducing the loop current.","status":"wrong","misconception":"meter_idealisation_doubted","misconception_label":"Over-corrected an ideal meter to non-ideal"},{"id":"c","text":"The whole loop current passes through the voltmeter, because it is part of the circuit.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"},{"id":"d","text":"The loop current rises, because the voltmeter provides an extra parallel path.","status":"wrong","misconception":"current_splits_when_not_branching","misconception_label":"Split the current where there is no branch"}]},{"id":"nim_006_which_configuration_most_loaded","topic":"non_ideal_meters","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A voltmeter is used to measure the p.d. across a single resistor in four separate setups. In which setup does the voltmeter's finite resistance disturb the reading most?","syllabus_tag":"B.5.Gu4.d","tags":["B.5.Gu4.d","B.5.Gu4.e","B.5.MT2.c","voltmeter-loading","order-of-magnitude","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"A 50 kΩ voltmeter across a 50 kΩ resistor.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A 10 MΩ voltmeter across a 1 kΩ resistor.","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"},{"id":"c","text":"A 1 MΩ voltmeter across a 10 kΩ resistor.","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"},{"id":"d","text":"A 10 MΩ voltmeter across a 100 kΩ resistor.","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"}]},{"id":"nim_007_ideal_meter_values_and_placement","topic":"non_ideal_meters","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Which option correctly gives the resistance of an ideal ammeter and an ideal voltmeter, together with how each is connected to the component it measures?","syllabus_tag":"B.5.Gu4.a","tags":["B.5.Gu4.a","B.5.Gu4.b","B.5.3.c","B.5.MT2.b","meters-recall","placement","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Ideal ammeter: zero resistance, connected in series. Ideal voltmeter: infinite resistance, connected in parallel.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Ideal ammeter: infinite resistance, in series. Ideal voltmeter: zero resistance, in parallel.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"},{"id":"c","text":"Ideal ammeter: zero resistance, in parallel. Ideal voltmeter: infinite resistance, in series.","status":"wrong","misconception":"voltmeter_in_series","misconception_label":"Placed a voltmeter in series"},{"id":"d","text":"Ideal ammeter: infinite resistance, in parallel. Ideal voltmeter: zero resistance, in series.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"}]},{"id":"nim_008_reliable_measurement_condition","topic":"non_ideal_meters","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A real ammeter and a real voltmeter are used to measure the current in, and the p.d. across, a resistor of resistance R. For both readings to be reliable, how should the meters' resistances compare with R?","syllabus_tag":"B.5.Gu4.d","tags":["B.5.Gu4.d","B.5.3.c","B.5.MT2.c","reliable-measurement","comparison","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The ammeter's resistance much less than R; the voltmeter's much greater than R.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The ammeter's resistance much greater than R; the voltmeter's much less than R.","status":"wrong","misconception":"meter_kinds_interchangeable","misconception_label":"Treated ammeter and voltmeter as interchangeable"},{"id":"c","text":"Both meters' resistances much less than R.","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"},{"id":"d","text":"Both meters' resistances much greater than R.","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"}]},{"id":"pd_001_unloaded_forward","topic":"potential_divider","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 20 V supply is connected across two resistors in series: a 4 Ω resistor at the top and a 6 Ω resistor at the bottom. A voltmeter is connected across the 6 Ω resistor to read the output voltage. What does it read?","syllabus_tag":"B.5.16.d","tags":["B.5.16.d","B.5.16.c","potential-divider","unloaded","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"12 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"8 V","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"c","text":"20 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"},{"id":"d","text":"10 V","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"}]},{"id":"pd_002_unloaded_find_r1","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply drives two resistors in series. The output is taken across the lower resistor, which is 2 Ω, and is measured to be 4 V. What is the resistance of the upper resistor?","syllabus_tag":"B.5.16.d","tags":["B.5.16.d","B.5.16.c","potential-divider","reverse","find-resistance","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"1 Ω","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"d","text":"2 Ω","status":"wrong","misconception":"picked_given_value","misconception_label":"Picked a given value as the answer"}]},{"id":"pd_003_loaded_divider","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply drives a 4 kΩ resistor in series with a second 4 kΩ resistor; the output is taken across the lower 4 kΩ resistor. A 4 kΩ load is then connected across the output. What is the output voltage with the load connected?","syllabus_tag":"B.5.16.g","tags":["B.5.16.g","B.5.16.d","B.5.13.e","potential-divider","loaded","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6 V","status":"wrong","misconception":"divider_loading_ignored","misconception_label":"Ignored loading on the divider"},{"id":"c","text":"8 V","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"d","text":"12 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"}]},{"id":"pd_004_ntc_sensor_direction","topic":"potential_divider","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In a potential divider, a fixed resistor is the upper component and an NTC thermistor is the lower component. The output voltage is taken across the thermistor. As the temperature rises, the output voltage:","syllabus_tag":"B.5.19.d","tags":["B.5.19.d","B.5.19.f","B.5.Gu6.b","B.5.16.c","thermistor","sensor","direction","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"falls","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"rises, because the thermistor's resistance increases with temperature","status":"wrong","misconception":"sensor_resistance_direction_wrong","misconception_label":"Sensor resistance changes the wrong way"},{"id":"c","text":"rises, because a smaller thermistor resistance takes a larger share of the voltage","status":"wrong","misconception":"sensor_v_out_direction_wrong","misconception_label":"Sensor output voltage changes the wrong way"},{"id":"d","text":"cannot be decided without the resistance values","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"pd_005_ldr_sensor_value","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"In a potential divider across a 12 V supply, an LDR is the upper component and a fixed 4 kΩ resistor is the lower component; the output is taken across the fixed resistor. At the current light level the LDR's resistance is 8 kΩ. What is the output voltage?","syllabus_tag":"B.5.19.e","tags":["B.5.19.e","B.5.19.c","B.5.19.f","B.5.Gu6.c","B.5.16.c","ldr","sensor","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"8 V","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"c","text":"6 V","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"},{"id":"d","text":"12 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"}]},{"id":"pd_006_parallel_trap_headline","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"Two resistors are connected one after the other in a single line across an 18 V supply: an 8 Ω resistor then a 4 Ω resistor. The output is taken across the 4 Ω resistor. What is the output voltage?","syllabus_tag":"B.5.16.d","tags":["B.5.16.d","B.5.16.c","B.5.13.f","potential-divider","parallel-trap","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"6 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"18 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"},{"id":"c","text":"12 V","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"d","text":"9 V","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"}]},{"id":"pd_007_potentiometer_slider","topic":"potential_divider","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A potentiometer is connected across a 12 V supply and the output is taken from its slider. The slider is moved steadily from the bottom end of the resistive track towards the top end. As it moves, the output voltage:","syllabus_tag":"B.5.19.b","tags":["B.5.19.b","B.5.Gu6.a","B.5.16.d","B.5.16.c","potentiometer","slider","direction","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"rises steadily from near 0 V towards 12 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"falls steadily from near 12 V towards 0 V","status":"wrong","misconception":"wiper_direction_wrong","misconception_label":"Got the potentiometer slider-to-output direction backwards"},{"id":"c","text":"stays at 12 V throughout, because the track is across the full supply","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"},{"id":"d","text":"stays at 6 V throughout, halfway between the rails","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"}]},{"id":"pd_008_tap_across_upper","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 20 V supply is connected across a 6 Ω resistor in series with a 4 Ω resistor, the 6 Ω at the top and the 4 Ω at the bottom. Unusually, the output is taken across the upper 6 Ω resistor. What is the output voltage?","syllabus_tag":"B.5.16.d","tags":["B.5.16.d","B.5.16.c","potential-divider","convention-deviation","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"12 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"8 V","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"c","text":"10 V","status":"wrong","misconception":"equal_share_assumption","misconception_label":"Assumed equal share of current or voltage"},{"id":"d","text":"20 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"}]},{"id":"pd_009_real_voltmeter_load","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 9 V supply drives two equal 6 kΩ resistors in series; the output is taken across the lower resistor. A voltmeter of resistance 6 kΩ is connected across the output to measure it. What voltage does it read?","syllabus_tag":"B.5.16.g","tags":["B.5.16.g","B.5.16.d","B.5.13.e","B.5.Gu4.e","potential-divider","loaded","voltmeter-loading","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"3 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"4.5 V","status":"wrong","misconception":"voltmeter_resistance_finite_missed","misconception_label":"Missed a voltmeter's finite resistance"},{"id":"c","text":"6 V","status":"wrong","misconception":"divider_ratio_inverted","misconception_label":"Inverted the divider ratio"},{"id":"d","text":"9 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"}]},{"id":"pd_010_load_across_upper","topic":"potential_divider","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 12 V supply drives a 4 kΩ resistor in series with a second 4 kΩ resistor; the output is taken across the lower resistor. A 4 kΩ load is now connected across the upper resistor, the one the output is not taken across. What is the output voltage with the load connected?","syllabus_tag":"B.5.16.g","tags":["B.5.16.g","B.5.16.d","B.5.13.e","potential-divider","loaded","numeric"],"correct_ids":["a"],"distractors":[{"id":"a","text":"8 V","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6 V","status":"wrong","misconception":"divider_loading_ignored","misconception_label":"Ignored loading on the divider"},{"id":"c","text":"4 V","status":"wrong","misconception":"load_side_confused","misconception_label":"load_side_confused"},{"id":"d","text":"12 V","status":"wrong","misconception":"divider_treated_as_parallel","misconception_label":"Treated a series divider as parallel"}]},{"id":"pd_011_load_magnitude_comparison","topic":"potential_divider","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A potential divider has a fixed 10 kΩ resistor as its upper component and a fixed 10 kΩ resistor as its lower component, with the output taken across the lower resistor. A load is then connected across the output. Which of these load resistances reduces the output voltage the most?","syllabus_tag":"B.5.16.g","tags":["B.5.16.g","B.5.16.d","potential-divider","loaded","load-comparison","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1 kΩ","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1 MΩ","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"},{"id":"c","text":"10 kΩ, equal to the lower resistor","status":"wrong","misconception":"loading_magnitude_ratio_missed","misconception_label":"Compared meter R absolutely, not as a ratio to measured R"},{"id":"d","text":"the output falls by the same amount for any load, since all are in parallel with the lower resistor","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"qp_001_three_ammeters_series_chain","topic":"qualitative_probes","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the series circuit shown, a battery drives current through a resistor and a lamp. Three ammeters are placed in the loop: A1 between the battery and the resistor, A2 between the resistor and the lamp, and A3 between the lamp and the battery. Which statement about the readings is correct?","syllabus_tag":"B.5.15.a","tags":["B.5.15.a","B.5.14.a","series","current","ammeter-reading","qualitative","deep-misconception"],"correct_ids":["a"],"distractors":[{"id":"a","text":"All three ammeters show the same reading.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"A1 shows the largest reading and A3 the smallest, because the current is gradually used up as it passes through the resistor and the lamp.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"c","text":"The readings depend on the order of the resistor and the lamp; swapping them would change what the ammeters show.","status":"wrong","misconception":"order_matters_assumed","misconception_label":"Assumed component order changes the current"},{"id":"d","text":"The comparison cannot be made without knowing the resistance values.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"qp_002_lamp_at_far_end_full_current","topic":"qualitative_probes","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"In the circuit shown, current from a battery passes through two resistors before it reaches a lamp. How does the current in the lamp compare with the current leaving the battery?","syllabus_tag":"B.5.15.a","tags":["B.5.15.a","B.5.14.a","B.5.4.c","series","current","qualitative","deep-misconception"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The current in the lamp is the same as the current leaving the battery.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It is smaller, because the two resistors take some of the current before it reaches the lamp.","status":"wrong","misconception":"charge_from_battery_dispensed","misconception_label":"Current comes from the battery and is used up"},{"id":"c","text":"It is smaller, because the lamp itself converts some of the charge into light.","status":"wrong","misconception":"current_consumed_at_components","misconception_label":"Thought current is consumed at components"},{"id":"d","text":"It would increase if the lamp were moved next to the battery.","status":"wrong","misconception":"order_matters_assumed","misconception_label":"Assumed component order changes the current"}]},{"id":"qp_003_swap_two_unequal_lamps_series","topic":"qualitative_probes","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two lamps with different resistances are connected in series with a battery: L1 has resistance 3 Ω and L2 has resistance 6 Ω. Treating the resistances as fixed, a student swaps the positions of the two lamps. What happens to the brightness of each lamp?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.15.a","B.5.12.c","series","brightness","qualitative","deep-misconception"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Neither lamp changes brightness.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The two lamps swap brightnesses, because the first lamp in the chain takes the larger share of the supply.","status":"wrong","misconception":"order_matters_assumed","misconception_label":"Assumed component order changes the current"},{"id":"c","text":"L1 becomes brighter when it is nearer the battery, because the current is stronger before it has passed through the other lamp.","status":"wrong","misconception":"charge_from_battery_dispensed","misconception_label":"Current comes from the battery and is used up"},{"id":"d","text":"What happens cannot be predicted without knowing the supply voltage.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"qp_004_add_series_resistor_no_values","topic":"qualitative_probes","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A lamp is connected to a battery and glows steadily. A resistor is then added to the circuit in series with the lamp, giving the circuit shown. No component values are given. What happens to the lamp's brightness?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.15.a","B.5.12.c","series","brightness","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"It decreases, whatever the values are.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"It stays the same, because the lamp's own resistance has not changed.","status":"wrong","misconception":"bulb_brightness_from_resistance_only","misconception_label":"Predicted brightness from resistance alone"},{"id":"c","text":"It depends on whether the resistor is placed between the battery and the lamp or on the far side of the lamp.","status":"wrong","misconception":"order_matters_assumed","misconception_label":"Assumed component order changes the current"},{"id":"d","text":"It cannot be predicted without the resistance and voltage values.","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"qp_005_switch_opens_parallel_lamp_pair","topic":"qualitative_probes","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Three identical lamps are connected to a battery: L1 in the main loop, and L2 and L3 on two parallel branches. A switch in series with L3 is initially closed, and all three lamps light. The switch is then opened. What happens to the brightness of L1 and of L2?","syllabus_tag":"B.5.13.d","tags":["B.5.13.d","B.5.15.b","B.5.16.b","B.5.12.c","parallel","brightness","switch","qualitative","ppq-shape"],"correct_ids":["a"],"distractors":[{"id":"a","text":"L1 becomes dimmer and L2 becomes brighter.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Both lamps become dimmer.","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"L2 becomes brighter and L1 is unchanged, because L1 comes before the junction.","status":"wrong","misconception":"order_matters_assumed","misconception_label":"Assumed component order changes the current"},{"id":"d","text":"Both lamps become brighter, because the battery's output is now shared between two lamps instead of three.","status":"wrong","misconception":"charge_from_battery_dispensed","misconception_label":"Current comes from the battery and is used up"}]},{"id":"qp_006_ldr_darkens_statement_set","topic":"qualitative_probes","level":"ib","mode":"qual","qtype":"mcq_multi","template":false,"prompt":"A fixed resistor and an LDR are connected in series with a battery. The light falling on the LDR then becomes much dimmer. Select every statement that applies after the change.","syllabus_tag":"B.5.19.e","tags":["B.5.19.e","B.5.19.f","B.5.16.a","B.5.16.c","B.5.15.a","B.5.Gu6.c","ldr","sensor","statement-set","qualitative"],"correct_ids":["a","b","c"],"distractors":[{"id":"a","text":"The resistance of the LDR has increased.","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The current in the circuit has decreased.","status":"correct","misconception":"","misconception_label":""},{"id":"c","text":"The p.d. across the LDR has increased.","status":"correct","misconception":"","misconception_label":""},{"id":"d","text":"The p.d. across the fixed resistor has stayed the same, because its resistance has not changed.","status":"wrong","misconception":"own_resistance_fixes_own_share","misconception_label":"A component's share depends only on its own resistance"},{"id":"e","text":"The resistance of the LDR has decreased.","status":"wrong","misconception":"sensor_resistance_direction_wrong","misconception_label":"Sensor resistance changes the wrong way"},{"id":"f","text":"The emf of the battery has decreased.","status":"wrong","misconception":"charge_from_battery_dispensed","misconception_label":"Current comes from the battery and is used up"}]},{"id":"res_001_resistance_area_given_directly","topic":"resistivity","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A bar of a conducting material has a resistivity of 5.0 x 10⁻⁷ Ω metre. The bar is 0.60 m long and has a uniform cross-sectional area of 1.5 x 10⁻⁶ m². What is the resistance between its two ends, measured along its length?","syllabus_tag":"B.5.9.b","tags":["B.5.9.b","area_given_directly","slab","single_substitution"],"correct_ids":["a"],"distractors":[{"id":"a","text":"0.20 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3.0 x 10⁻⁷ Ω","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"c","text":"0.56 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"1.3 x 10⁻¹² Ω","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_002_resistance_circular_wire_template","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A cylindrical wire made of a material of resistivity {rho} Ω metre has a length of {L} m and a circular cross-section of radius {r} mm. What is the resistance of the wire?","syllabus_tag":"B.5.9.b","tags":["B.5.9.b","B.5.9.d","circular_wire","area_from_shape","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{rho}*{L}/(pi*(({r}/1000)*({r}/1000)))","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{rho}*{L}/(pi*({r}/1000))","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"c","text":"{rho}*{L}","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"d","text":"{rho}*(pi*(({r}/1000)*({r}/1000)))/{L}","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_003_material_recognition_from_resistivity","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A uniform wire is 2.0 m long and has a cross-sectional area of 1.0 x 10⁻⁶ m². Its resistance is measured as 0.034 Ω. The resistivities of four metals are: copper 1.7 x 10⁻⁸ Ω metre; aluminium 2.8 x 10⁻⁸ Ω metre; constantan 4.9 x 10⁻⁷ Ω metre; nichrome 1.1 x 10⁻⁶ Ω metre. What is the resistivity of the wire's material, and hence which metal is it?","syllabus_tag":"B.5.9.a","tags":["B.5.9.a","material_recognition","reverse_calculation"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.7 x 10⁻⁸ Ω metre, so copper","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3.4 x 10⁻⁸ Ω metre, so aluminium","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"3.4 x 10⁻² Ω metre, so none of these","status":"wrong","misconception":"confused_resistance_resistivity","misconception_label":"Confused resistance R with resistivity ρ"},{"id":"d","text":"6.8 x 10⁴ Ω metre, so none of these","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_004_radius_doubled_scaling","topic":"resistivity","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A wire has resistance R. A second wire is made of the same material and has the same length as the first, but its radius is twice as large. What is the resistance of the second wire?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","B.5.9.d","scaling","proportional_reasoning"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R / 4","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"R / 2","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"c","text":"4R","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"R (unchanged)","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"}]},{"id":"res_005_wire_drawn_constant_volume","topic":"resistivity","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A copper wire of resistance R is drawn out so that its length doubles. No copper is added or removed during drawing, so the volume of the wire stays the same. What is the resistance of the drawn wire?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","volume_preservation","drawn_wire","proportional_reasoning"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2R","status":"wrong","misconception":"volume_preservation_missed","misconception_label":"Missed volume preservation when a wire is stretched"},{"id":"c","text":"8R","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"d","text":"R (unchanged)","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"}]},{"id":"res_006_rectangular_slab_area_from_sides","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"The rectangular bar shown has its two ends at the terminals X and Y. The bar is made of a material of resistivity 2.4 x 10⁻⁶ Ω metre, has a length L of 0.50 m, and a rectangular cross-section measuring 4.0 mm by 5.0 mm. What is the resistance between X and Y?","syllabus_tag":"B.5.9.b","tags":["B.5.9.b","rectangular_slab","area_from_shape"],"correct_ids":["a"],"distractors":[{"id":"a","text":"0.060 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6.0 x 10⁻⁸ Ω","status":"wrong","misconception":"unit_prefix_not_converted","misconception_label":"Did not convert a unit prefix to SI"},{"id":"c","text":"1.2 x 10⁻⁶ Ω","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"d","text":"9.6 x 10⁻¹¹ Ω","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_007_resistance_area_given_template","topic":"resistivity","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":true,"prompt":"A uniform conductor of resistivity {rho} Ω metre has a length of {L} m and a uniform cross-sectional area of {A} m². What is its resistance from end to end?","syllabus_tag":"B.5.9.b","tags":["B.5.9.b","area_given_directly","numeric_template"],"correct_ids":["a"],"distractors":[{"id":"a","text":"{rho}*{L}/{A}","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"{rho}*{L}","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"c","text":"{rho}*{A}/{L}","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"},{"id":"d","text":"{rho}/({L}*{A})","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"res_008_resistivity_from_R_L_A","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A wire between terminals X and Y has a length L of 4.0 m and a uniform cross-sectional area of 2.0 x 10⁻⁷ m². The resistance measured between X and Y is 0.50 Ω. What is the resistivity of the material?","syllabus_tag":"B.5.9.a","tags":["B.5.9.a","resistivity_from_measurements"],"correct_ids":["a"],"distractors":[{"id":"a","text":"2.5 x 10⁻⁸ Ω metre","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"0.50 Ω metre","status":"wrong","misconception":"confused_resistance_resistivity","misconception_label":"Confused resistance R with resistivity ρ"},{"id":"c","text":"1.0 x 10⁻⁷ Ω metre","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"1.0 x 10⁷ Ω metre","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_009_resistivity_circular_wire","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A wire of length 2.0 m and circular cross-section of radius 0.50 mm is measured to have a resistance of 2.80 Ω. What is the resistivity of the material?","syllabus_tag":"B.5.9.a","tags":["B.5.9.a","B.5.9.d","circular_wire","material_recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.1 x 10⁻⁶ Ω metre","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2.2 x 10⁻³ Ω metre","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"c","text":"2.8 Ω metre","status":"wrong","misconception":"confused_resistance_resistivity","misconception_label":"Confused resistance R with resistivity ρ"},{"id":"d","text":"2.2 x 10⁻⁶ Ω metre","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"res_010_rearrange_for_length","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"The wire shown has its unknown length marked L, with its ends at terminals X and Y. It is made of a material of resistivity 1.1 x 10⁻⁶ Ω metre and has a uniform cross-sectional area of 2.0 x 10⁻⁷ m². The resistance between X and Y is 5.5 Ω. What is the length L?","syllabus_tag":"B.5.9.c","tags":["B.5.9.c","rearrange_for_length"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.0 m","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"30 m","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"5.0 x 10⁶ m","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"d","text":"4.0 x 10⁻¹⁴ m","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"res_011_rearrange_for_area","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A wire of resistivity 1.7 x 10⁻⁸ Ω metre is 20 m long and must have a total resistance of 2.0 Ω. What uniform cross-sectional area must it have?","syllabus_tag":"B.5.9.c","tags":["B.5.9.c","rearrange_for_area"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.7 x 10⁻⁷ m²","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3.4 x 10⁻⁷ m²","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"1.7 x 10⁻⁹ m²","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"2.4 x 10⁹ m²","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_012_rearrange_for_radius","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A 50 m length of wire of resistivity 5.0 x 10⁻⁷ Ω metre is required to have a resistance of 4.0 Ω. The wire has a circular cross-section. What radius must it have?","syllabus_tag":"B.5.9.c","tags":["B.5.9.c","B.5.9.d","rearrange_for_radius"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.4 mm","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2.0 x 10⁻³ mm","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"c","text":"2.5 mm","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"2.8 mm","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"res_013_length_tripled_numeric","topic":"resistivity","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A wire has a resistance of 2.0 Ω. A second wire of the same material and the same cross-sectional area is three times as long. What is the resistance of the second wire?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","scaling","length_proportionality"],"correct_ids":["a"],"distractors":[{"id":"a","text":"6.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"0.67 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"18 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"It cannot be found without knowing the resistivity or the cross-sectional area","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"res_014_area_halved_numeric","topic":"resistivity","level":"pre_ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A wire has a resistance of 3.0 Ω. A second wire of the same material and the same length has half the cross-sectional area. What is the resistance of the second wire?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","scaling","area_proportionality"],"correct_ids":["a"],"distractors":[{"id":"a","text":"6.0 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"1.5 Ω","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"12 Ω","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"d","text":"It cannot be found without knowing the resistivity or the length","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"res_015_length_and_area_doubled","topic":"resistivity","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A wire has resistance R. A second wire of the same material is made twice as long and with twice the cross-sectional area. What is its resistance?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","scaling","competing_effects"],"correct_ids":["a"],"distractors":[{"id":"a","text":"R (unchanged)","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2R","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"c","text":"R / 2","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"4R","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"res_016_drawn_wire_length_tripled","topic":"resistivity","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A wire of resistance R is drawn out at constant volume until it is three times its original length. What is its resistance now?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","volume_preservation","drawn_wire"],"correct_ids":["a"],"distractors":[{"id":"a","text":"9R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"3R","status":"wrong","misconception":"volume_preservation_missed","misconception_label":"Missed volume preservation when a wire is stretched"},{"id":"c","text":"27R","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"d","text":"R (unchanged)","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"}]},{"id":"res_017_unit_of_resistivity","topic":"resistivity","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Resistivity is a property of a material. What is its SI unit?","syllabus_tag":"B.5.9.g","tags":["B.5.9.g","units","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"ohm metre","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"ohm","status":"wrong","misconception":"confused_resistance_resistivity","misconception_label":"Confused resistance R with resistivity ρ"},{"id":"c","text":"ohm per metre","status":"wrong","misconception":"wrong_resistivity_units","misconception_label":"Wrong units for resistivity"},{"id":"d","text":"ohm metre squared","status":"wrong","misconception":"wrong_resistivity_units","misconception_label":"Wrong units for resistivity"}]},{"id":"res_018_transmission_cable_resistance","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"A copper transmission cable of resistivity 1.7 x 10⁻⁸ Ω metre runs between the terminals X and Y. The cable is 3.0 km long and has a uniform cross-sectional area of 2.0 x 10⁻⁴ m². What is the resistance of the cable?","syllabus_tag":"B.5.9.b","tags":["B.5.9.b","context:cable","cable","unit_conversion"],"correct_ids":["a"],"distractors":[{"id":"a","text":"0.26 Ω","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2.6 x 10⁻⁴ Ω","status":"wrong","misconception":"unit_prefix_not_converted","misconception_label":"Did not convert a unit prefix to SI"},{"id":"c","text":"5.1 x 10⁻⁵ Ω","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"d","text":"1.1 x 10⁻¹⁵ Ω","status":"wrong","misconception":"length_area_swapped","misconception_label":"Swapped length and area in the resistivity formula"}]},{"id":"res_019_compare_two_cable_materials","topic":"resistivity","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Two cables have the same length and the same cross-sectional area. One is made of copper, of resistivity 1.7 x 10⁻⁸ Ω metre, and the other of aluminium, of resistivity 2.8 x 10⁻⁸ Ω metre. Which cable has the greater resistance?","syllabus_tag":"B.5.9.h","tags":["B.5.9.h","material_comparison","qualitative"],"correct_ids":["a"],"distractors":[{"id":"a","text":"The aluminium cable","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"The copper cable","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"They have the same resistance","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"It cannot be decided without knowing the current through each cable","status":"wrong","misconception":"qualitative_inference_doubted","misconception_label":"Doubted a qualitative inference without needing values"}]},{"id":"res_020_resistivity_from_graph","topic":"resistivity","level":"ib","mode":"quant","qtype":"mcq_single","template":false,"prompt":"In an experiment to find the resistivity of a metal, a student measures the resistance R of several wires of the same cross-sectional area but different lengths, and plots R against length. The points lie on a straight line through the origin with a gradient of 0.34 Ω per metre. The cross-sectional area of the wires is 0.050 mm². What is the resistivity of the metal?","syllabus_tag":"B.5.9.f","tags":["B.5.9.f","B.5.9.a","graph_interpretation","experiment","resistivity_from_measurements"],"correct_ids":["a"],"distractors":[{"id":"a","text":"1.7 x 10⁻⁸ Ω metre","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"6.8 x 10⁶ Ω metre","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"c","text":"0.34 Ω metre","status":"wrong","misconception":"forgot_area_proportionality","misconception_label":"Missed that R is inversely proportional to area"},{"id":"d","text":"1.7 x 10⁻² Ω metre","status":"wrong","misconception":"unit_prefix_not_converted","misconception_label":"Did not convert a unit prefix to SI"}]},{"id":"res_021_compound_wire_comparison","topic":"resistivity","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Wire X has resistance R. Wire Y is made of a material of half the resistivity of X, is twice as long as X, and has half the diameter of X. What is the resistance of wire Y?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","B.5.9.d","compound_comparison","proportional_reasoning"],"correct_ids":["a"],"distractors":[{"id":"a","text":"4R","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"2R","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"c","text":"8R","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"R (unchanged)","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"res_022_relationship_at_constant_resistance","topic":"resistivity","level":"ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"A set of wires all have the same resistance. Across this set, how does the resistivity of the material depend on the radius r and the length l of the wire?","syllabus_tag":"B.5.9.e","tags":["B.5.9.e","B.5.9.d","B.5.9.a","symbolic_relationship","proportional_reasoning"],"correct_ids":["a"],"distractors":[{"id":"a","text":"resistivity is proportional to r² / l","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"resistivity is proportional to r / l","status":"wrong","misconception":"area_linear_not_squared","misconception_label":"Treated cross-section area as linear in radius"},{"id":"c","text":"resistivity is proportional to l / r²","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"},{"id":"d","text":"resistivity is proportional to l / r","status":"wrong","misconception":"wrong_formula_rearrangement","misconception_label":"Rearranged the formula incorrectly"}]},{"id":"sym_001_identify_voltmeter_from_symbol","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Which component does this circuit symbol represent?","syllabus_tag":"B.5.3.a","tags":["B.5.3.a","B.5.Gu2","voltmeter","meter-symbol","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Voltmeter","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Ammeter","status":"wrong","misconception":"swapped_meter_letter","misconception_label":"Confused meter letter (A vs V)"},{"id":"c","text":"Motor","status":"wrong","misconception":"swapped_meter_letter","misconception_label":"Confused meter letter (A vs V)"},{"id":"d","text":"Cell","status":"wrong","misconception":"","misconception_label":""}]},{"id":"sym_002_identify_single_cell_from_symbol","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"What is this circuit symbol?","syllabus_tag":"B.5.3.a","tags":["B.5.3.a","B.5.Gu2","cell","battery","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Cell","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Battery","status":"wrong","misconception":"cell_battery_confusion","misconception_label":"Confused single cell and multi-cell battery"},{"id":"c","text":"Capacitor","status":"wrong","misconception":"cell_capacitor_confusion","misconception_label":"Confused cell and capacitor"},{"id":"d","text":"Switch","status":"wrong","misconception":"","misconception_label":""}]},{"id":"sym_003_pick_symbol_for_led","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"identify_symbol","template":false,"promp