":["B.5.3.a","B.5.Gu2","generator","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Generator","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Motor","status":"wrong","misconception":"swapped_meter_letter","misconception_label":"Confused meter letter (A vs V)"},{"id":"c","text":"Ammeter","status":"wrong","misconception":"swapped_meter_letter","misconception_label":"Confused meter letter (A vs V)"},{"id":"d","text":"Lamp","status":"wrong","misconception":"","misconception_label":""}]},{"id":"sym_033_identify_earth_from_symbol","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"What does this circuit symbol represent?","syllabus_tag":"B.5.3.a","tags":["B.5.3.a","B.5.Gu2","earth","ground","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Earth (ground)","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Cell","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"Capacitor","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Battery","status":"wrong","misconception":"","misconception_label":""}]},{"id":"sym_034_identify_dc_power_supply_from_symbol","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"What is this circuit symbol?","syllabus_tag":"B.5.3.a","tags":["B.5.3.a","B.5.Gu2","power-supply","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"DC power supply","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Cell","status":"wrong","misconception":"power_supply_vs_cell","misconception_label":"Confused DC power supply and cell"},{"id":"c","text":"Battery","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Voltmeter","status":"wrong","misconception":"","misconception_label":""}]},{"id":"sym_035_identify_two_way_switch_from_symbol","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"What kind of switch is this?","syllabus_tag":"B.5.3.a","tags":["B.5.3.a","B.5.Gu2","switch","two-way-switch","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Two-way (changeover) switch","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Open switch","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"Closed switch","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Push switch","status":"wrong","misconception":"","misconception_label":""}]},{"id":"sym_036_identify_variable_cell_from_symbol","topic":"symbols","level":"pre_ib","mode":"qual","qtype":"mcq_single","template":false,"prompt":"Identify this component.","syllabus_tag":"B.5.3.a","tags":["B.5.3.a","B.5.Gu2","B.5.18","variable-cell","cell","recognition"],"correct_ids":["a"],"distractors":[{"id":"a","text":"Variable cell","status":"correct","misconception":"","misconception_label":""},{"id":"b","text":"Cell","status":"wrong","misconception":"","misconception_label":""},{"id":"c","text":"Variable resistor","status":"wrong","misconception":"","misconception_label":""},{"id":"d","text":"Battery","status":"wrong","misconception":"cell_battery_confusion","misconception_label":"Confused single cell and multi-cell battery"}]}],
misconceptions: {"swapped_series_parallel":{"label":"Confused series and parallel formulae","description":"Applied the series formula when parallel was asked, or vice versa.","topic":"effective_resistance"},"forgot_final_reciprocal":{"label":"Forgot the final reciprocal","description":"Summed reciprocals correctly but reported the sum as R_p without taking the final reciprocal.","topic":"effective_resistance"},"picked_given_value":{"label":"Picked a given value as the answer","description":"Chose one of the resistor (or other) values that appeared in the question as the answer.","topic":"effective_resistance"},"halved_for_three":{"label":"Halved instead of dividing by 3","description":"Divided by 2 when there were three equal resistors in parallel; the rule is divide by n.","topic":"effective_resistance"},"divided_by_two_instead_of_n":{"label":"Divided by 2 instead of by n","description":"Generalised the halved-for-three trap: divided by 2 regardless of how many equal resistors.","topic":"effective_resistance"},"treated_bypass_as_active":{"label":"Treated a bypassed component as still active","description":"Ignored a connecting wire that short-circuits a component, leaving the bypassed component in the calculation.","topic":"effective_resistance"},"disguised_parallel_missed":{"label":"Missed a disguised parallel arrangement","description":"Treated components as series (or parallel) when the diagram disguises the actual topology.","topic":"effective_resistance"},"confused_v_and_i":{"label":"Confused voltage and current","description":"Substituted one quantity for the other in an item that mentions both.","topic":"effective_resistance"},"equal_share_assumption":{"label":"Assumed equal share of current or voltage","description":"Assumed current or voltage divides equally between branches when the branch resistances differ.","topic":"effective_resistance"},"incomplete_reduction":{"label":"Reported an intermediate reduction as the final answer","description":"In a multi-step network reduction, reduced part of the network correctly but stopped before combining with the rest.","topic":"effective_resistance"},"topology_indifferent_assumption":{"label":"Assumed topology does not matter","description":"Assumed identical components combine the same way regardless of series-vs-parallel topology.","topic":"effective_resistance"},"ammeter_in_parallel":{"label":"Placed an ammeter in parallel","description":"Placed an ammeter in parallel with the component being measured; a short-circuit risk.","topic":"circuit_rules"},"voltmeter_in_series":{"label":"Placed a voltmeter in series","description":"Placed a voltmeter in series with the component being measured; blocks current and reads near zero.","topic":"circuit_rules"},"current_splits_when_not_branching":{"label":"Split the current where there is no branch","description":"Assumed current divides at a point that is not a junction.","topic":"circuit_rules"},"voltage_same_in_series":{"label":"Assumed equal voltage across series components","description":"Assumed the voltage across each component in a series chain is the same when it is not.","topic":"circuit_rules"},"bulb_brightness_from_resistance_only":{"label":"Predicted brightness from resistance alone","description":"Predicted bulb brightness from the component's resistance, ignoring the current it actually carries.","topic":"circuit_rules"},"switch_state_inverted":{"label":"Inverted the switch state","description":"Predicted the consequence of a closed switch as if it were open, or vice versa.","topic":"circuit_rules"},"current_consumed_at_components":{"label":"Thought current is consumed at components","description":"Assumed current is used up passing through a resistor or bulb, so less comes out than goes in.","topic":"circuit_rules"},"meter_kinds_interchangeable":{"label":"Treated ammeter and voltmeter as interchangeable","description":"Missed the distinction between what an ammeter and a voltmeter measure in a given position.","topic":"circuit_rules"},"wrong_formula_rearrangement":{"label":"Rearranged the formula incorrectly","description":"Computed the wrong combination of the formula's quantities (e.g. multiplied when division was needed).","topic":"basic_circuit_formulas"},"units_off_by_factor":{"label":"Wrong unit prefix","description":"Right number, wrong unit prefix; for instance mA where A was needed.","topic":"basic_circuit_formulas"},"swapped_factor_in_squared":{"label":"Squared the wrong factor","description":"In P = I²R or P = V²/R, squared the resistance instead of the current/voltage, or vice versa.","topic":"basic_circuit_formulas"},"treated_V_as_I":{"label":"Treated voltage as current","description":"Substituted the voltage value into the formula where the current value was needed.","topic":"basic_circuit_formulas"},"treated_I_as_V":{"label":"Treated current as voltage","description":"Substituted the current value into the formula where the voltage value was needed.","topic":"basic_circuit_formulas"},"wrong_constant_for_period":{"label":"Confused period with elapsed time","description":"In I = Δq/Δt, used the period instead of the elapsed time, or vice versa.","topic":"basic_circuit_formulas"},"forgot_to_square_in_power":{"label":"Forgot to square in the power formula","description":"In P = I²R or P = V²/R, omitted the squaring entirely.","topic":"basic_circuit_formulas"},"wrong_power_form_for_topology":{"label":"Applied the wrong power form for the topology","description":"Used P = V²/R reasoning (smaller R gives more power) in a series context, or P = I²R reasoning (larger R gives more power) in a parallel context.","topic":"basic_circuit_formulas"},"swapped_meter_letter":{"label":"Confused meter letter (A vs V)","description":"Read the letter inside the meter circle as the wrong meter kind (ammeter A vs voltmeter V; sometimes ohmmeter Ω).","topic":"symbols"},"cell_battery_confusion":{"label":"Confused single cell and multi-cell battery","description":"Read the single-cell symbol as a multi-cell battery or vice versa; missed the convention that several cells in line are drawn as repeated pairs.","topic":"symbols"},"cell_capacitor_confusion":{"label":"Confused cell and capacitor","description":"Read the long-line / short-line cell symbol as a two-plate capacitor (d051; cross-topic candidate into capacitance once that topic is authored).","topic":"symbols"},"heater_resistor_swap":{"label":"Confused heater and resistor","description":"Read the heater (rectangle with the small zig-zag inside) as a plain fixed resistor or vice versa.","topic":"symbols"},"fuse_resistor_swap":{"label":"Confused fuse and fixed resistor","description":"Read the fuse symbol (rectangle with the small line through it) as a fixed resistor or vice versa.","topic":"symbols"},"ldr_vs_led":{"label":"Confused LDR and LED","description":"Read the two-arrow-in LDR as the one-arrow-out LED or vice versa; the arrow direction encodes the boundary.","topic":"symbols"},"diode_vs_led":{"label":"Confused diode and LED","description":"Read the diode triangle without arrows as an LED or vice versa; the absence or presence of light-emission arrows is the only visual difference.","topic":"symbols"},"bell_vs_buzzer_vs_speaker":{"label":"Confused output device kind (bell / buzzer / loudspeaker / microphone)","description":"Confused any pair among bell, buzzer, loudspeaker and microphone. The bell-vs-buzzer sub-trap was retracted in brief v0.11 because both draw as the same dome per the Builder; the slug name is retained for the wider three-way (dome / cone / microphone) confusion.","topic":"symbols"},"dashed_vs_solid_cells":{"label":"Misread dashed-line several-cell convention","description":"Misread the dashed line between cell pairs (the 'and so on' convention for unspecified-N cells) as a different component or as a fault in the diagram.","topic":"symbols"},"us_vs_iec_resistor":{"label":"Chose US zig-zag resistor over IEC rectangle","description":"Picked the US-convention zig-zag resistor when the IB syllabus uses the IEC rectangle (or vice versa). The topic standardises on IEC; the US form is named only on sym_004 to make the convention explicit.","topic":"symbols"},"power_supply_vs_cell":{"label":"Confused DC power supply and cell","description":"Read the labelled DC power supply box (mains-derived) as a chemical cell, or vice versa (d052). Distinct from cell_battery_confusion which is one-vs-many cells of the same chemical kind.","topic":"symbols"},"qualitative_inference_doubted":{"label":"Doubted a qualitative inference without needing values","description":"Picked 'cannot tell without specific values' for a qualitative comparison that can in fact be decided from the named topology and the formula structure alone (d048; promoted from a flag on bcf_006 / bcf_007 and six circuit_rules distractors).","topic":"circuit_rules"},"unit_prefix_not_converted":{"label":"Did not convert a unit prefix to SI","description":"Took a length or area at face value in mm, cm, μm, mm² etc. without converting to SI (m, m²). d050; surfaces on res_006 and res_018 explicitly.","topic":"resistivity"},"confused_resistance_resistivity":{"label":"Confused resistance R with resistivity ρ","description":"Treated R (a property of a particular piece of material, units Ω) and ρ (an intensive property of the material, units Ω·m) as if they were the same quantity, or used one in place of the other.","topic":"resistivity"},"area_linear_not_squared":{"label":"Treated cross-section area as linear in radius","description":"Used A = πr (linear) instead of A = πr² for the cross-sectional area of a circular wire, dropping the squared term.","topic":"resistivity"},"forgot_area_proportionality":{"label":"Missed that R is inversely proportional to area","description":"Forgot the 1/A in R = ρL/A; treated R as independent of A or as proportional to A rather than inversely proportional.","topic":"resistivity"},"length_area_swapped":{"label":"Swapped length and area in the resistivity formula","description":"Used R = ρA/L (or ρ = RL/A) instead of R = ρL/A; either swapped L and A in the substitution, or confused the direction of the rearrangement.","topic":"resistivity"},"volume_preservation_missed":{"label":"Missed volume preservation when a wire is stretched","description":"On a stretched-wire problem, ignored that volume V = LA stays constant when the wire is drawn out; only used the new length without the implied area change (so missed the L² scaling of the resistance).","topic":"resistivity"},"wrong_resistivity_units":{"label":"Wrong units for resistivity","description":"Reported ρ in Ω/m, Ω·m² or Ω alone instead of Ω·m.","topic":"resistivity"},"confused_definition_with_law":{"label":"Confused R = V/I (definition) with Ohm's law (constancy)","description":"Treated R = V/I as 'Ohm's law' rather than as the definition of resistance (d034). Ohm's law is the claim that R is constant across applied V at fixed temperature; the equation R = V/I holds for any conductor as a definition. d049.","topic":"basic_circuit_formulas"},"misread_iv_graph_for_ohmic":{"label":"Misread an IV graph for ohmic behaviour","description":"Read a non-linear IV curve as ohmic (or a linear-through-origin IV curve as non-ohmic). The ohmic criterion is a straight line through the origin at constant temperature. d049.","topic":"basic_circuit_formulas"},"ohmic_confused_with_metal":{"label":"Assumed metal implies ohmic at all temperatures","description":"Took 'this conductor is a metal' as sufficient to call it ohmic. The ohmic claim depends on operating temperature; a filament lamp is a metal that is non-ohmic at operating temperature because the filament heats up. d049.","topic":"basic_circuit_formulas"},"ohmic_confused_with_variable_resistor":{"label":"Confused a variable-resistor element with an ohmic one","description":"Read an LDR, thermistor or rheostat as ohmic. These respond to external conditions (light, temperature, mechanical setting); their IV behaviour at a fixed setting and temperature can be ohmic, but the device as used is not. d049.","topic":"basic_circuit_formulas"},"ohms_law_misread_temperature_role":{"label":"Misread the role of constant temperature in Ohm's law","description":"Stated that temperature has no role in Ohm's law, or that Ohm's law applies to a filament lamp at operating temperature. The constant-temperature condition is the precondition under which R can be a constant across applied V; without it the claim does not hold. d049.","topic":"basic_circuit_formulas"},"rounding_mistake":{"label":"Near-miss under a plausible rounding regime","description":"Within 0.5% of the correct value when an intermediate step is rounded under one of the engine's default regimes (2/3 sig figs × round_half_up / round_half_to_even / truncate). Engine-derived; author-declared `rounding_variants:` slugs take precedence per d032.","topic":"cross_topic"},"loading_magnitude_ratio_missed":{"label":"Compared meter R absolutely, not as a ratio to measured R","description":"Compared the meter's absolute internal resistance to a fixed threshold rather than to the ratio against the measured resistor. The size of the loading effect depends on R_meter / R_measured; equal magnitudes is the worst case. Promoted via AuthoringNonIdealMeters v3 audit, 2026-06-09.","topic":"non_ideal_meters"},"divider_ratio_inverted":{"label":"Inverted the divider ratio","description":"Used R1/(R1+R2) where R2/(R1+R2) was needed (or vice versa); the output is taken across the wrong resistor.","topic":"potential_divider"},"divider_loading_ignored":{"label":"Ignored loading on the divider","description":"Gave the unloaded output voltage when a load across the lower resistor changes it; the load in parallel lowers that resistance and the share.","topic":"potential_divider"},"divider_treated_as_parallel":{"label":"Treated a series divider as parallel","description":"Read the two divider resistors as a parallel combination rather than a series chain sharing the supply voltage.","topic":"potential_divider"},"sensor_resistance_direction_wrong":{"label":"Sensor resistance changes the wrong way","description":"Got the direction of an NTC thermistor's or LDR's resistance change wrong (e.g. thought a warmer thermistor has higher resistance).","topic":"potential_divider"},"sensor_v_out_direction_wrong":{"label":"Sensor output voltage changes the wrong way","description":"Tracked the sensor's resistance change correctly but drew the wrong conclusion about which way the output voltage moves.","topic":"potential_divider"},"meter_idealisation_doubted":{"label":"Over-corrected an ideal meter to non-ideal","description":"After learning real meters are non-ideal, doubted that a meter can be treated as ideal even where the question says to.","topic":"non_ideal_meters"},"voltmeter_resistance_finite_missed":{"label":"Missed a voltmeter's finite resistance","description":"Treated a real voltmeter as infinite-resistance, ignoring the current it draws and the loading it causes.","topic":"non_ideal_meters"},"ammeter_resistance_zero_assumed":{"label":"Assumed an ammeter has zero resistance","description":"Treated a real ammeter as exactly zero resistance, ignoring the small series resistance it adds.","topic":"non_ideal_meters"},"loading_direction_wrong":{"label":"Meter loading effect in the wrong direction","description":"Recognised a meter loads the circuit but got the direction of the effect on the reading wrong.","topic":"non_ideal_meters"},"series_pd_rule_applied_to_parallel":{"label":"Applied the series p.d.-sharing rule to a parallel context","description":"Carried 'p.d. divides in proportion to R along a series chain' into parallel branches, where p.d. is instead equal across the branches. Promoted from circuit_rules v11 (cr_014, cr_029, cr_035).","topic":"circuit_rules"},"wrong_branch_voltage":{"label":"Took the p.d. across the wrong branch or resistor","description":"Read or computed the potential difference across the wrong element in the network (the complement, or the series partner). Promoted 2026-06-09; used by circuit_calculations and non_ideal_meters nim_002.","topic":"circuit_calculations"},"i_total_before_reducing":{"label":"Used the total current before reducing the network","description":"Applied the total or cell current to a branch before reducing the network to find the actual branch current. Promoted 2026-06-09 (circuit_calculations NEW_FLAG).","topic":"circuit_calculations"},"branch_current_equals_total":{"label":"Used the supply current as the branch current","description":"Treated a post-junction branch current as equal to the total/supply current (the inverse of current_splits_when_not_branching, and distinct from i_total_before_reducing). Promoted from circuit_calculations v1 (cc_002 d).","topic":"circuit_calculations"},"wiper_direction_wrong":{"label":"Got the potentiometer slider-to-output direction backwards","description":"Reversed which way the output voltage moves as the potentiometer slider/wiper moves; the geometric analogue of sensor_v_out_direction_wrong but a distinct mechanism. Promoted from potential_divider pd_007.","topic":"potential_divider"},"carriers_are_protons":{"label":"Thinks the carriers in a metal are protons","description":"Believes the mobile charge carriers in a metal are protons rather than free electrons.","topic":"conduction"},"carriers_misidentified":{"label":"Misidentified the mobile charge carriers","description":"Named the wrong carriers (ions drifting, or both ions and electrons moving) in a metallic conductor.","topic":"conduction"},"insulator_has_no_atoms":{"label":"Confused few free electrons with no charges at all","description":"Read 'an insulator has few/no FREE electrons' as 'an insulator has no charges/atoms at all'.","topic":"conduction"},"resistance_is_friction":{"label":"Over-literal friction picture of resistance","description":"Treats resistance as simple friction with no energy-transfer-to-the-lattice content.","topic":"conduction"},"current_used_up_microscopic":{"label":"Charge used up along the conductor (carrier level)","description":"The carrier-level form of the charge-from-battery picture: current/charge is consumed as it moves through the material.","topic":"conduction"},"resistance_falls_with_temperature_metal":{"label":"Metal's resistance falls as temperature rises","description":"Believes a metal conductor's resistance decreases with temperature (the semiconductor behaviour imported to a metal).","topic":"conduction"},"resistance_rise_blamed_on_expansion":{"label":"Blamed the resistance rise on thermal expansion","description":"Right direction, wrong mechanism: attributes a metal's rising resistance to the wire expanding, not to increased lattice vibration and collisions.","topic":"conduction"},"heating_independent_of_current":{"label":"Heating blamed on voltage alone, current irrelevant","description":"Treats heating in a conductor as caused by voltage with the current treated as irrelevant.","topic":"conduction"},"wrong_property_distinguishes_conductor":{"label":"Wrong property used to tell conductor from insulator","description":"Uses the wrong material property (packing density, shininess, electron speed) instead of free-carrier count to distinguish a conductor from an insulator.","topic":"conduction"},"internal_resistance_as_energy_loss":{"label":"Defined internal resistance as energy loss","description":"Defines r as the energy/power lost inside the cell rather than the resistance of the cell's contents (the loss is the consequence, not the definition).","topic":"internal_resistance"},"terminal_pd_equals_emf":{"label":"Treated terminal p.d. as equal to emf","description":"Ignores the lost volts: treats the loaded terminal p.d. as equal to the emf, or uses the full emf across the external R (omitting r in epsilon = I(R+r)).","topic":"internal_resistance"},"lost_volts_sign_wrong":{"label":"Added the lost volts instead of subtracting","description":"Gets the lost-volts sign wrong: V = epsilon + Ir, so terminal p.d. reads above the emf under load.","topic":"internal_resistance"},"point_resistance_for_internal":{"label":"Used R = V/I for the internal resistance","description":"Computes internal resistance as a point V/I (external or total) instead of from the lost volts or the V-against-I gradient.","topic":"internal_resistance"},"emf_internal_power_confused":{"label":"Confused power in the cell with power in the load","description":"Mixed P = I^2 r (dissipated inside the cell) with P = I^2 R (dissipated in the load).","topic":"internal_resistance"},"short_circuit_current_unlimited":{"label":"Treated short-circuit current as unlimited","description":"Ignores internal resistance and believes a short-circuit current is unbounded; r is what limits it (I = epsilon/r).","topic":"internal_resistance"},"order_matters_assumed":{"label":"Assumed component order changes the current","description":"Believes the order of components in a series loop changes the current, i.e. current does something different to the first component it meets.","topic":"qualitative_probes"},"charge_from_battery_dispensed":{"label":"Current comes from the battery and is used up","description":"Imagines current originating in the battery and being dispensed/used up along the way, rather than flowing around a closed loop.","topic":"qualitative_probes"},"own_resistance_fixes_own_share":{"label":"A component's share depends only on its own resistance","description":"Thinks a component's share of current or voltage is fixed by its own resistance alone, ignoring the rest of the circuit.","topic":"qualitative_probes"},"equal_current_in_parallel_assumed":{"label":"Assumed parallel branches carry equal current","description":"Assumes parallel branches share the current equally regardless of their resistances (d072 split of equal_share_assumption).","topic":"circuit_rules"},"equal_pd_in_series_assumed":{"label":"Assumed series components share equal p.d.","description":"Assumes series components share the supply voltage equally regardless of their resistances (d072 split of equal_share_assumption).","topic":"circuit_rules"},"solar_cell_stores_energy":{"label":"Thinks a solar cell stores energy","description":"Treats a photovoltaic cell as storing light or charge like a battery, rather than producing current only while illuminated. ir_014 b, ir_019 b. d082.","topic":"internal_resistance"},"cells_series_parallel_combination_confused":{"label":"Confused series/parallel cell combination","description":"Mixed up how emf and internal resistance combine for cells: series adds emf and r; identical cells in parallel keep emf and divide r by n. ir_011 d, ir_012 b. d082.","topic":"internal_resistance"},"max_power_load_not_matched":{"label":"Missed load-matching for maximum power","description":"Did not recognise that maximum power is delivered to the load when load resistance equals internal resistance; assumed the largest or smallest load gives most power. ir_013 b/c/d. d082.","topic":"internal_resistance"},"energy_destroyed_in_resistor":{"label":"Thinks energy is destroyed in a resistor","description":"Believes electrical energy delivered to a resistor is used up or disappears, rather than transferred to internal energy of the lattice and then the surroundings. conduction_010 c (retro-tag pending). d082.","topic":"conduction"},"gradient_sign_ignored":{"label":"Ignored the V-I gradient's sign/magnitude","description":"On a cell's terminal-p.d.-against-current line, mishandled the gradient when finding r (r = magnitude of the slope); dropped the sign or misread the slope. irg_002. d085.","topic":"internal_resistance"},"emf_intercept_read_as_resistance":{"label":"Read the emf intercept as the internal resistance","description":"Confused the V-axis intercept (the emf) with the gradient (the internal resistance) when reading a cell V-I line; e.g. picked the line with the highest intercept as having the largest r. irg_006. d085.","topic":"internal_resistance"}}
};
</script>
<script>
"use strict";
var PUBLISHED_CSV_URL = "";  // legacy read path; the workbook mode (d007) supersedes it

// ---- project registry (d004): one viewer, a library of projects ----
// A project with no catalogue still gets the class view: its rows render as
// "(item not in catalogue)" (d002 graceful degradation). Remote sidecar:
// { id:"x", label:"X", catalogueUrl:"https://.../x.catalogue.js" }
var TV_PROJECTS = [
  { id:"electric_circuits_mastery", label:"Electric Circuits Mastery" }
];
var TV_BUILD="__BUILD__";  // deploy_teacher.bat stamps this with the deploy date/time; shows "dev" if unstamped
var APPS_SCRIPT_MODE = !!(typeof google!=="undefined" && google.script && google.script.run);
var CAT=[], MISC={}, catById={}, itemMiscSlugs={};
var state = { rows:[], records:[], raw:[], sourceLabel:"none", phase:"idle", problem:"", tab:"grid", collapsed:{}, project:TV_PROJECTS[0].id,
  roster:[], classes:[], rosterByAlias:{}, rosterLabel:{}, rosterClasses:{}, projectSubject:{} };
function indexRoster(){
  state.rosterByAlias={}; state.rosterLabel={}; state.rosterClasses={};
  (state.roster||[]).forEach(function(p){
    var key=p.pid||p.email; if(!key) return;   // pid = name today, email later (d014)
    state.rosterLabel[key]=p.label||(p.email?p.email.split("@")[0]:key);
    state.rosterClasses[key]=p.classes||[];
    (p.aliases||[]).forEach(function(a){ state.rosterByAlias[String(a).trim().toLowerCase()]=key; });
  });
}
function projectLabel(){ var p=TV_PROJECTS.filter(function(x){return x.id===state.project;})[0]; return p?p.label:state.project; }
function setCatalogue(id){
  var c=(window.TV_CATALOGUES||{})[id]||{items:[],misconceptions:{}};
  CAT=c.items||[]; MISC=c.misconceptions||{};
  catById={}; CAT.forEach(function(it){ catById[it.id]=it; });
  itemMiscSlugs={}; CAT.forEach(function(it){ itemMiscSlugs[it.id]=distinct((it.distractors||[]).filter(function(d){return d.misconception;}).map(function(d){return d.misconception;})); });
}
// Adapt a fetched catalogue JSON to {items, misconceptions}. Tolerant of shape:
// raw may be an array, or {items|questions|catalogue|data:[...]} with an
// optional {misconceptions:{}}. Item id may be id/question_id/item_id/qid.
// Misconceptions are taken as given and topped up from each distractor.
function adaptCatalogue(raw){
  var items = Array.isArray(raw) ? raw
    : (raw && (raw.items || raw.questions || raw.catalogue || raw.data)) || [];
  var misc = (raw && raw.misconceptions && typeof raw.misconceptions==="object") ? raw.misconceptions : {};
  items.forEach(function(it){
    if(it && it.id==null){ it.id = it.question_id || it.item_id || it.qid; }
    ((it && it.distractors) || []).forEach(function(d){
      var slug = d && (d.misconception || d.misconception_id);
      if(slug && !misc[slug]) misc[slug] = { label: (d.misconception_label || slug) };
    });
  });
  return { items: items, misconceptions: misc };
}
function loadCatalogue(id,done){
  var p=TV_PROJECTS.filter(function(x){return x.id===id;})[0];
  if((window.TV_CATALOGUES||{})[id] || !p || !p.catalogueUrl){ setCatalogue(id); done(); return; }
  var url=p.catalogueUrl, doneOnce=false;
  // finish() runs setCatalogue+done exactly once. A hard timeout guarantees it
  // even if the fetch or the <script> never resolves, so a slow or blocked
  // catalogue can never hang the project switch (it just falls back to
  // "unmatched"). This is the guard that was missing.
  function finish(){ if(doneOnce) return; doneOnce=true; setCatalogue(id); done(); }
  setTimeout(finish, 6000);
  if(/\.js(\?|#|$)/i.test(url)){                       // JS sidecar registers TV_CATALOGUES[id]
    var s=document.createElement("script"); s.src=url;
    s.onload=finish; s.onerror=finish; document.head.appendChild(s); return;
  }
  // JSON catalogue: fetch, adapt, cache. Any failure or timeout -> "unmatched".
  fetch(url).then(function(r){ if(!r.ok) throw new Error("HTTP "+r.status); return r.json(); })
    .then(function(raw){ if(!doneOnce){ (window.TV_CATALOGUES=window.TV_CATALOGUES||{})[id]=adaptCatalogue(raw); } finish(); })
    .catch(finish);
}

function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
function distinct(a){ return a.filter(function(v,i){ return a.indexOf(v)===i; }); }
// d021: a Sheets cell arrives as whatever TYPE it holds, not always a string.
// An all-digit anonymous_id (92572000), a numeric cohort or a date-typed cell
// comes back as a number/Date, and calling .trim() on it throws. That throw
// happened inside the load chain, so the screen kept its stale "0 learners"
// line and the failure was invisible. Coerce every raw cell before touching it.
function txt(v){ return v==null?"":String(v); }
// Section-suffixed ids (qc_dc_015#sA) are variants of ONE catalogued question:
// the driller's own catalogue holds only the bare id, so match on that base and
// let the sections collapse into a single question row.
function baseItemId(v){
  var s=txt(v).trim(), i=s.indexOf("#");
  // Section collapsing was agreed for Kinematics, not for every producer's IDs.
  return state.project==="kinematics_driller"&&!catById[s]&&i>0?s.slice(0,i):s;
}
function lerp(a,b,t){ return Math.round(a+(b-a)*t); }
function mix(c1,c2,t){ return "rgb("+lerp(c1[0],c2[0],t)+","+lerp(c1[1],c2[1],t)+","+lerp(c1[2],c2[2],t)+")"; }
// House table style (d008): smooth gradients white-anchored at zero, darkness
// capped so BLACK text stays readable everywhere; never flip the font to white.
// A client-side app must compute colours at runtime, so the data-tables skill's
// shade.py interpolation is mirrored here rather than called (stated departure).
var SHADE_CAP = { green:0.70, purple:0.60, red:0.65 };
function greenStyle(pct){ var t=Math.max(0,Math.min(1,pct/100))*SHADE_CAP.green; return "background:"+mix([255,255,255],[27,94,32],t)+";color:#1d1d1f;"; }
function purpleStyle(v,max){ var t=(max>0?Math.max(0,Math.min(1,v/max)):0)*SHADE_CAP.purple; return "background:"+mix([255,255,255],[74,20,140],t)+";color:#1d1d1f;"; }
function redStyle(pct){ var t=Math.max(0,Math.min(1,pct/100))*SHADE_CAP.red; return "background:"+mix([255,255,255],[198,40,40],t)+";color:#1d1d1f;"; }

// ---- CSV parser ----
function parseCSV(text){
  var rows=[],row=[],f="",i=0,q=false,c; text=text.replace(/\r\n/g,"\n").replace(/\r/g,"\n");
  var delimiter=text.split("\n",1)[0].indexOf("\t")!==-1?"\t":",";
  while(i<text.length){ c=text[i];
    if(q){ if(c==='"'){ if(text[i+1]==='"'){f+='"';i+=2;continue;} q=false;i++;continue;} f+=c;i++;continue; }
    if(c==='"'&&f===""){q=true;i++;continue;}
    if(c===delimiter){row.push(f);f="";i++;continue;}
    if(c==='\n'){row.push(f);rows.push(row);row=[];f="";i++;continue;}
    f+=c;i++;
  }
  if(f.length||row.length){row.push(f);rows.push(row);}
  if(!rows.length) return [];
  var head=rows[0].map(function(h){return String(h).trim();});
  return rows.slice(1).filter(function(r){return r.length>1||(r.length===1&&r[0].trim()!=="");})
    .map(function(r){var o=Object.create(null);head.forEach(function(h,idx){o[h]=r[idx]!==undefined?r[idx]:"";});return o;});
}
// d026: receive first, interpret by view. Subject fields and nested evidence
// must survive even when no specialist renderer exists for them yet.
function cleanRecordValue(value){
  if(value instanceof Date)return value.toISOString();
  if(typeof value==="string" && /^[\s]*[\[{]/.test(value)){
    try {var decoded=JSON.parse(value);return JSON.stringify(cleanRecordValue(decoded));}catch(e){}
  }
  if(Array.isArray(value)) return value.map(cleanRecordValue);
  if(value && typeof value==="object"){
    var clean=Object.create(null);
    Object.keys(value).forEach(function(k){if(k.trim().toLowerCase()!=="google_email") clean[k]=cleanRecordValue(value[k]);});
    return clean;
  }
  return value;
}
function recordFields(raw){
  var fields=Object.create(null);
  function merge(source,depth){
    if(!source||typeof source!=="object"||Array.isArray(source)) return;
    var tail=source.extra_json;
    if(depth<5 && tail){
      if(typeof tail==="string"){try{tail=JSON.parse(tail);}catch(e){tail=null;}}
      if(tail&&typeof tail==="object"&&!Array.isArray(tail)) merge(tail,depth+1);
      else fields.extra_json=txt(source.extra_json); // malformed data is visible, not silently dropped
    }
    Object.keys(source).forEach(function(k){
      if(k==="extra_json"||k.trim().toLowerCase()==="google_email") return;
      var v=source[k];
      // A sparse newly minted column can be blank on historical rows. False
      // and zero are explicit values and must override the old tail.
      if(v!==""&&v!=null || !Object.prototype.hasOwnProperty.call(fields,k)) fields[k]=cleanRecordValue(v);
    });
  }
  merge(raw,0); return fields;
}
function normalise(raw){
  var fields=recordFields(raw), name=txt(fields.display_name).trim(), anon=txt(fields.anonymous_id).trim();
  var status=txt(fields.status).trim(), rowType=txt(fields.row_type).trim().toLowerCase();
  return { fields:fields, row_type:status==="session_start"&&(!rowType||rowType==="attempt")?"session_start":rowType||"attempt",
    attempt_id:txt(fields.attempt_id).trim(), project:txt(fields.project).trim(),
    item_id:baseItemId(fields.item_id), item_ref:txt(fields.item_id).trim(),
    topic:txt(fields.topic).trim(), name:name, anon:anon,
    learnerKey:name||anon||"(unknown)", cohort:txt(fields.cohort).trim(), status:status,
    picked_id:txt(fields.picked_id).trim(), misconception_id:txt(fields.misconception_id).trim(),
    timestamp:txt(fields.timestamp||fields.received_at).trim(), syllabus_tag:txt(fields.syllabus_tag).trim(),
    pupil:txt(fields.pupil).trim() };
}
function itemFor(id){
  var known=catById[id]||{}, record=(state.rows||[]).filter(function(r){return r.item_id===id;}).slice(-1)[0];
  var f=record?record.fields:{};
  return {id:id,topic:known.topic||(record&&record.topic)||"(no topic)",
    prompt:known.prompt||f.question_text||f.prompt||"(question text not supplied)",
    label:known.label||f.item_label||f.question_label||"", qtype:known.qtype||f.qtype||"",
    level:known.level||f.level||"",syllabus_tag:known.syllabus_tag||(record&&record.syllabus_tag)||"",
    distractors:known.distractors||[]};
}
// d011 identity merge: resolve each row to a rostered pupil (server-resolved
// `pupil` first, then client alias match for CSV mode) and relabel learnerKey
// with the roster label, so two vague sign-ins collapse into one column.
function applyRoster(r){
  // Carry a display name onto this pupil's earlier un-named rows via their
  // stable anonymous_id, so pre-name attempts merge with the named ones instead
  // of appearing as a separate UUID learner.
  if(!r.name && r.anon && state.anonName && state.anonName[r.anon]){ r.name=state.anonName[r.anon]; r.learnerKey=r.name; }
  var em = r.pupil || state.rosterByAlias[r.name.toLowerCase()] || state.rosterByAlias[r.anon.toLowerCase()] || "";
  if(em){ r.pupilEmail=em; r.learnerKey=state.rosterLabel[em]||r.learnerKey; }
  return r;
}
function buildCells(rows){
  var m={};
  rows.forEach(function(r){ var k=r.learnerKey+"||"+r.item_id; (m[k]||(m[k]={attempts:[]})).attempts.push(r); });
  Object.keys(m).forEach(function(k){
    var a=m[k].attempts.slice().sort(function(x,y){return x.timestamp<y.timestamp?-1:x.timestamp>y.timestamp?1:0;});
    var latest=a[a.length-1], earlier=a.slice(0,-1);
    m[k]={attempts:a,latest:latest,count:a.length,
      recovered:latest.status==="correct"&&earlier.some(function(e){return e.status==="wrong"||e.status==="half";}),
      slipped:latest.status==="wrong"&&earlier.some(function(e){return e.status==="correct";})};
  });
  return m;
}
function groupKeyOf(it,mode){ return mode==="syllabus" ? (it.syllabus_tag||"(untagged)") : (it.topic||"(none)"); }
function sortGroupKeys(keys,mode){
  return keys.sort(function(a,b){
    if(mode==="syllabus"){
      var pa=a.split(/[.\s]/).map(function(x){var n=parseInt(x,10);return isNaN(n)?x:n;});
      var pb=b.split(/[.\s]/).map(function(x){var n=parseInt(x,10);return isNaN(n)?x:n;});
      for(var i=0;i<Math.max(pa.length,pb.length);i++){ if(pa[i]===undefined)return -1; if(pb[i]===undefined)return 1;
        if(pa[i]<pb[i])return -1; if(pa[i]>pb[i])return 1; }
      return 0;
    }
    return a<b?-1:a>b?1:0;
  });
}

// ---- shared filtering ----
function timeCutoff(){
  var v=els["f-time"].value;
  if(!v||v==="all") return null;
  if(v==="since"){ var sv=els["f-since"].value; if(!sv) return null; var ts=new Date(sv).getTime(); return isNaN(ts)?null:ts; }
  var mins=parseFloat(v); if(isNaN(mins)) return null; return Date.now()-mins*60000;
}
function filterRecords(records){
  var coh=els["f-cohort"].value, cls=els["f-class"].value, lf=els["f-learner"].value.trim().toLowerCase(), cut=timeCutoff();
  var topic=els["f-topic"].value;
  return records.filter(function(r){
    if(coh && r.cohort!==coh) return false;
    // class filter (d011): only rostered pupils can match a class; when a
    // class is selected, unrostered identities are excluded by design.
    if(cls && !(r.pupilEmail && (state.rosterClasses[r.pupilEmail]||[]).indexOf(cls)!==-1)) return false;
    if(lf && r.learnerKey.toLowerCase().indexOf(lf)===-1) return false;
    if(topic && (r.topic || (catById[r.item_id]||{}).topic)!==topic) return false;
    if(cut!=null){ var t=new Date(r.timestamp).getTime(); if(isNaN(t)||t<cut) return false; }
    return true;
  });
}
function filteredRows(){return filterRecords(state.rows);}
function filteredRecords(){return filterRecords(state.records);}
function learnerLabel(key,anon){ if(!anon) return key; var h=0; for(var i=0;i<key.length;i++){h=(h*31+key.charCodeAt(i))>>>0;} return "L-"+("000"+(h%1000)).slice(-3); }

var els={};
["grid","misc","ticker","records","r-type","status","f-project","f-group","f-cohort","f-class","f-topic","f-learner","f-all","f-anon","f-time","f-since","f-auto","detail","csvurl","t-size","t-unit","t-count","t-end","t-metric"].forEach(function(id){els[id]=document.getElementById(id);});

function applyCollapsed(container){
  Object.keys(state.collapsed).forEach(function(gid){
    if(!state.collapsed[gid]) return;
    var gr=container.querySelector('tr.group[data-grp="'+gid+'"]'); if(!gr) return;
    var ch=gr.querySelector(".chev"); if(ch) ch.textContent="▸";
    container.querySelectorAll("tr."+gid).forEach(function(r){ r.style.display="none"; });
  });
}
// d021: loading, failed and genuinely-empty used to render identically (a
// "0 learners · 0 questions · 0 attempts" line over "Nothing to show in this
// view yet"), so a silent failure was indistinguishable from an empty class.
// Say which of the three it is, and when it IS empty, say why.
function emptyWhy(fr){
  if(state.phase==="loading") return "Loading from the workbook…";
  if(state.phase==="error")   return "Could not load: "+(state.problem||"unknown error");
  if(!state.raw.length)       return "The workbook returned no rows for this project.";
  if(!state.rows.length){
    // A project whose app posts only the sign-in ping (ppq-login's session_start,
    // item_id blank) fills a tab with rows that are correctly dropped as
    // non-attempts. Say that, rather than implying the data is malformed.
    var ss=0; state.raw.forEach(function(r){ if(txt(r.status).trim()==="session_start") ss++; });
    if(ss===state.raw.length) return "Only sign-in pings here: "+ss+" session starts and no question attempts. This project's app reports who logged in, but does not yet report answers.";
    return state.records.length+" records received, with no item-level attempts for this view. Open Records to inspect their feedback and fields.";
  }
  if(!fr.length)              return "No rows match the current filters (cohort, class, topic, time).";
  return "Nothing to show in this view yet.";
}
// Status vocabulary is a view capability, not an admission rule. We retain
// subject outcomes verbatim; only known assessed results enter accuracy.
var KNOWN_STATUS = { correct:1, wrong:1, half:1, untried:1, declared:1 };
function isScoredStatus(status){return status==="correct"||status==="wrong"||status==="half";}
function isAttemptRecord(r){return r.row_type==="attempt"&&r.status!=="session_start"&&r.status!=="declared"&&r.status!=="untried";}
function statusClass(status){return isScoredStatus(status)?status:status==="declared"?"declared":status==="untried"?"none":"unscored";}
function buildSummary(rows){
  var s={att:0,scored:0,cor:0,pct:null};
  rows.forEach(function(r){if(!isAttemptRecord(r))return; s.att++; if(isScoredStatus(r.status)){s.scored++;if(r.status==="correct")s.cor++;}});
  if(s.scored)s.pct=Math.round(100*s.cor/s.scored);return s;
}
function unknownStatusNote(){
  var seen=Object.create(null), any=false;
  (state.rows||[]).forEach(function(r){
    var s=txt(r.status).trim(); if(Object.prototype.hasOwnProperty.call(KNOWN_STATUS,s)) return;
    if(!s)s="(no outcome)";
    seen[s]=(seen[s]||0)+1; any=true;
  });
  if(!any) return "";
  var parts=Object.keys(seen).sort().map(function(s){ return s+"×"+seen[s]; });
  return " · Unscored outcomes: "+parts.join(", ")+" (retained in Records; excluded from accuracy until interpreted)";
}
function statusLine(bits){
  if(state.phase==="loading") return projectLabel()+" · loading…";
  if(state.phase==="error")   return projectLabel()+" · LOAD FAILED · "+(state.problem||"unknown error");
  return bits+unknownStatusNote();
}
function render(){
  var cont = document.getElementById("tab-"+state.tab);
  var wo = cont.querySelector(".wrap"); var st=wo?wo.scrollTop:0, sl=wo?wo.scrollLeft:0;
  if(state.tab==="grid") renderGrid(); else if(state.tab==="misc") renderMisc(); else if(state.tab==="records") renderRecords(); else renderTicker();
  var wn = cont.querySelector(".wrap"); if(wn){ wn.scrollTop=st; wn.scrollLeft=sl; }
}

function renderGrid(){
  var fr=filteredRows();
  var mode=els["f-group"].value, topicF=els["f-topic"].value, showAll=els["f-all"].checked, anon=els["f-anon"].checked;
  var learners=distinct(fr.map(function(r){return r.learnerKey;})).sort();
  var cells=buildCells(fr);
  var attemptedIds=distinct(fr.map(function(r){return r.item_id;}));
  var items;
  if(showAll){ items=CAT.map(function(it){return itemFor(it.id);}); attemptedIds.forEach(function(id){ if(!catById[id]) items.push(itemFor(id)); }); }
  else { items=attemptedIds.map(itemFor); }
  if(topicF) items=items.filter(function(it){return it.topic===topicF;});

  els["status"].textContent=statusLine(projectLabel()+" · "+learners.length+" learners · "+items.length+" questions · "+fr.length+" attempts · "+state.sourceLabel);
  if(!learners.length || !items.length){ els["grid"].innerHTML='<tr><td class="empty">'+esc(emptyWhy(fr))+'</td></tr>'; return; }

  // group
  var groups={}, order=[];
  items.forEach(function(it){ var g=groupKeyOf(it,mode); if(!groups[g]){groups[g]=[];order.push(g);} groups[g].push(it); });
  order=sortGroupKeys(order,mode);

  function cellOf(L,id){ return cells[L+"||"+id]; }
  function qAcc(id){return buildSummary(learners.map(function(L){var c=cellOf(L,id);return c&&c.latest;}).filter(Boolean));}
  function lAcc(L,ids){return buildSummary(ids.map(function(id){var c=cellOf(L,id);return c&&c.latest;}).filter(Boolean));}

  var allIds=items.map(function(it){return it.id;});
  var lstats={}; learners.forEach(function(L){ lstats[L]=lAcc(L,allIds); });
  var maxLAtt=Math.max(1, ...learners.map(function(L){return lstats[L].att;}));
  var overallAtt=0,overallCor=0,overallScored=0; learners.forEach(function(L){ overallAtt+=lstats[L].att; overallCor+=lstats[L].cor; overallScored+=lstats[L].scored; });
  var overallPct=overallScored?Math.round(100*overallCor/overallScored):null;
  var maxOverall=learners.length*items.length;

  var h="<thead>";
  // names row
  h+='<tr class="names"><th class="corner">Question</th>';
  learners.forEach(function(L){ h+='<th class="learner" title="'+esc(L)+'"><span class="vname">'+esc(learnerLabel(L,anon))+'</span></th>'; });
  h+='<th class="h-acc">Acc</th><th class="h-att">Att</th></tr>';
  // accuracy summary row
  h+='<tr class="sum-acc"><th class="s-lbl">Class accuracy</th>';
  learners.forEach(function(L){ var s=lstats[L]; h+='<td class="num" title="'+s.cor+'/'+s.scored+' scored; '+(s.att-s.scored)+' unscored" style="'+greenStyle(s.pct)+'">'+(s.scored?s.pct+"%":"–")+'</td>'; });
  h+='<td class="s-acc-col num" style="'+greenStyle(overallPct)+'">'+(overallScored?overallPct+"%":"–")+'</td><td class="s-att-col"></td></tr>';
  // attempted summary row
  h+='<tr class="sum-att"><th class="s-lbl">Distinct questions attempted</th>';
  learners.forEach(function(L){ var s=lstats[L]; h+='<td class="num" style="'+purpleStyle(s.att,maxLAtt)+'">'+s.att+'</td>'; });
  h+='<td class="s-acc-col"></td><td class="s-att-col num" style="'+purpleStyle(overallAtt,maxOverall)+'">'+overallAtt+'</td></tr>';
  h+="</thead><tbody>";

  order.forEach(function(g){
    var gid="g_"+g.replace(/[^a-z0-9]/gi,"_");
    var gIds=groups[g].map(function(it){return it.id;});
    var gAtt=0,gCor=0,gScored=0; learners.forEach(function(L){var gs=lAcc(L,gIds);gAtt+=gs.att;gCor+=gs.cor;gScored+=gs.scored;});
    var gPct=gScored?Math.round(100*gCor/gScored):null; var gMax=learners.length*gIds.length;
    h+='<tr class="group" data-grp="'+gid+'"><th class="g-lbl"><span class="chev">▾</span>'+esc(g)+' <span style="font-weight:400;color:#7a8aa0">('+groups[g].length+')</span></th>';
    learners.forEach(function(L){ var gs=lAcc(L,gIds); h+='<td class="num" style="'+(gs.scored?greenStyle(gs.pct):"")+'" title="'+esc(learnerLabel(L,anon)+" · "+g+": "+gs.cor+"/"+gs.scored+" scored; "+(gs.att-gs.scored)+" unscored")+'">'+(gs.scored?gs.pct+"%":gs.att?"–":"")+'</td>'; });
    h+='<td class="g-acc num" style="'+greenStyle(gPct)+'">'+(gScored?gPct+"%":"–")+'</td><td class="g-att num" style="'+purpleStyle(gAtt,gMax)+'">'+gAtt+'</td></tr>';
    groups[g].forEach(function(it){
      // Compact question column (Smith 2026-07-20): id + type visible, full
      // prompt on hover; click still opens the detail panel.
      h+='<tr class="qrow '+gid+'"><th class="qcell" data-item="'+esc(it.id)+'" title="'+esc((it.prompt||"(no prompt)")+(it.qtype?"\n["+it.qtype+"]":""))+'"><span class="qid">'+esc(it.id)+'</span><span class="qtag">'+esc(it.qtype||"")+(it.syllabus_tag?' · '+esc(it.syllabus_tag):'')+(mode==="syllabus"&&it.topic?' · '+esc(it.topic):'')+'</span></th>';
      learners.forEach(function(L){
        var c=cellOf(L,it.id);
        if(!c){ h+='<td class="cell none" data-item="'+esc(it.id)+'" data-learner="'+esc(L)+'"></td>'; return; }
        var category=statusClass(c.latest.status), cls="cell "+category; if(c.recovered)cls+=" recovered"; else if(c.slipped)cls+=" slipped";
        var t=learnerLabel(L,anon)+"  -  "+it.id+"\nlatest: "+(c.latest.status||"unscored")+(c.latest.picked_id?" (picked "+c.latest.picked_id+")":"")+"\n"+(c.latest.misconception_id?"misconception: "+(MISC[c.latest.misconception_id]?MISC[c.latest.misconception_id].label:c.latest.misconception_id)+"\n":"")+"attempts: "+c.count+(c.recovered?" (recovered)":"")+(c.slipped?" (slipped)":"");
        h+='<td class="'+cls+'" data-item="'+esc(it.id)+'" data-learner="'+esc(L)+'" title="'+esc(t)+'">'+(category==="unscored"?'—':'')+(c.count>1?'<span class="cnt">'+c.count+'</span>':'')+'</td>';
      });
      var qa=qAcc(it.id);
      h+='<td class="b-acc num" style="'+greenStyle(qa.pct)+'">'+(qa.scored?qa.pct+"%":"–")+'</td><td class="b-att num" style="'+purpleStyle(qa.att,learners.length)+'">'+qa.att+'</td></tr>';
    });
  });
  h+="</tbody>";
  els["grid"].innerHTML=h;
  applyCollapsed(els["grid"]);
}

function renderMisc(){
  var fr=filteredRows(); var anon=els["f-anon"].checked;
  var learners=distinct(fr.map(function(r){return r.learnerKey;})).sort();
  var data={};
  fr.forEach(function(r){
    // The distractor view only has negative evidence for a recorded option.
    // Unmarked feedback and unfamiliar outcomes are not successful avoidance.
    if(!isScoredStatus(r.status)||!r.picked_id) return;
    var slugs=itemMiscSlugs[r.item_id]; if(!slugs||!slugs.length) return;
    slugs.forEach(function(slug){
      var d=data[slug]||(data[slug]={type:(MISC[slug]&&MISC[slug].topic)||"(other)",label:(MISC[slug]&&MISC[slug].label)||slug,learners:{},reds:0,greens:0});
      var fell=r.misconception_id===slug;
      (d.learners[r.learnerKey]||(d.learners[r.learnerKey]=[])).push({fell:fell,ts:r.timestamp});
      if(fell)d.reds++; else d.greens++;
    });
  });
  var allSlugs=Object.keys(data);
  if(!learners.length||!allSlugs.length){ els["misc"].innerHTML='<p class="empty">No misconception-bearing questions attempted in this view.</p>'; return; }
  var oG=0,oR=0; allSlugs.forEach(function(s){ oG+=data[s].greens; oR+=data[s].reds; }); var oTot=oG+oR; var oPct=oTot?Math.round(100*oR/oTot):0;
  var groups={},order=[];
  allSlugs.forEach(function(s){ var t=data[s].type; if(!groups[t]){groups[t]=[];order.push(t);} groups[t].push(s); });
  order.sort();
  order.forEach(function(t){ groups[t].sort(function(a,b){ return data[b].reds-data[a].reds; }); });
  function marks(arr){ if(!arr||!arr.length) return ''; return arr.slice().sort(function(a,b){return a.ts<b.ts?-1:1;}).map(function(x){return x.fell?'<span class="cross">✗</span>':'<span class="tick">✓</span>';}).join(''); }
  var h='<div class="wrap"><table id="mgrid"><thead><tr class="names"><th class="corner">Misconception</th>';
  learners.forEach(function(L){ h+='<th class="learner" title="'+esc(L)+'"><span class="vname">'+esc(learnerLabel(L,anon))+'</span></th>'; });
  h+='<th class="mtot-h" style="'+redStyle(oPct)+'" title="fall rate: times the misconception was picked, out of times it was assessed">Totals<span class="sub">'+oPct+'% · ✗'+oR+'/'+oTot+'</span></th></tr></thead><tbody>';
  order.forEach(function(t){
    var gid="mg_"+t.replace(/[^a-z0-9]/gi,"_");
    var tg=0,tr2=0; groups[t].forEach(function(s){ tg+=data[s].greens; tr2+=data[s].reds; });
    h+='<tr class="group" data-grp="'+gid+'"><th class="g-lbl"><span class="chev">▾</span>'+esc(t)+' <span style="font-weight:400;color:#7a8aa0">('+groups[t].length+')</span></th>';
    learners.forEach(function(L){
      var g2=0,r2=0; groups[t].forEach(function(s){ (data[s].learners[L]||[]).forEach(function(x){ if(x.fell)r2++; else g2++; }); });
      h+='<td style="font-size:0.76em">'+((g2||r2)?('<span class="tick">'+g2+'</span>/<span class="cross">'+r2+'</span>'):'')+'</td>';
    });
    var tTot=tg+tr2; var tPct=tTot?Math.round(100*tr2/tTot):0; h+='<td class="mtot" style="'+redStyle(tPct)+'"><b>'+tPct+'%</b><span class="sub">✓'+tg+' ✗'+tr2+'</span></td></tr>';
    groups[t].forEach(function(s){
      var d=data[s];
      h+='<tr class="mrow '+gid+'"><th class="qcell" title="'+esc(s)+'"><span class="qprompt">'+esc(d.label)+'</span><span class="qtag">'+esc(s)+'</span></th>';
      learners.forEach(function(L){ h+='<td class="mcell" title="'+esc(L+" · "+d.label)+'">'+marks(d.learners[L])+'</td>'; });
      var dTot=d.greens+d.reds; var dPct=dTot?Math.round(100*d.reds/dTot):0; h+='<td class="mtot" style="'+redStyle(dPct)+'"><b>'+dPct+'%</b><span class="sub">✓'+d.greens+' ✗'+d.reds+'</span></td></tr>';
    });
  });
  h+='</tbody></table></div>';
  els["misc"].innerHTML=h;
  applyCollapsed(els["misc"]);
}

// ---- ticker (d012): who is making progress right now ----
// Learners as rows, time buckets as columns, newest on the LEFT. Metric
// switchable: questions answered (volume, purple) / answers correct (green) /
// % correct (green, 0-100). Buckets share one scale; the Total column is the
// same quantity over the whole span so it gets its OWN max on the same colour
// (sharing the bucket max would saturate it). No-activity cells carry the
// neutral untried grey, distinct from a genuine 0% (which shades white).
function renderTicker(){
  var fr=filteredRows(); var anon=els["f-anon"].checked;
  var sizeN=parseFloat(els["t-size"].value); if(!(sizeN>0)) sizeN=1;
  var unitMin=parseFloat(els["t-unit"].value)||1, ulbl=unitMin===10080?"w":unitMin===1440?"d":unitMin===60?"h":"m";
  var n=Math.max(1,Math.min(200,parseInt(els["t-count"].value,10)||10)), metric=els["t-metric"].value;
  var sizeMin=sizeN*unitMin, sizeMs=sizeMin*60000;
  var now=els["t-end"].value?new Date(els["t-end"].value).getTime():Date.now(); if(isNaN(now)) now=Date.now();
  var learners=distinct(fr.map(function(r){return r.learnerKey;})).sort();
  els["status"].textContent=statusLine(projectLabel()+" · "+learners.length+" learners · ticker "+sizeN+ulbl+" × "+n+" · "+state.sourceLabel);
  if(!learners.length){ els["ticker"].innerHTML='<tr><td class="empty">'+esc(emptyWhy(fr))+'</td></tr>'; return; }
  var cells={}; // learner -> [ {att,scored,cor} x n ]
  learners.forEach(function(L){ cells[L]=[]; for(var i=0;i<n;i++) cells[L].push({att:0,scored:0,cor:0}); });
  fr.forEach(function(r){
    var t=new Date(r.timestamp).getTime(); if(isNaN(t)) return;
    var i=Math.floor((now-t)/sizeMs); if(i<0||i>=n) return;
    if(!isAttemptRecord(r)) return; var c=cells[r.learnerKey][i]; c.att++; if(isScoredStatus(r.status)){c.scored++;if(r.status==="correct")c.cor++;}
  });
  function val(c){ if(!c.att) return null; return metric==="answered"?c.att:!c.scored?null:metric==="correct"?c.cor:Math.round(100*c.cor/c.scored); }
  var maxCell=1, totals={}, maxTot=1;
  learners.forEach(function(L){
    var ta=0,tc=0,ts=0;
    cells[L].forEach(function(c){ var v=val(c); if(v!=null&&metric!=="pct"&&v>maxCell)maxCell=v; ta+=c.att; tc+=c.cor;ts+=c.scored; });
    totals[L]={att:ta,cor:tc,scored:ts};
    var tv=val(totals[L]);
    if(tv!=null&&metric!=="pct"&&tv>maxTot)maxTot=tv;
  });
  function shade(v,max){ if(v==null) return "";
    if(metric==="pct") return greenStyle(v);
    if(metric==="correct") return greenStyle(100*v/max);
    return purpleStyle(v,max); }
  function bLabel(i){ return (i*sizeN)+"–"+((i+1)*sizeN)+ulbl; }
  var h='<thead><tr><th class="tname" style="z-index:6">Learner</th>';
  for(var i=0;i<n;i++) h+='<th title="'+esc(bLabel(i)+" ago")+'">'+esc(bLabel(i))+'</th>';
  h+='<th class="ttot" style="z-index:6">Total<span class="sub">'+esc(metric==="answered"?"answered":metric==="correct"?"correct":"% correct")+'</span></th></tr></thead><tbody>';
  learners.forEach(function(L){
    h+='<tr><th class="tname">'+esc(learnerLabel(L,anon))+'</th>';
    for(var i=0;i<n;i++){
      var c=cells[L][i], v=val(c);
      if(!c.att){ h+='<td class="tcell noact" title="'+esc(learnerLabel(L,anon)+" · "+bLabel(i)+": no activity")+'"></td>'; }
      else h+='<td class="tcell" style="'+shade(v,maxCell)+'" data-learner="'+esc(L)+'" data-b="'+i+'" title="'+esc(learnerLabel(L,anon)+" · "+bLabel(i)+" ago: "+c.cor+"/"+c.scored+" scored; "+(c.att-c.scored)+" unscored")+'">'+(v==null?'—':v+(metric==="pct"?"%":""))+'</td>';
    }
    var T=totals[L], tv=val(T);
    h+='<td class="ttot" style="'+(tv!=null?shade(tv,maxTot):"")+'" title="'+T.cor+'/'+T.scored+' scored; '+(T.att-T.scored)+' unscored">'+(tv!=null?tv+(metric==="pct"?"%":""):T.att?'—':"")+'</td></tr>';
  });
  h+="</tbody>";
  els["ticker"].innerHTML=h;
}
// Ticker drill-down: the actual questions behind a cell.
els["ticker"]=document.getElementById("ticker");
document.getElementById("ticker").addEventListener("click",function(e){
  var cell=e.target.closest("td.tcell"); if(!cell||cell.classList.contains("noact")) return;
  var L=cell.getAttribute("data-learner"), i=parseInt(cell.getAttribute("data-b"),10);
  var sizeMs=(parseFloat(els["t-size"].value)>0?parseFloat(els["t-size"].value):1)*(parseFloat(els["t-unit"].value)||1)*60000;
  var now=els["t-end"].value?new Date(els["t-end"].value).getTime():Date.now(); if(isNaN(now)) now=Date.now();
  var hi=now-i*sizeMs, lo=hi-sizeMs;
  var atts=filteredRows().filter(function(r){ if(r.learnerKey!==L||!isAttemptRecord(r)) return false;
    var t=new Date(r.timestamp).getTime(); return !isNaN(t)&&t>lo&&t<=hi; })
    .sort(function(a,b){return a.timestamp<b.timestamp?1:-1;});
  var d=els["detail"]; d.className="show";
  d.innerHTML='<button class="closer" onclick="document.getElementById(\'detail\').className=\'\'">close</button>'+
    '<h3>'+esc(learnerLabel(L,els["f-anon"].checked))+'</h3><p class="meta">'+atts.length+' attempt'+(atts.length===1?'':'s')+' in this bucket · newest first</p>'+
    '<ul class="opts">'+atts.map(function(a){
      var it=itemFor(a.item_id), cls=statusClass(a.status);
      return '<li class="'+cls+'" title="'+esc(it.prompt)+'"><button data-record="'+a._recordIndex+'">'+esc(a.item_ref||a.item_id)+'</button>'+(it.qtype?' <span class="slug">['+esc(it.qtype)+']</span>':'')+' <span class="slug">'+esc(a.status||"unscored")+(a.picked_id?' · picked '+esc(a.picked_id):'')+(a.misconception_id?' · '+esc(MISC[a.misconception_id]?MISC[a.misconception_id].label:a.misconception_id):'')+'</span></li>';
    }).join("")+'</ul>';
  d.scrollIntoView({behavior:"smooth",block:"nearest"});
});

// ---- detail panel (grid) ----
function showDetail(itemId,learnerKey){
  var it=itemFor(itemId); var d=els["detail"];
  var cell=learnerKey?buildCells(filteredRows().filter(function(r){return r.learnerKey===learnerKey;}))[learnerKey+"||"+itemId]:null;
  var picked=cell?cell.latest.picked_id:null;
  var opts=(it.distractors||[]).map(function(dz){ var cls=dz.status==="correct"?"correct":dz.status==="half"?"half":"wrong"; var pk=picked&&dz.id===picked;
    return '<li class="'+cls+(pk?" picked":"")+'"><strong>'+esc(dz.id)+')</strong> '+esc(dz.text||"")+(dz.status==="correct"?' <span class="slug">correct</span>':"")+(dz.misconception?' <span class="slug">'+esc(dz.misconception_label||dz.misconception)+'</span>':"")+(pk?' <span class="pickflag">picked</span>':"")+'</li>'; }).join("");
  var hist=""; if(cell){ hist='<div class="history"><strong>'+esc(learnerLabel(learnerKey,els["f-anon"].checked))+'</strong>: '+cell.attempts.map(function(a){var bg=a.status==="correct"?"#e6f4ea":a.status==="wrong"?"#fdecea":a.status==="half"?"#fff8e1":"#eee"; return '<button class="h" data-record="'+a._recordIndex+'" style="background:'+bg+'">'+esc(a.status||"unscored")+(a.picked_id?" ("+esc(a.picked_id)+")":"")+'</button>';}).join("")+(cell.recovered?" recovered":"")+(cell.slipped?" slipped":"")+'</div>'; }
  d.className="show";
  d.innerHTML='<button class="closer" onclick="document.getElementById(\'detail\').className=\'\'">close</button><h3>'+esc(it.id)+'</h3><p class="meta">'+esc(it.topic)+' · '+esc(it.level||"")+' · '+esc(it.qtype||"")+(it.syllabus_tag?' · '+esc(it.syllabus_tag):"")+'</p><div class="prompt">'+esc(it.prompt||"")+'</div><ul class="opts">'+opts+'</ul>'+hist;
  d.scrollIntoView({behavior:"smooth",block:"nearest"});
}

// Generic inspection, not a diagnostic model: unfamiliar feedback, descriptors
// and child records can be seen before a subject-specific view is commissioned.
function valueHTML(value){
  var parsed=value;
  if(typeof value==="string"){try{var p=JSON.parse(value);if(p&&typeof p==="object")parsed=p;}catch(e){}}
  if(parsed && typeof parsed==="object"){
    var label=Array.isArray(parsed)?parsed.length+" entries":Object.keys(parsed).length+" fields";
    return '<details><summary>'+esc(label)+'</summary><pre>'+esc(JSON.stringify(parsed,null,2))+'</pre></details>';
  }
  return value==null?'<span class="slug">not supplied</span>':esc(value);
}
function fieldsHTML(record){
  if(els["f-anon"].checked)return '<p class="meta">Recorded free text may contain names. Field details are hidden while Anonymise is on.</p>';
  return '<table class="record-fields"><tbody>'+Object.keys(record.fields).map(function(k){
    return '<tr><th scope="row">'+esc(k)+'</th><td>'+valueHTML(record.fields[k])+'</td></tr>';
  }).join('')+'</tbody></table>';
}
function relatedRecords(record){
  if(!record.attempt_id)return [];
  // Rows were authorized by the server. A child need not repeat its parent's
  // topic/time; the selected attempt is the detail scope. Never join conflicting
  // known learner/class identities even if a producer reused an attempt ID.
  return state.records.filter(function(r){return r!==record&&r.attempt_id===record.attempt_id&&
    (r.project||state.project)===(record.project||state.project)&&
    (!r.cohort||!record.cohort||r.cohort===record.cohort)&&
    (r.learnerKey==="(unknown)"||record.learnerKey==="(unknown)"||r.learnerKey===record.learnerKey);});
}
function showRecord(index){
  var r=state.records[index]; if(!r)return;
  var related=relatedRecords(r), d=els.detail;
  d.className="show";
  d.innerHTML='<button class="closer" onclick="document.getElementById(\'detail\').className=\'\'">close</button>'+
    '<h3>'+esc(learnerLabel(r.learnerKey,els["f-anon"].checked))+' · '+esc(r.row_type)+'</h3>'+
    '<p class="meta">'+esc(r.item_ref||"No item reference")+' · '+esc(r.timestamp)+'</p>'+fieldsHTML(r)+
    (related.length?'<h4>Linked records ('+related.length+')</h4><ul class="opts">'+related.map(function(child){return '<li><button data-record="'+child._recordIndex+'">'+esc(child.row_type)+' · '+esc(child.item_ref||child.status||child.timestamp||"record")+'</button></li>';}).join('')+'</ul>':'');
  d.scrollIntoView({behavior:"smooth",block:"nearest"});
}
function renderRecords(){
  var rows=filteredRecords(), kind=els["r-type"].value, anon=els["f-anon"].checked;
  if(kind)rows=rows.filter(function(r){return r.row_type===kind;});
  rows=rows.slice().sort(function(a,b){return a.timestamp<b.timestamp?1:a.timestamp>b.timestamp?-1:0;});
  els.status.textContent=statusLine(projectLabel()+" · "+rows.length+" records · "+state.sourceLabel);
  if(!rows.length){els.records.innerHTML='<tr><td class="empty">'+esc(state.phase!=="ready"?emptyWhy([]):"No records match the current filters.")+'</td></tr>';return;}
  els.records.innerHTML='<thead><tr><th>Time</th><th>Learner</th><th>Record type</th><th>Item / detail</th><th>Recorded outcome</th></tr></thead><tbody>'+rows.map(function(r){
    return '<tr><td>'+esc(r.timestamp)+'</td><td>'+esc(learnerLabel(r.learnerKey,anon))+'</td><td>'+esc(r.row_type)+'</td><td><button data-record="'+r._recordIndex+'">'+esc(r.item_ref||"Open record")+'</button></td><td>'+esc(r.status||"—")+'</td></tr>';
  }).join('')+'</tbody>';
}
function openRecordClick(e){var button=e.target.closest("[data-record]");if(button)showRecord(Number(button.getAttribute("data-record")));}
els.records.addEventListener("click",openRecordClick);
els.detail.addEventListener("click",openRecordClick);
els["r-type"].addEventListener("change",renderRecords);

// ---- events ----
els["grid"].addEventListener("click",function(e){
  var g=e.target.closest("tr.group");
  if(g){ var gid=g.getAttribute("data-grp"); var rows=els["grid"].querySelectorAll("tr."+gid); var ch=g.querySelector(".chev"); var hide=ch.textContent==="▾"; ch.textContent=hide?"▸":"▾"; rows.forEach(function(r){r.style.display=hide?"none":"";}); state.collapsed[gid]=hide; return; }
  var cell=e.target.closest("td.cell"); if(cell){ showDetail(cell.getAttribute("data-item"),cell.getAttribute("data-learner")); return; }
  var qc=e.target.closest("th.qcell"); if(qc&&qc.getAttribute("data-item")) showDetail(qc.getAttribute("data-item"),null);
});
els["misc"].addEventListener("click",function(e){
  var g=e.target.closest("tr.group"); if(!g) return; var gid=g.getAttribute("data-grp");
  var rows=els["misc"].querySelectorAll("tr."+gid); var ch=g.querySelector(".chev"); var hide=ch&&ch.textContent==="▾";
  if(ch) ch.textContent=hide?"▸":"▾"; rows.forEach(function(r){ r.style.display=hide?"none":""; }); state.collapsed[gid]=hide;
});
document.querySelectorAll(".tab").forEach(function(b){ b.addEventListener("click",function(){
  document.querySelectorAll(".tab").forEach(function(x){x.classList.remove("active");}); b.classList.add("active");
  state.tab=b.getAttribute("data-tab");
  ["grid","misc","ticker","records"].forEach(function(t){ document.getElementById("tab-"+t).hidden = state.tab!==t; });
  render();
}); });
["f-group","f-cohort","f-class","f-topic","f-learner","f-all","f-anon","f-time","f-since","t-size","t-unit","t-count","t-end","t-metric"].forEach(function(id){ els[id].addEventListener("input",function(){els.detail.className="";render();}); });
els["f-time"].addEventListener("change",function(){ document.getElementById("since-wrap").style.display = els["f-time"].value==="since"?"":"none"; });
var autoTimer=null;
els["f-auto"].addEventListener("change",function(){
  if(autoTimer){ clearInterval(autoTimer); autoTimer=null; }
  var sec=parseInt(els["f-auto"].value,10);
  if(sec>0) autoTimer=setInterval(function(){ doRefresh(); }, sec*1000);
});

function refreshFilters(){
  var cohorts=distinct(state.records.map(function(r){return r.cohort;}).filter(Boolean)).sort();
  var vc=els["f-cohort"].value; els["f-cohort"].innerHTML='<option value="">all</option>'+cohorts.map(function(c){return '<option>'+esc(c)+'</option>';}).join(""); els["f-cohort"].value=vc;
  var topics=distinct(CAT.map(function(i){return i.topic;}).concat(state.records.map(function(r){return r.topic;})).filter(Boolean)).sort();
  var vt=els["f-topic"].value; els["f-topic"].innerHTML='<option value="">all</option>'+topics.map(function(t){return '<option>'+esc(t)+'</option>';}).join(""); els["f-topic"].value=vt;
  var kinds=distinct(state.records.map(function(r){return r.row_type;})).sort(), kind=els["r-type"].value;
  els["r-type"].innerHTML='<option value="">all</option>'+kinds.map(function(k){return '<option>'+esc(k)+'</option>';}).join('');
  els["r-type"].value=kinds.indexOf(kind)!==-1?kind:"";
  // classes applicable to this project: applies_to blank or * or naming the
  // project id or the project's subject group (tt-6, d016)
  var subj=String((state.projectSubject||{})[state.project]||"").toLowerCase();
  var pidLower=String(state.project).toLowerCase();
  var applicable=(state.classes||[]).filter(function(c){
    // A class with no code cannot filter anything, and offering it as a blank
    // dropdown entry just hides a misconfigured classes tab (d021): the header
    // row must read class | applies_to | label.
    if(!txt(c["class"]).trim()) return false;
    var ap=txt(c.applies_to).trim();
    if(!ap||ap==="*") return true;
    var toks=ap.split(/[,;]+/).map(function(s){return s.trim().toLowerCase();});
    return toks.indexOf(pidLower)!==-1 || (subj && toks.indexOf(subj)!==-1);
  });
  var wrap=document.getElementById("class-wrap");
  if(applicable.length){
    wrap.style.display="";
    var vk=els["f-class"].value;
    els["f-class"].innerHTML='<option value="">all</option>'+applicable.map(function(c){
      var code=String(c["class"]||"").trim(); var lab=String(c.label||"").trim();
      return '<option value="'+esc(code)+'">'+esc(lab?code+" · "+lab:code)+'</option>';}).join("");
    els["f-class"].value=vk;
  } else { wrap.style.display="none"; els["f-class"].value=""; }
}

// ---- data sources ----
// state.raw holds raw row objects (from CSV, sample, or the workbook API);
// applyProject() derives state.rows for the selected project, so switching
// project re-slices already-loaded data without refetching.
function applyProject(){
  indexRoster();
  var pr=state.raw.map(normalise).filter(function(r){return r.project===""||r.project===state.project;});
  // anonymous_id -> display name, so un-named rows can borrow the pupil's name.
  state.anonName={}; pr.forEach(function(r){if(r.anon&&r.name)state.anonName[r.anon]=r.name;});
  state.records=pr.map(applyRoster);
  state.records.forEach(function(r,i){r._recordIndex=i;});
  state.rows=state.records.filter(function(r){return r.row_type==="attempt"&&r.status!=="session_start"&&r.item_id;});
  refreshFilters(); render();
}
function loadSample(){ state.raw=buildSample(); state.sourceLabel="sample"; markRefreshed(); safeApply(); }
function loadCSVText(t,label){ state.raw=parseCSV(t); state.sourceLabel=label||"CSV"; markRefreshed(); safeApply(); }
function markRefreshed(){ try{ document.getElementById("refreshed").textContent="refreshed "+new Date().toLocaleTimeString(); }catch(e){} }
// d021: applyProject runs inside a google.script.run success handler, so an
// exception in it was swallowed by the handler and left the last render on
// screen: the load looked merely empty. Every entry to it now goes through
// safeApply, which turns a throw into a stated failure.
function safeApply(){
  try{ state.phase="ready"; applyProject(); }
  catch(e){ state.phase="error"; state.problem=(e&&e.message)||String(e); try{ render(); }catch(e2){} }
}
function loadWorkbook(){
  state.phase="loading"; state.problem="";
  state.rows=[]; state.records=[]; els.detail.className=""; render(); // drop the previous project's data during the fetch
  google.script.run
    .withSuccessHandler(function(rows){
      state.raw=rows||[]; state.sourceLabel="workbook"; markRefreshed();
      // roster and classes are optional extras: fetch, then render either way
      google.script.run.withSuccessHandler(function(roster){
        state.roster=roster||[];
        google.script.run.withSuccessHandler(function(cls){ state.classes=cls||[]; safeApply(); })
          .withFailureHandler(function(){ state.classes=[]; safeApply(); }).tvGetClasses();
      }).withFailureHandler(function(){ state.roster=[]; state.classes=[]; safeApply(); }).tvGetRoster();
    })
    .withFailureHandler(function(e){ state.phase="error"; state.problem=(e&&e.message)||String(e); render(); })
    .tvGetRows(state.project, null, '*'); // retain producer record types; each view chooses its own input
}
function loadFromUrl(url){ if(!url){alert("Paste a published CSV URL first.");return;} els["status"].textContent="Loading..."; fetch(url).then(function(r){if(!r.ok)throw new Error("HTTP "+r.status);return r.text();}).then(function(t){loadCSVText(t,"published link");}).catch(function(err){els["status"].textContent="Could not load link: "+err.message+". (CORS? download the CSV and load the file.)";}); }
document.getElementById("btn-sample").addEventListener("click",loadSample);
document.getElementById("file").addEventListener("change",function(e){var f=e.target.files[0];if(!f)return;f.text().then(function(t){loadCSVText(t,"file: "+f.name);});});
document.getElementById("btn-url").addEventListener("click",function(){loadFromUrl(els["csvurl"].value.trim());});
function doRefresh(){
  if(APPS_SCRIPT_MODE||state.sourceLabel==="workbook"){ loadWorkbook(); return; }
  var url=els["csvurl"].value.trim()||PUBLISHED_CSV_URL; if(state.sourceLabel==="sample"||(!url&&!state.rows.length))loadSample(); else if(url)loadFromUrl(url); else render();}
document.getElementById("btn-refresh").addEventListener("click",doRefresh);

function buildSample(){
  var names=["Aisha Khan","Ben Carter","Chloe Davies","Diego Romero","Esi Mensah","Finn O'Brien","Grace Liu"];
  var pick=[]; var topics=distinct(CAT.map(function(i){return i.topic;}));
  topics.forEach(function(t){ CAT.filter(function(i){return i.topic===t;}).slice(0,3).forEach(function(i){pick.push(i);}); });
  var seed=7; function rnd(){seed=(seed*1103515245+12345)&0x7fffffff;return seed/0x7fffffff;}
  var rows=[],t0=Date.now()-36e5*40;
  names.forEach(function(nm,ni){ var anon="anon-"+(1000+ni);
    pick.forEach(function(it){ if(rnd()<0.22)return;
      var correctId=(it.correct_ids&&it.correct_ids[0])||(it.distractors[0]&&it.distractors[0].id)||"a";
      var wrongs=(it.distractors||[]).filter(function(d){return d.status!=="correct";});
      var attempts=1+(rnd()<0.3?1:0)+(rnd()<0.12?1:0); var gotIt=rnd()<(0.45+ni*0.04);
      for(var k=0;k<attempts;k++){ var last=k===attempts-1; var correct=last?gotIt:(rnd()<0.25); var status,picked,misc="";
        if(correct){status="correct";picked=correctId;} else { var w=wrongs.length?wrongs[Math.floor(rnd()*wrongs.length)]:null;
          if(w&&rnd()<0.85){status="wrong";picked=w.id;misc=w.misconception||"";} else {status="half";picked=(w?w.id:correctId);misc=(w?w.misconception:"")||"";} }
        rows.push({project:state.project,item_id:it.id,topic:it.topic,display_name:nm,anonymous_id:anon,cohort:ni<4?"12A":"12B",status:status,picked_id:picked,misconception_id:misc,timestamp:new Date(t0+rows.length*53000+k*9e5).toISOString(),extra_json:JSON.stringify({syllabus_tag:it.syllabus_tag||""})});
      }
    });
  });
  return rows;  // raw rows; applyProject() normalises and filters
}

// ---- boot ----
function buildProjectSwitcher(){
  els["f-project"].innerHTML=TV_PROJECTS.map(function(p){return '<option value="'+esc(p.id)+'">'+esc(p.label)+'</option>';}).join("");
  els["f-project"].value=state.project;
}
buildProjectSwitcher();
els["f-project"].addEventListener("change",function(){
  state.project=els["f-project"].value;
  loadCatalogue(state.project,function(){
    // d021: in Apps Script mode the workbook is the ONLY real source, so always
    // refetch on a switch. Keying off sourceLabel meant that after a failed load
    // (label still "none") a switch quietly re-sliced nothing instead of retrying.
    if(APPS_SCRIPT_MODE || state.sourceLabel==="workbook"){ loadWorkbook(); }
    else if(state.sourceLabel==="sample"){ loadSample(); }        // regenerate against this catalogue
    else { safeApply(); }                                         // re-slice loaded CSV
  });
});
document.getElementById("btn-refresh-top").addEventListener("click",doRefresh);
try{document.getElementById("build").textContent=(String(TV_BUILD).indexOf("__")===0?"dev":"build "+TV_BUILD);}catch(e){}
// In workbook mode the CSV plumbing row is redundant; reclaim the space.
if(APPS_SCRIPT_MODE){ document.getElementById("datasrc").style.display="none"; }
setCatalogue(state.project);
refreshFilters();
if(APPS_SCRIPT_MODE){
  // Discover the real project tabs plus their registry labels/subjects (tt-6),
  // populate the switcher, then boot the workbook. Any error falls back to the
  // built-in project list.
  google.script.run.withSuccessHandler(function(list){
    if(list && list.length){
      var active=list.filter(function(p){return p.active!==false;});
      if(!active.length) active=list;
      TV_PROJECTS=active.map(function(p){return { id:p.project, label:p.label||p.project, catalogueUrl:p.catalogue_url||"" };});
      state.projectSubject={}; list.forEach(function(p){ state.projectSubject[p.project]=p.subject||""; });
      if(!TV_PROJECTS.filter(function(p){return p.id===state.project;}).length){ state.project=TV_PROJECTS[0].id; }
      buildProjectSwitcher();
    }
    loadCatalogue(state.project, loadWorkbook);
  }).withFailureHandler(function(){ loadWorkbook(); }).tvListProjects();
}
else if(PUBLISHED_CSV_URL){ loadFromUrl(PUBLISHED_CSV_URL); }
else { loadSample(); }
</script>
</body>
</html>
